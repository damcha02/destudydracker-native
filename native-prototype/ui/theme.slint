export global Theme {
    out property <color> background: #171f2a;
    out property <color> surface: #1c2733;
    out property <color> card: #202c38;
    out property <color> card-raised: #24313f;
    out property <color> surface-inset: #19232e;
    out property <color> primary: #8fb4ff;
    out property <color> primary-hover: #adc8ff;
    out property <color> primary-pressed: #7097e3;
    out property <color> accent: #9dd6b0;
    out property <color> warning: #e6bd73;
    out property <color> text-primary: #f4f7fb;
    out property <color> text-secondary: #a6b4c3;
    out property <color> text-muted: #778695;
    out property <color> border: #3b4a5a;
    out property <color> border-strong: #53677d;
    out property <color> disabled: #4a5662;

    out property <length> radius-sm: 10px;
    out property <length> radius-md: 14px;
    out property <length> radius-lg: 22px;
    out property <length> radius-xl: 32px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> text-sm: 12px;
    out property <length> text-md: 15px;
    out property <length> text-lg: 20px;
    out property <length> text-xl: 28px;

    out property <duration> transition-fast: 120ms;
    out property <duration> transition-normal: 180ms;
}
