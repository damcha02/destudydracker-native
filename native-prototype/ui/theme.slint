export global Theme {
    out property <color> background: #0b1117;
    out property <color> surface: #101922;
    out property <color> card: #13202a;
    out property <color> card-raised: #172531;
    out property <color> primary: #77d0bf;
    out property <color> primary-hover: #8ee3d4;
    out property <color> primary-pressed: #4da797;
    out property <color> accent: #f4c95d;
    out property <color> text-primary: #f8fbf4;
    out property <color> text-secondary: #9db2bb;
    out property <color> border: #263947;
    out property <color> border-strong: #3d6070;
    out property <color> disabled: #41505a;

    out property <length> radius-sm: 10px;
    out property <length> radius-md: 16px;
    out property <length> radius-lg: 24px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> text-sm: 12px;
    out property <length> text-md: 15px;
    out property <length> text-lg: 20px;
    out property <length> text-xl: 28px;

    out property <duration> transition-fast: 120ms;
    out property <duration> transition-normal: 180ms;
}
