// Production "Field Notebook" style tokens (Stage 17). Every value is read off the running
// production app (`desktop/src/index.css` + `App.css`, `:root[data-app-style="field-notebook"]`,
// dark and light), not invented. Names follow production's CSS custom properties.
//
// Fonts: the packaged Tauri app's CSP (`font-src 'self' data:`, desktop/src-tauri/tauri.conf.json)
// blocks the Google-hosted Newsreader / Courier Prime / Hanken Grotesk faces named first in the
// CSS stacks, so the shipped app renders the *fallbacks*: Georgia (serif), Consolas (Chromium's
// default monospace on Windows) and Arial (Helvetica Neue -> Arial). Native uses those same system
// fonts; nothing is bundled.
export global FN {
    in-out property <bool> dark: true;

    out property <string> serif: "Georgia";
    out property <string> mono: "Consolas";
    out property <string> sans: "Arial";

    out property <color> desk: dark ? #191814 : #e6dfd1;
    out property <color> surface: dark ? #24221e : #fbf8f0;
    out property <color> surface-2: dark ? #2b2823 : #f4efe3;
    out property <color> surface-inset: dark ? #201e1a : #f6f1e5;
    out property <color> paper-1: dark ? #2b2823 : #f4efe3;
    out property <color> paper-2: dark ? #363126 : #e4dccb;
    out property <color> paper-3: dark ? #2e2a23 : #efe8da;
    out property <color> slip: dark ? #3a3020 : #f0e6c8;
    out property <color> ink: dark ? #eee6d6 : #23211d;
    out property <color> ink-2: dark ? #d7cdbb : #3d382f;
    out property <color> ink-3: dark ? #aaa08d : #6d6656;
    out property <color> ink-4: dark ? #817867 : #8b8474;
    out property <color> line: dark ? #58503f : #cec3ae;
    out property <color> line-soft: dark ? #3f392e : #ded5c3;
    out property <color> rule-dot: dark ? #584f3e : #d5cbb7;
    out property <color> stamp: dark ? #c47a4d : #9c5a34;
    out property <color> link: dark ? #8ea9c5 : #3c5f7a;
    out property <color> blue: dark ? #7187b4 : #4a5f86;
    out property <color> green: dark ? #73956a : #4f6b4a;
    out property <color> accent: dark ? #eee6d6 : #23211d;
    // `settings.accent` (production default #8fb4ff) overrides `--accent` inside the page shell, so
    // everything keyed on `var(--accent)` in the Dashboard body is this blue, not the palette ink.
    out property <color> user-accent: #8fb4ff;
    out property <color> accent-line: dark ? #eee6d652 : #23211d5c;
    out property <color> accent-soft: dark ? #eee6d614 : #23211d12;
    out property <color> danger-soft: #9c5a341f;
    out property <color> ring-track: dark ? #3d382f : #e6dfd1;

    // Course colours that production stores as CSS colours and sometimes omits.
    out property <color> general-layer: ink-4;
}
