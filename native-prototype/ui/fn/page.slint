import { FN } from "palette.slint";
import { FnDashboardData, FnFossilDay } from "types.slint";
import { MonoText, SerifText, SansText, HLine } from "parts.slint";
import { FnTopbar, FnTabRow } from "shell.slint";
import { QuietDashboard } from "quiet.slint";
import { FullDashboard } from "full.slint";

// The production Dashboard page (Field Notebook style): topbar, sticky tab row, and the paper
// "desk" with either the Quiet or the Full layout. Only draws what Rust prepared
// (`src/dashboard_view.rs`); every number on it comes from `study_tracker_core::dashboard`.
export component FnDashboardPage inherits Rectangle {
    in property <FnDashboardData> d;
    in property <bool> dark: true;
    callback select-entry(string);
    callback toggle-entry(string);
    callback focus-task(string);
    callback set-full(bool);
    callback set-range(int);
    callback toggle-theme();
    callback open-menu();
    callback open-timer();
    callback open-break();
    callback open-social();
    in property <bool> social-unread;
    callback start-focus();

    // Transient, purely visual state (hover tooltip / milestone popover) stays in Slint.
    private property <int> hovered-day: -1;
    private property <length> hover-x: 0px;
    private property <length> hover-y: 0px;
    private property <int> popover-day: -1;
    private property <length> popover-x: 0px;
    private property <length> popover-y: 0px;

    private property <bool> narrow: root.width <= 780px;
    private property <length> shell-w: min(1720px, root.width - 32px);
    private property <length> shell-x: (root.width - root.shell-w) / 2;
    private property <length> tab-pad: max(28px, root.width / 2 - 860px);
    private property <length> desk-y: 82px + 37px + 12px;
    private property <length> pad-l: root.narrow ? 16px : 34px;
    private property <length> pad-t: root.narrow ? 18px : 26px;
    private property <length> pad-b: root.narrow ? 24px : 30px;
    private property <length> inner-w: root.shell-w - 2px - 2 * root.pad-l;
    private property <length> body-h: root.d.full ? full.content-height : quiet.content-height;
    private property <length> desk-h: max(root.height - 132px, 2px + root.pad-t + root.body-h + root.pad-b);
    private property <length> page-h: root.desk-y - 13px + root.desk-h + 68px + 13px;

    background: FN.desk;
    clip: true;

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        viewport-height: root.page-h;

        FnTopbar {
            x: root.shell-x;
            y: 0px;
            width: root.shell-w;
            pill-tone: root.d.pill-tone;
            pill-label: root.d.pill-label;
            pill-score: root.d.pill-score;
            toggle-theme => { root.toggle-theme(); }
            open-menu => { root.open-menu(); }
        }

        // The desk: a bordered paper sheet.
        Rectangle {
            x: root.shell-x;
            y: root.desk-y;
            width: root.shell-w;
            height: root.desk-h;
            background: FN.surface;
            border-width: 1px;
            border-color: FN.line;

            quiet := QuietDashboard {
                visible: !root.d.full;
                x: 1px + root.pad-l;
                y: 1px + root.pad-t;
                width: root.inner-w;
                height: self.content-height;
                d: root.d;
                inner-width: root.inner-w;
                window-width: root.width;
                select-entry(id) => { root.select-entry(id); }
                toggle-entry(id) => { root.toggle-entry(id); }
                set-full(f) => { root.set-full(f); }
                start-focus => { root.start-focus(); }
                open-full => { root.set-full(true); }
            }
            full := FullDashboard {
                visible: root.d.full;
                x: 1px + root.pad-l;
                y: 1px + root.pad-t;
                width: root.inner-w;
                height: self.content-height;
                d: root.d;
                inner-width: root.inner-w;
                window-width: root.width;
                hovered-day: root.hovered-day;
                select-entry(id) => { root.select-entry(id); }
                toggle-entry(id) => { root.toggle-entry(id); }
                focus-task(id) => { root.focus-task(id); }
                set-full(f) => { root.set-full(f); }
                start-focus => { root.start-focus(); }
                set-range(i) => { root.popover-day = -1; root.hovered-day = -1; root.set-range(i); }
                hover-day(i, x, y) => { root.hovered-day = i; root.hover-x = x; root.hover-y = y; }
                leave-day => { root.hovered-day = -1; }
                toggle-milestone(i, x, y) => {
                    if root.popover-day == i { root.popover-day = -1; } else { root.popover-day = i; root.popover-x = x; root.popover-y = y; }
                }
            }
        }
    }

    // Sticky tab row: rides with the page until it reaches the top, then stays.
    FnTabRow {
        x: 0px;
        y: max(0px, 82px + flick.viewport-y);
        width: parent.width;
        content-x: root.tab-pad;
        active-tab: 0;
        social-unread: root.social-unread;
        picked(i) => { if i == 2 { root.open-timer(); } else if i == 4 { root.open-break(); } else if i == 5 { root.open-social(); } }
    }

    // --- hover tooltip over the weekly chart (`.fossil-tooltip`) ----------------------------------
    if root.hovered-day >= 0 && root.d.full: Rectangle {
        private property <FnFossilDay> day: root.d.days[root.hovered-day];
        x: clamp(root.hover-x - self.width / 2, 4px, root.width - self.width - 4px);
        y: root.hover-y - 8px - self.height;
        width: max(160px, tip.preferred-width);
        height: tip.preferred-height;
        background: @linear-gradient(180deg, FN.surface-2, FN.surface);
        border-width: 1px;
        border-color: FN.ink;
        border-radius: 10px;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 0px;
        drop-shadow-color: #00000038;
        tip := VerticalLayout {
            padding: 10px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                SansText { text: day.tip-title; font-size: 11.52px; font-weight: 700; color: FN.ink; }
                if day.is-today: MonoText { text: "TODAY"; font-size: 8.96px; font-weight: 800; letter-spacing: 0.45px; color: FN.user-accent; y: 2px; }
            }
            if day.empty: SansText { text: "No study - rest day"; font-size: 10.72px; color: FN.ink-4; }
            for layer in day.tip-layers: HorizontalLayout {
                spacing: 7px;
                Rectangle { width: 7px; height: 7px; y: 4px; border-radius: 2px; background: layer.color; }
                SansText { text: layer.name; font-size: 11.04px; color: FN.ink-3; horizontal-stretch: 1; }
                MonoText { text: layer.minutes; font-size: 10.56px; color: FN.ink; }
            }
            if !day.empty: Rectangle {
                height: 21px;
                HLine { y: 0px; tone: FN.line-soft; }
                SansText { x: 0px; y: 7px; text: "Total"; font-size: 10.72px; color: FN.ink-4; }
                MonoText { x: parent.width - self.preferred-width; y: 7px; text: day.tip-total; font-size: 10.56px; color: FN.ink; }
            }
        }
    }

    // --- milestone popover -------------------------------------------------------------------------
    if root.popover-day >= 0 && root.d.full: Rectangle {
        private property <FnFossilDay> day: root.d.days[root.popover-day];
        x: clamp(root.popover-x - self.width / 2, 4px, root.width - self.width - 4px);
        y: root.popover-y - 6px - self.height;
        width: max(title.preferred-width, desc.preferred-width) + 28px;
        height: 18px + 14px + 3px + 13px;
        background: FN.surface;
        border-width: 1px;
        border-color: FN.accent-line;
        border-radius: 9px;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 0px;
        drop-shadow-color: #00000038;
        title := SansText { y: 9px; width: parent.width; horizontal-alignment: center; text: day.milestone-title; font-size: 12px; font-weight: 700; color: FN.user-accent; }
        desc := SansText { y: 9px + 14px + 3px; width: parent.width; horizontal-alignment: center; text: day.milestone-desc; font-size: 10.56px; color: FN.ink-4; }
    }

    // --- thin page scrollbar -----------------------------------------------------------------------
    if root.page-h > root.height: Rectangle {
        x: parent.width - 10px;
        y: 0px;
        width: 10px;
        height: parent.height;
        Rectangle {
            x: 2px;
            width: 6px;
            border-radius: 3px;
            background: FN.ink-4;
            opacity: 0.45;
            height: max(32px, parent.height * root.height / root.page-h);
            y: (parent.height - self.height) * (-flick.viewport-y) / max(1px, root.page-h - root.height);
        }
    }
}
