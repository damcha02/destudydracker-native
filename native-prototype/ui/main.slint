import { LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DemoButton, ButtonVariant } from "components/button.slint";
import { DemoCard } from "components/card.slint";
import { LinearProgress } from "components/progress.slint";
import { AppSidebar } from "components/sidebar.slint";
import { PresetCard } from "components/preset-card.slint";
import { SessionRow } from "components/session-row.slint";
import { TimerDisplay } from "components/timer-display.slint";

export struct TimerModeData {
    label: string,
    detail: string,
    selected: bool,
    enabled: bool,
    tone: int,
    index: int,
}

export struct SessionNoteData {
    title: string,
    detail: string,
    minutes: int,
    confidence: int,
}

component MetricPill inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 72px;
    border-radius: Theme.radius-lg;
    background: Theme.surface-inset;
    border-width: 1px;
    border-color: Theme.border;

    Text { x: 16px; y: 13px; text: root.label; font-size: 11px; letter-spacing: 1.5px; color: Theme.text-muted; }
    Text { x: 16px; y: 36px; text: root.value; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
}

component TimerModeTile inherits Rectangle {
    in property <TimerModeData> entry;
    callback selected(int);

    height: 64px;

    PresetCard {
        width: 100%;
        height: 100%;
        label: root.entry.label;
        detail: root.entry.detail;
        selected: root.entry.selected;
        enabled: root.entry.enabled;
        clicked => { root.selected(root.entry.index); }
    }
}

export component MainWindow inherits Window {
    in property <string> app-title;
    in property <string> status-text;
    in property <string> timer-text;
    in property <string> status-label;
    in property <string> context-title;
    in property <string> context-detail;
    in property <string> mode-label;
    in property <string> mode-detail;
    in property <int> selected-mode;
    in property <int> phase-tone;
    in property <bool> running;
    in property <bool> completed;
    in property <float> timer-progress;
    in property <string> remaining-label;
    in property <string> elapsed-label;
    in property <string> total-label;
    in property <[TimerModeData]> modes;
    in property <[SessionNoteData]> session-notes;

    callback toggle-timer();
    callback reset-timer();
    callback select-mode(int);

    private property <bool> show-text-spike: true;
    private property <bool> text-input-focused: false;
    private property <string> single-line-sample: "Study Tracker - 日本語 note - cafe - sigma σ²";
    private property <string> mixed-line-sample: "Quantum Mechanics — 第4章 — σ² = 2.35 × 10⁻⁴";
    private property <string> multiline-sample: "Focus notes:\n日本語の勉強を始めましょう\nGröße, Prüfung, Zürich, naïve, café\nEmoji check: 📚 ✅ 🧪 🚀 ⏱️ ❤️ 👍 👨‍💻";
    private property <color> timer-accent: root.phase-tone == 2 ? Theme.warning : root.phase-tone == 3 ? Theme.accent : Theme.primary;
    private property <length> shell-padding: root.width < 980px ? 18px : 28px;
    private property <length> sidebar-width: root.width < 980px ? 0px : 220px;
    private property <length> content-x: root.shell-padding + root.sidebar-width + (root.sidebar-width > 0px ? 22px : 0px);
    private property <length> rail-width: root.width < 1040px ? 0px : 318px;
    private property <length> main-width: root.width - root.content-x - root.shell-padding - root.rail-width - (root.rail-width > 0px ? 22px : 0px);
    private property <length> timer-size: min(300px, max(236px, root.main-width - 120px));

    title: root.app-title;
    width: 1220px;
    height: 820px;
    background: Theme.background;

    forward-focus: shortcut-scope;

    shortcut-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: true;

        key-pressed(event) => {
            if !root.text-input-focused && event.text == Key.Space {
                root.toggle-timer();
                accept
            } else if !root.text-input-focused && (event.text == "r" || event.text == "R") {
                root.reset-timer();
                accept
            } else { reject }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.background;

        Rectangle { x: parent.width - 420px; y: -170px; width: 560px; height: 420px; border-radius: 260px; background: #263f67; opacity: 0.32; }
        Rectangle { x: 180px; y: parent.height - 170px; width: 360px; height: 260px; border-radius: 180px; background: #23452f; opacity: 0.18; }

        if root.sidebar-width > 0px: AppSidebar {
            x: root.shell-padding;
            y: root.shell-padding;
            width: root.sidebar-width;
            height: parent.height - 2 * root.shell-padding;
        }

        ScrollView {
            x: root.content-x;
            y: root.shell-padding;
            width: root.main-width;
            height: parent.height - 2 * root.shell-padding;
            viewport-width: self.width;
            viewport-height: root.show-text-spike ? 1050px : 704px;
            vertical-scrollbar-policy: root.height < 760px ? always-on : as-needed;
            horizontal-scrollbar-policy: always-off;

            Rectangle {
                width: parent.viewport-width;
                height: root.show-text-spike ? 1050px : 704px;
                background: transparent;

                Text { x: 0px; y: 4px; text: root.show-text-spike ? "Text, IME, emoji, accessibility" : "Focus timer"; font-size: 30px; font-weight: 700; color: Theme.text-primary; }
                Text { x: 1px; y: 44px; width: parent.width - 2px; text: root.show-text-spike ? "Stage 9 inspection surface for production-quality text and input risks." : "Pick a rhythm, press start, and let the rest fade away."; font-size: Theme.text-md; color: Theme.text-secondary; }

                HorizontalLayout {
                    x: 0px;
                    y: 82px;
                    width: min(430px, parent.width);
                    height: 42px;
                    spacing: 10px;

                    DemoButton {
                        width: 120px;
                        height: 42px;
                        text: "Timer";
                        helper-text: "";
                        variant: root.show-text-spike ? ButtonVariant.secondary : ButtonVariant.primary;
                        clicked => { root.show-text-spike = false; }
                    }
                    DemoButton {
                        width: 170px;
                        height: 42px;
                        text: "Text spike";
                        helper-text: "";
                        variant: root.show-text-spike ? ButtonVariant.primary : ButtonVariant.secondary;
                        clicked => { root.show-text-spike = true; }
                    }
                }

                if !root.show-text-spike: DemoCard {
                    x: 0px;
                    y: 142px;
                    width: parent.width;
                    height: 562px;
                    title: "Start a focus block";
                    subtitle: "Keep the default view simple. Link course and reflection only when you need it.";
                    emphasized: true;

                    Rectangle { x: 0px; y: 74px; width: parent.width; height: 1px; background: Theme.border; }

                    HorizontalLayout {
                        x: Theme.spacing-md;
                        y: 94px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 64px;
                        spacing: 10px;

                        for entry in root.modes: TimerModeTile {
                            entry: entry;
                            selected(index) => {
                                root.select-mode(index);
                                start-button.focus();
                            }
                        }
                    }

                    Rectangle {
                        x: Theme.spacing-md;
                        y: 178px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 70px;
                        border-radius: Theme.radius-lg;
                        background: Theme.surface-inset;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text { x: 18px; y: 12px; text: root.context-title; font-size: Theme.text-md; font-weight: 800; color: Theme.text-primary; }
                        Text { x: 18px; y: 38px; width: parent.width - 36px; text: root.context-detail; font-size: Theme.text-sm; color: Theme.text-secondary; overflow: elide; }
                    }

                    Rectangle {
                        x: 0px;
                        y: 248px;
                        width: parent.width;
                        height: 300px;
                        background: transparent;

                        TimerDisplay {
                            x: (parent.width - root.timer-size) / 2;
                            y: 0px;
                            width: root.timer-size;
                            height: root.timer-size;
                            timer-text: root.timer-text;
                            status-label: root.status-label;
                            mode-label: root.mode-label;
                            context-title: root.completed ? "Session complete" : root.context-title;
                            progress: root.timer-progress;
                            accent: root.timer-accent;
                        }
                    }

                    HorizontalLayout {
                        x: Theme.spacing-md;
                        y: 500px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 52px;
                        spacing: 12px;
                        alignment: center;

                        start-button := DemoButton {
                            width: 190px;
                            height: 52px;
                            text: root.running ? "Pause" : root.completed ? "Start again" : root.status-label == "Paused" ? "Resume" : "Start";
                            helper-text: "Space shortcut";
                            clicked => { root.toggle-timer(); }
                        }
                        DemoButton {
                            width: 110px;
                            height: 52px;
                            text: "Reset";
                            helper-text: "R shortcut";
                            variant: ButtonVariant.secondary;
                            clicked => { root.reset-timer(); }
                        }
                    }
                }

                if root.show-text-spike: DemoCard {
                    x: 0px;
                    y: 142px;
                    width: parent.width;
                    height: 908px;
                    title: "Stage 9 text inspection";
                    subtitle: "Use Tab/Shift+Tab through fields. Space/R timer shortcuts are suppressed while text fields are focused.";
                    emphasized: true;

                    Rectangle { x: 0px; y: 76px; width: parent.width; height: 1px; background: Theme.border; }

                    Text { x: Theme.spacing-md; y: 96px; text: "Static text and fallback"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 128px; width: parent.width - 2 * Theme.spacing-md; text: "Study Tracker — Focus Session"; font-size: Theme.text-md; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 154px; width: parent.width - 2 * Theme.spacing-md; text: "Größe · Prüfung · Zürich · naïve · café"; font-size: Theme.text-md; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 180px; width: parent.width - 2 * Theme.spacing-md; text: "日本語の勉強を始めましょう"; font-size: Theme.text-md; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 206px; width: parent.width - 2 * Theme.spacing-md; text: "Quantum Mechanics — 第4章 — σ² = 2.35 × 10⁻⁴"; font-size: Theme.text-md; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 232px; width: parent.width - 2 * Theme.spacing-md; text: "Combining marks: café, ä, ñ; symbols: ≤ ≥ ∑ ∫ →"; font-size: Theme.text-md; color: Theme.text-primary; }

                    Text { x: Theme.spacing-md; y: 276px; text: "Emoji and color-font fallback"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 310px; width: parent.width - 2 * Theme.spacing-md; text: "📚 ✅ 🧪 🚀 ⏱️ ❤️ 👍 👨‍💻"; font-size: 32px; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 356px; width: parent.width - 2 * Theme.spacing-md; text: "Check stopwatch ⏱️, variation selectors, and joined developer emoji for tofu or monochrome fallback."; font-size: Theme.text-sm; color: Theme.text-secondary; }

                    Text { x: Theme.spacing-md; y: 406px; text: "Single-line editing"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 438px; text: "Course/session title"; font-size: Theme.text-sm; color: Theme.text-secondary; }
                    single-line-field := LineEdit {
                        x: Theme.spacing-md;
                        y: 462px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 40px;
                        text <=> root.single-line-sample;
                        placeholder-text: "Type Latin, Japanese IME text, accents, and emoji";
                        accessible-label: "Stage 9 single-line mixed text field";
                        changed has-focus => { root.text-input-focused = self.has-focus; }
                    }

                    Text { x: Theme.spacing-md; y: 526px; text: "Mixed-language line"; font-size: Theme.text-sm; color: Theme.text-secondary; }
                    mixed-line-field := LineEdit {
                        x: Theme.spacing-md;
                        y: 550px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 40px;
                        text <=> root.mixed-line-sample;
                        placeholder-text: "Quantum Mechanics — 第4章 — σ² = 2.35 × 10⁻⁴";
                        accessible-label: "Stage 9 mixed language line edit";
                        changed has-focus => { root.text-input-focused = self.has-focus; }
                    }

                    Text { x: Theme.spacing-md; y: 614px; text: "Multiline editing"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    multiline-field := TextEdit {
                        x: Theme.spacing-md;
                        y: 650px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 150px;
                        text <=> root.multiline-sample;
                        accessible-label: "Stage 9 multiline study notes field";
                        changed has-focus => { root.text-input-focused = self.has-focus; }
                    }

                    Text { x: Theme.spacing-md; y: 826px; text: "Keyboard and accessibility controls"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    HorizontalLayout {
                        x: Theme.spacing-md;
                        y: 858px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 42px;
                        spacing: 10px;

                        DemoButton { width: 150px; height: 42px; text: "Focus target"; helper-text: "Enter/Space"; clicked => {} }
                        DemoButton { width: 160px; height: 42px; text: "Disabled action"; helper-text: "skipped"; enabled: false; variant: ButtonVariant.secondary; clicked => {} }
                    }
                }
            }
        }

        if root.rail-width > 0px && !root.show-text-spike: Rectangle {
            x: root.content-x + root.main-width + 22px;
            y: root.shell-padding;
            width: root.rail-width;
            height: parent.height - 2 * root.shell-padding;
            background: transparent;

            DemoCard {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 238px;
                title: "Session status";
                subtitle: root.status-text;

                VerticalLayout {
                    x: Theme.spacing-md;
                    y: 84px;
                    width: parent.width - 2 * Theme.spacing-md;
                    spacing: 10px;

                    MetricPill { label: "REMAINING"; value: root.remaining-label; }
                    MetricPill { label: "ELAPSED / TOTAL"; value: root.elapsed-label + " / " + root.total-label; }
                }
            }

            DemoCard {
                x: 0px;
                y: 260px;
                width: parent.width;
                height: parent.height - 260px;
                title: "Your focus log";
                subtitle: "Recent sessions shown as representative local data.";
                emphasized: true;

                VerticalLayout {
                    x: Theme.spacing-md;
                    y: 86px;
                    width: parent.width - 2 * Theme.spacing-md;
                    spacing: 10px;

                    for note in root.session-notes: SessionRow {
                        title: note.title;
                        detail: note.detail;
                        minutes: note.minutes;
                        confidence: note.confidence;
                    }
                }

                LinearProgress {
                    x: Theme.spacing-md;
                    y: parent.height - 42px;
                    width: parent.width - 2 * Theme.spacing-md;
                    progress: 0.68;
                }
                Text { x: Theme.spacing-md; y: parent.height - 24px; text: "Daily goal progress"; font-size: 11px; color: Theme.text-muted; }
            }
        }
    }
    }
}
