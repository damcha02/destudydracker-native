import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DemoButton, ButtonVariant } from "components/button.slint";
import { DemoCard } from "components/card.slint";
import { LinearProgress, RingProgress } from "components/progress.slint";

export struct ProgressExampleData {
    label: string,
    progress: float,
    percent: int,
}

export struct DemoRowData {
    title: string,
    detail: string,
    progress: float,
    percent: int,
}

component ProgressTile inherits Rectangle {
    in property <ProgressExampleData> entry;

    height: 58px;
    border-radius: Theme.radius-md;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;

    RingProgress {
        x: 12px;
        y: 6px;
        width: 46px;
        height: 46px;
        progress: root.entry.progress;
        label: root.entry.percent + "%";
    }

    Text {
        x: 72px;
        y: 9px;
        text: root.entry.label;
        font-size: Theme.text-md;
        font-weight: 700;
        color: Theme.text-primary;
    }

    LinearProgress {
        x: 72px;
        y: 34px;
        width: parent.width - 92px;
        progress: root.entry.progress;
    }
}

component ScrollRow inherits Rectangle {
    in property <DemoRowData> entry;

    height: 84px;
    border-radius: Theme.radius-md;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;

    Text {
        x: Theme.spacing-md;
        y: 12px;
        text: root.entry.title;
        font-size: Theme.text-md;
        font-weight: 800;
        color: Theme.text-primary;
    }

    Text {
        x: Theme.spacing-md;
        y: 34px;
        width: parent.width - 2 * Theme.spacing-md;
        text: root.entry.detail;
        font-size: Theme.text-sm;
        color: Theme.text-secondary;
        overflow: elide;
    }

    LinearProgress {
        x: Theme.spacing-md;
        y: 61px;
        width: parent.width - 84px;
        progress: root.entry.progress;
    }

    Text {
        x: parent.width - 58px;
        y: 57px;
        text: root.entry.percent + "%";
        font-size: Theme.text-sm;
        font-weight: 700;
        color: Theme.text-secondary;
    }
}

export component MainWindow inherits Window {
    in property <string> app-title;
    in property <string> status-text;
    in property <int> selected-mode;
    in property <string> selected-mode-label;
    in property <float> demo-progress;
    in property <string> demo-progress-label;
    in property <bool> controls-enabled;
    in property <int> activation-count;
    in property <[ProgressExampleData]> progress-examples;
    in property <[DemoRowData]> scroll-rows;

    callback activate-primary();
    callback toggle-enabled();
    callback select-mode(int);
    callback set-progress(int);
    callback increase-progress();

    title: root.app-title;
    width: 1180px;
    height: 780px;
    background: Theme.background;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.background;

        Rectangle {
            x: parent.width - 420px;
            y: -180px;
            width: 520px;
            height: 520px;
            border-radius: 260px;
            background: #173c43;
            opacity: 0.52;
        }

        Rectangle {
            x: Theme.spacing-lg;
            y: Theme.spacing-lg;
            width: parent.width - 2 * Theme.spacing-lg;
            height: parent.height - 2 * Theme.spacing-lg;
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                x: 30px;
                y: 24px;
                text: root.app-title;
                font-size: Theme.text-xl;
                font-weight: 800;
                color: Theme.text-primary;
            }

            Text {
                x: 32px;
                y: 64px;
                text: root.status-text;
                font-size: Theme.text-md;
                color: Theme.text-secondary;
            }

            DemoCard {
                x: 28px;
                y: 106px;
                width: 390px;
                height: 306px;
                title: "Custom buttons";
                subtitle: "DemoState controls are separate from the component-only disabled example.";
                emphasized: true;

                HorizontalLayout {
                    x: Theme.spacing-md;
                    y: 92px;
                    width: parent.width - 2 * Theme.spacing-md;
                    height: 42px;
                    spacing: Theme.spacing-sm;

                    DemoButton {
                        text: "Primary";
                        helper-text: "adds activation";
                        enabled: root.controls-enabled;
                        clicked => { root.activate-primary(); }
                    }

                    DemoButton {
                        text: "Subtle +10%";
                        helper-text: "updates progress";
                        variant: ButtonVariant.secondary;
                        enabled: root.controls-enabled;
                        clicked => { root.increase-progress(); }
                    }
                }

                HorizontalLayout {
                    x: Theme.spacing-md;
                    y: 148px;
                    width: parent.width - 2 * Theme.spacing-md;
                    height: 42px;
                    spacing: Theme.spacing-sm;

                    DemoButton {
                        text: root.controls-enabled ? "Disable demo" : "Enable demo";
                        helper-text: "toggle stays active";
                        variant: ButtonVariant.secondary;
                        clicked => { root.toggle-enabled(); }
                    }

                    DemoButton {
                        text: "Always disabled";
                        helper-text: "component example";
                        enabled: false;
                    }
                }

                Rectangle {
                    x: Theme.spacing-md;
                    y: 204px;
                    width: parent.width - 2 * Theme.spacing-md;
                    height: 24px;
                    border-radius: 12px;
                    background: root.controls-enabled ? #17342f : #34262a;
                    border-width: 1px;
                    border-color: root.controls-enabled ? Theme.primary : #d17a7a;

                    animate background, border-color { duration: Theme.transition-fast; easing: ease-out; }

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.controls-enabled ? "DemoState: enabled - governed controls are active" : "DemoState: disabled - governed controls are inactive";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: Theme.text-sm;
                        font-weight: 700;
                        color: root.controls-enabled ? Theme.primary-hover : #ffd0d0;
                    }
                }

                Text {
                    x: Theme.spacing-md;
                    y: 242px;
                    text: "Primary activations: " + root.activation-count;
                    font-size: Theme.text-md;
                    font-weight: 700;
                    color: Theme.text-primary;
                }

                Text {
                    x: Theme.spacing-md;
                    y: 270px;
                    text: "Current mode: " + root.selected-mode-label + " | Progress: " + root.demo-progress-label;
                    font-size: Theme.text-sm;
                    color: Theme.text-secondary;
                }
            }

            DemoCard {
                x: 440px;
                y: 106px;
                width: 342px;
                height: 306px;
                title: "Rust-owned state";
                subtitle: "UI events call Rust commands, then the adapter refreshes Slint properties.";

                RingProgress {
                    x: 28px;
                    y: 84px;
                    progress: root.demo-progress;
                    label: root.demo-progress-label;
                }

                LinearProgress {
                    x: 162px;
                    y: 118px;
                    width: 146px;
                    progress: root.demo-progress;
                }

                VerticalLayout {
                    x: 162px;
                    y: 152px;
                    width: 146px;
                    height: 112px;
                    spacing: 8px;

                    DemoButton { text: "25%"; height: 32px; variant: ButtonVariant.secondary; enabled: root.controls-enabled; clicked => { root.set-progress(25); } }
                    DemoButton { text: "65%"; height: 32px; variant: ButtonVariant.secondary; enabled: root.controls-enabled; clicked => { root.set-progress(65); } }
                    DemoButton { text: "90%"; height: 32px; variant: ButtonVariant.secondary; enabled: root.controls-enabled; clicked => { root.set-progress(90); } }
                }

                Text {
                    x: 28px;
                    y: 270px;
                    width: parent.width - 56px;
                    text: root.controls-enabled ? "Progress buttons are governed by DemoState." : "Progress buttons are disabled until DemoState is enabled.";
                    font-size: Theme.text-sm;
                    color: root.controls-enabled ? Theme.text-secondary : #ffd0d0;
                    horizontal-alignment: center;
                }
            }

            DemoCard {
                x: 804px;
                y: 106px;
                width: parent.width - 832px;
                height: 306px;
                title: "Image / icon path";
                subtitle: "Small local SVG asset rendered at multiple sizes. The second copy tests colorize tinting.";
                emphasized: true;

                Image {
                    x: 28px;
                    y: 96px;
                    width: 82px;
                    height: 82px;
                    source: @image-url("../assets/seedling.svg");
                    image-fit: contain;
                }

                Image {
                    x: 132px;
                    y: 104px;
                    width: 64px;
                    height: 64px;
                    source: @image-url("../assets/seedling.svg");
                    image-fit: contain;
                    colorize: Theme.accent;
                }

                Text {
                    x: 28px;
                    y: 204px;
                    width: parent.width - 56px;
                    text: "SVG stayed local to native-prototype. No icon framework added.";
                    wrap: word-wrap;
                    font-size: Theme.text-sm;
                    color: Theme.text-secondary;
                }
            }

            DemoCard {
                x: 28px;
                y: 422px;
                width: 512px;
                height: parent.height - 454px;
                title: "Progress indicators";
                subtitle: "Linear and ring components share a continuous progress API.";

                VerticalLayout {
                    x: Theme.spacing-md;
                    y: 82px;
                    width: parent.width - 2 * Theme.spacing-md;
                    spacing: Theme.spacing-sm;

                    for entry in root.progress-examples: ProgressTile {
                        entry: entry;
                    }
                }
            }

            DemoCard {
                x: 562px;
                y: 422px;
                width: parent.width - 590px;
                height: parent.height - 454px;
                title: "Scrollable cards";
                subtitle: "Bounded ScrollView with clipped repeated rows.";
                emphasized: true;

                ScrollView {
                    x: Theme.spacing-md;
                    y: 82px;
                    width: parent.width - 2 * Theme.spacing-md;
                    height: parent.height - 104px;
                    viewport-width: self.width - 12px;
                    viewport-height: 14 * 94px;
                    vertical-scrollbar-policy: always-on;
                    horizontal-scrollbar-policy: always-off;

                    VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: parent.viewport-width;
                        spacing: 10px;

                        for row in root.scroll-rows: ScrollRow {
                            entry: row;
                        }
                    }
                }
            }
        }
    }
}
