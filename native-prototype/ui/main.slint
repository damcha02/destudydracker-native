import { LineEdit, TextEdit } from "std-widgets.slint";

export struct TextSampleData {
    label: string,
    value: string,
    weight: int,
    size: length,
}

component SampleRow inherits Rectangle {
    in property <TextSampleData> sample;

    height: 64px;
    border-radius: 14px;
    background: #13202a;
    border-width: 1px;
    border-color: #263947;

    Text {
        x: 16px;
        y: 10px;
        text: root.sample.label;
        font-size: 12px;
        font-weight: 600;
        color: #8ea4b1;
    }

    Text {
        x: 16px;
        y: 27px;
        width: parent.width - 32px;
        height: 32px;
        text: root.sample.value;
        font-size: root.sample.size;
        font-weight: root.sample.weight;
        color: #f6fbf8;
        wrap: word-wrap;
    }
}

component SectionLabel inherits Text {
    in property <string> label;
    text: root.label;
    font-size: 13px;
    font-weight: 700;
    color: #77d0bf;
}

export component MainWindow inherits Window {
    in property <string> app-title;
    in property <string> status-text;
    in property <[TextSampleData]> text-samples;
    in property <[string]> notes;
    in property <string> wrapping-text;
    in-out property <string> single-line-text;
    in-out property <string> multiline-text;

    callback single-line-edited(string);
    callback multiline-edited(string);

    title: root.app-title;
    width: 1160px;
    height: 760px;
    background: #0b1117;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #0b1117;

        Rectangle {
            x: parent.width - 420px;
            y: -180px;
            width: 520px;
            height: 520px;
            border-radius: 260px;
            background: #173c43;
            opacity: 0.58;
        }

        Rectangle {
            x: 28px;
            y: 26px;
            width: parent.width - 56px;
            height: parent.height - 52px;
            border-radius: 24px;
            background: #101922;
            border-width: 1px;
            border-color: #223440;

            Text {
                x: 32px;
                y: 26px;
                text: root.app-title;
                font-size: 30px;
                font-weight: 800;
                color: #f8fbf4;
            }

            Text {
                x: 34px;
                y: 68px;
                text: root.status-text;
                font-size: 15px;
                color: #9db2bb;
            }

            Rectangle {
                x: 28px;
                y: 108px;
                width: max(520px, (parent.width - 84px) * 0.54);
                height: parent.height - 148px;
                border-radius: 18px;
                background: #0f1820;
                border-width: 1px;
                border-color: #263947;

                SectionLabel {
                    x: 18px;
                    y: 16px;
                    label: "Static text samples";
                }

                VerticalLayout {
                    x: 18px;
                    y: 42px;
                    width: parent.width - 36px;
                    spacing: 8px;

                    for sample in root.text-samples: SampleRow {
                        sample: sample;
                    }
                }

                SectionLabel {
                    x: 18px;
                    y: 392px;
                    label: "Wrapping region";
                }

                Rectangle {
                    x: 18px;
                    y: 420px;
                    width: parent.width - 36px;
                    height: parent.height - 446px;
                    border-radius: 14px;
                    background: #172531;
                    border-width: 1px;
                    border-color: #334957;

                    Text {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        height: parent.height - 28px;
                        text: root.wrapping-text;
                        wrap: word-wrap;
                        font-size: 14px;
                        font-weight: 400;
                        color: #dce9eb;
                    }
                }
            }

            Rectangle {
                x: max(596px, (parent.width - 84px) * 0.54 + 44px);
                y: 108px;
                width: parent.width - self.x - 28px;
                height: parent.height - 148px;
                border-radius: 18px;
                background: #0f1820;
                border-width: 1px;
                border-color: #263947;

                SectionLabel {
                    x: 18px;
                    y: 16px;
                    label: "Single-line editable input";
                }

                Rectangle {
                    x: 18px;
                    y: 42px;
                    width: parent.width - 36px;
                    height: 52px;
                    border-radius: 12px;
                    background: single.has-focus ? #223646 : #172531;
                    border-width: single.has-focus ? 2px : 1px;
                    border-color: single.has-focus ? #77d0bf : #334957;

                    single := LineEdit {
                        x: 12px;
                        y: 7px;
                        width: parent.width - 24px;
                        height: parent.height - 14px;
                        text <=> root.single-line-text;
                        font-size: 17px;
                        edited(text) => {
                            root.single-line-edited(text);
                        }
                    }
                }

                SectionLabel {
                    x: 18px;
                    y: 122px;
                    label: "Multiline editable input";
                }

                Rectangle {
                    x: 18px;
                    y: 148px;
                    width: parent.width - 36px;
                    height: max(230px, parent.height - 386px);
                    border-radius: 12px;
                    background: multi.has-focus ? #223646 : #172531;
                    border-width: multi.has-focus ? 2px : 1px;
                    border-color: multi.has-focus ? #77d0bf : #334957;

                    multi := TextEdit {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        text <=> root.multiline-text;
                        wrap: word-wrap;
                        font-size: 16px;
                        edited(text) => {
                            root.multiline-edited(text);
                        }
                    }
                }

                SectionLabel {
                    x: 18px;
                    y: parent.height - 206px;
                    label: "Focusable clipboard target";
                }

                Rectangle {
                    x: 18px;
                    y: parent.height - 180px;
                    width: parent.width - 36px;
                    height: 52px;
                    border-radius: 12px;
                    background: paste-target.has-focus ? #223646 : #172531;
                    border-width: paste-target.has-focus ? 2px : 1px;
                    border-color: paste-target.has-focus ? #f4c95d : #334957;

                    paste-target := LineEdit {
                        x: 12px;
                        y: 7px;
                        width: parent.width - 24px;
                        height: parent.height - 14px;
                        placeholder-text: "Paste here: clipboard / emoji / 日本語";
                        font-size: 16px;
                    }
                }

                VerticalLayout {
                    x: 20px;
                    y: parent.height - 106px;
                    width: parent.width - 40px;
                    spacing: 6px;

                    for note in root.notes: Text {
                        text: note;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: #8ea4b1;
                    }
                }
            }
        }
    }
}
