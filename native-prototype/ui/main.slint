import { LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DemoButton, ButtonVariant } from "components/button.slint";
import { DemoCard } from "components/card.slint";
import { LinearProgress } from "components/progress.slint";
import { AppSidebar } from "components/sidebar.slint";
import { PresetCard } from "components/preset-card.slint";
import { SessionRow } from "components/session-row.slint";
import { TimerDisplay } from "components/timer-display.slint";
import { FnDashboardPage } from "fn/page.slint";
import { FN } from "fn/palette.slint";
import { FnDashboardData, FnQueueRow, FnCourseRow, FnExamRow, FnAheadRow, FnFossilLayer, FnTooltipLayer, FnFossilDay, FnLegendItem, FnFossilStat, FnDiscovered } from "fn/types.slint";

export { FN } from "fn/palette.slint";
export { FnDashboardData, FnQueueRow, FnCourseRow, FnExamRow, FnAheadRow, FnFossilLayer, FnTooltipLayer, FnFossilDay, FnLegendItem, FnFossilStat, FnDiscovered } from "fn/types.slint";
import { MapLabView } from "map-lab.slint";
import { WS, WsTokens } from "wabi/palette.slint";
import { WabiPage } from "wabi/page.slint";
import { WabiSidebarData, WabiDashData, WabiTimerData, WabiQuietData, WabiCourseItem, WabiTaskItem, WabiDeadlineRow, WabiPlannedRow, WabiModeCard, WabiQuietOther } from "wabi/types.slint";
import { Chrome, ChromeTokens, MenuDropdown, AppearancePanel, ChoiceCard } from "chrome.slint";
import { SakuraPetals, SakuraTexture, PetalData, SakuraAssets } from "sakura.slint";
import { FnTokens } from "fn/palette.slint";
import { FnBreakPage } from "break/fn-break.slint";
import { BreakGames } from "break/games.slint";
import { GamesData } from "break/types.slint";
import { FnBreakData, BrCard, BrBadge, Emoji } from "break/types.slint";
export { FnBreakData, BrCard, BrBadge, Emoji, WabiRestData, Game, GameTokens, GamesData, WordleData, WTile, WKey, GeodleData, GeoRow, GeoClue, CountryOption, FlaggleData, FlagRow, DurakData, DCard, DCol, TravleData, TravleShape } from "break/types.slint";
import { WabiRestData } from "break/types.slint";
import { AlbumData, AlbumRow, AlbumPageData } from "wabi/album.slint";
export { AlbumData, AlbumRow, AlbumPageData } from "wabi/album.slint";

export { WS, WsTokens } from "wabi/palette.slint";
export { WabiSidebarData, WabiDashData, WabiTimerData, WabiQuietData, WabiCourseItem, WabiTaskItem, WabiDeadlineRow, WabiPlannedRow, WabiModeCard, WabiQuietOther } from "wabi/types.slint";
export { Chrome, ChromeTokens, ChoiceCard } from "chrome.slint";
export { PetalData, SakuraAssets } from "sakura.slint";
export { FnTokens } from "fn/palette.slint";
import { MapRegionData, MapLabelData, MapMarkerData } from "map-types.slint";

export { MapRegionData, MapLabelData, MapMarkerData } from "map-types.slint";

export struct TimerModeData {
    label: string,
    detail: string,
    selected: bool,
    enabled: bool,
    tone: int,
    index: int,
}

export struct SessionNoteData {
    title: string,
    detail: string,
    minutes: int,
    confidence: int,
}

component MetricPill inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 72px;
    border-radius: Theme.radius-lg;
    background: Theme.surface-inset;
    border-width: 1px;
    border-color: Theme.border;

    Text { x: 16px; y: 13px; text: root.label; font-size: 11px; letter-spacing: 1.5px; color: Theme.text-muted; }
    Text { x: 16px; y: 36px; text: root.value; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
}

component TimerModeTile inherits Rectangle {
    in property <TimerModeData> entry;
    callback selected(int);

    height: 64px;

    PresetCard {
        width: 100%;
        height: 100%;
        label: root.entry.label;
        detail: root.entry.detail;
        selected: root.entry.selected;
        enabled: root.entry.enabled;
        clicked => { root.selected(root.entry.index); }
    }
}

// Shared view switch (0 = timer, 1 = text spike, 2 = dashboard, 3 = map lab).
component ViewSwitcher inherits HorizontalLayout {
    in property <int> current;
    callback picked(int);

    spacing: 10px;

    DemoButton { width: 90px; height: 42px; text: "Timer"; helper-text: ""; variant: root.current == 0 ? ButtonVariant.primary : ButtonVariant.secondary; clicked => { root.picked(0); } }
    DemoButton { width: 118px; height: 42px; text: "Text spike"; helper-text: ""; variant: root.current == 1 ? ButtonVariant.primary : ButtonVariant.secondary; clicked => { root.picked(1); } }
    DemoButton { width: 118px; height: 42px; text: "Dashboard"; helper-text: ""; variant: root.current == 2 ? ButtonVariant.primary : ButtonVariant.secondary; clicked => { root.picked(2); } }
    DemoButton { width: 100px; height: 42px; text: "Map lab"; helper-text: ""; variant: root.current == 3 ? ButtonVariant.primary : ButtonVariant.secondary; clicked => { root.picked(3); } }
}

export component MainWindow inherits Window {
    in property <string> app-title;
    in property <string> status-text;
    in property <string> timer-text;
    in property <string> status-label;
    in property <string> context-title;
    in property <string> context-detail;
    in property <string> mode-label;
    in property <string> mode-detail;
    in property <int> selected-mode;
    in property <int> phase-tone;
    in property <bool> running;
    in property <bool> completed;
    in property <float> timer-progress;
    in property <string> remaining-label;
    in property <string> elapsed-label;
    in property <string> total-label;
    in property <[TimerModeData]> modes;
    in property <[SessionNoteData]> session-notes;
    // Stage 17: the production Dashboard's data (src/dashboard_view.rs) and the tiny bit of it the
    // sidebar of the not-yet-migrated Timer surface still shows.
    in property <FnDashboardData> fn-data;
    in property <string> sidebar-today-value;
    in property <string> sidebar-today-detail;
    in-out property <bool> fn-dark: true;

    in property <bool> update-notice-visible: false;
    in property <string> update-notice-title;
    in property <string> update-notice-body;
    in property <string> update-notice-action-label;
    callback update-notice-action();
    callback update-notice-dismiss();

    // Stage 19: appearance (style / palette / light-dark) and the Wabi-Sabi surfaces. Which style
    // is drawn, and every colour, is decided in Rust (`src/appearance_view.rs`).
    in property <bool> wabi: false;
    in property <bool> theme-locked: false;
    in property <bool> appearance-dark: true;
    in property <WabiSidebarData> wabi-sidebar;
    in property <WabiDashData> wabi-dash;
    in property <WabiTimerData> wabi-timer;
    in property <WabiQuietData> wabi-quiet-data;
    in property <bool> wabi-quiet: false;
    in property <bool> wabi-timer-menu-open: true;
    in property <bool> sakura: false;
    in property <[PetalData]> petals;
    in property <int> texture-frame;
    in-out property <bool> menu-open: false;
    in-out property <int> panel-view: -1;
    in property <[ChoiceCard]> palette-cards;
    in property <[ChoiceCard]> style-cards;
    callback appearance-pick-palette(int);
    callback appearance-pick-style(int);
    callback appearance-set-dark(bool);
    callback appearance-toggle-dark();
    callback wabi-open-dashboard();
    callback wabi-open-timer();
    callback wabi-toggle-quiet();
    callback wabi-toggle-semester();
    callback wabi-toggle-course(int);
    callback wabi-start-one();
    callback wabi-mark-one();
    callback wabi-deadline-mark(int);
    callback wabi-deadline-focus(int);
    callback wabi-deadline-select(int);
    callback wabi-planned-mark(int);
    callback wabi-planned-select(int);
    callback wabi-timer-log();
    callback wabi-quiet-pick(int);
    // which production surface is on screen changed (drives the Sakura clock's visibility rule)
    callback surface-changed();
    private property <bool> production-surface: !root.show-text-spike && !root.show-map;
    changed show-dashboard => { root.surface-changed(); }
    changed show-text-spike => { root.surface-changed(); }
    changed show-map => { root.surface-changed(); }

    callback toggle-timer();
    callback reset-timer();
    callback select-mode(int);
    in property <[MapRegionData]> map-regions;
    in property <string> map-hover-commands;
    in property <string> map-selected-commands;
    in property <[MapLabelData]> map-labels;
    in property <[MapMarkerData]> map-markers;
    in property <length> map-layer-x;
    in property <length> map-layer-y;
    in property <float> map-layer-scale: 1;
    in property <string> map-hover-text;
    in property <string> map-selected-text;
    in property <string> map-stats-text;
    in property <string> map-perf-text;
    in property <string> map-zoom-text;
    in property <int> map-level-index;
    in property <string> map-level-name;
    callback map-viewport-resized(float, float);
    callback map-press();
    callback map-drag(float, float);
    callback map-release(float, float);
    callback map-hover(float, float);
    callback map-leave();
    callback map-wheel(float, float, float);
    callback map-zoom-step(int);
    callback map-reset-view();
    callback map-step-selection(int);
    callback map-focus-selected();
    callback map-pan-key(float, float);
    callback map-set-level(int);
    callback map-cycle-level(int);

    callback fn-select-entry(string);
    callback fn-toggle-entry(string);
    callback fn-focus-task(string);
    callback fn-set-full(bool);
    callback fn-set-range(int);
    callback fn-toggle-theme();
    callback fn-start-focus();

    in-out property <bool> show-text-spike: false;
    in-out property <bool> show-dashboard: true;
    in-out property <bool> show-map: false;
    // Stage 20: the Break Room / Rest surface (takes precedence over Dashboard and Timer).
    in-out property <bool> show-break: false;
    in property <FnBreakData> fn-break;
    in property <bool> rock-bounce;
    in property <bool> rock-celebrate;
    callback break-opened();
    in property <GamesData> games: { open: -1 };
    callback game-close();
    callback wordle-key(string);
    callback wordle-hard();
    callback geodle-edited(string);
    callback geodle-toggle();
    callback geodle-pick(string);
    callback geodle-submit();
    callback flaggle-edited(string);
    callback flaggle-toggle();
    callback flaggle-pick(string);
    callback flaggle-submit();
    callback durak-card(int);
    callback durak-act(string);
    callback travle-edited(string);
    callback travle-toggle();
    callback travle-pick(string);
    callback travle-submit();
    callback travle-clear();
    callback travle-zoom(bool);
    in property <WabiRestData> wabi-rest;
    in property <int> rest-room;
    in property <float> breath-ring: 60;
    in property <int> album-cover-seq;
    in property <int> album-leaf-seq;
    in property <bool> album-slide-open;
    in property <AlbumData> album;
    in-out property <bool> rest-menu-open: false;
    callback rest-pick-room(int);
    callback rest-toggle();
    callback rest-reset();
    callback rest-edit(string);
    callback rest-tree();
    callback rest-breath();
    callback album-open();
    callback album-turn(int);
    callback album-close();
    callback break-play(int);
    callback break-unlock(int);
    callback break-water();
    callback break-stretch();
    callback break-pat();
    private property <bool> text-input-focused: false;
    private property <string> single-line-sample: "Study Tracker - 日本語 note - cafe - sigma σ²";
    private property <string> mixed-line-sample: "Quantum Mechanics — 第4章 — σ² = 2.35 × 10⁻⁴";
    private property <string> multiline-sample: "Focus notes:\n日本語の勉強を始めましょう\nGröße, Prüfung, Zürich, naïve, café\nEmoji check: 📚 ✅ 🧪 🚀 ⏱️ ❤️ 👍 👨‍💻";
    private property <string> accessibility-action-status: "Last activated: none";
    private property <color> timer-accent: root.phase-tone == 2 ? Theme.warning : root.phase-tone == 3 ? Theme.accent : Theme.primary;
    private property <length> shell-padding: root.width < 980px ? 18px : 28px;
    private property <length> sidebar-width: root.width < 980px ? 0px : 220px;
    private property <length> content-x: root.shell-padding + root.sidebar-width + (root.sidebar-width > 0px ? 22px : 0px);
    private property <length> rail-width: root.width < 1040px ? 0px : 318px;
    private property <length> main-width: root.width - root.content-x - root.shell-padding - root.rail-width - (root.rail-width > 0px ? 22px : 0px);
    private property <length> timer-size: min(300px, max(236px, root.main-width - 120px));

    title: root.app-title;
    // Window/taskbar icon (Stage 13). Byte-identical copy of production's own
    // desktop/src-tauri/icons/icon.png — provenance and hashes in
    // docs/stage13-production-shell.md. Fixes the Stage 12 finding that WM_GETICON returned
    // nothing (no window icon set).
    icon: @image-url("../assets/branding/icon.png");
    // Preferred (not fixed) size so the window is resizable; Stage 10 needs this for responsive checks.
    preferred-width: 1220px;
    preferred-height: 820px;
    min-width: 460px;
    min-height: 340px;
    background: Theme.background;

    forward-focus: shortcut-scope;

    shortcut-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: true;

        key-pressed(event) => {
            if root.show-dashboard || root.show-map || root.show-break { reject }
            else if !root.text-input-focused && event.text == Key.Space {
                root.toggle-timer();
                accept
            } else if !root.text-input-focused && (event.text == "r" || event.text == "R") {
                root.reset-timer();
                accept
            } else { reject }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.background;

        Rectangle { x: parent.width - 420px; y: -170px; width: 560px; height: 420px; border-radius: 260px; background: #263f67; opacity: 0.32; }
        Rectangle { x: 180px; y: parent.height - 170px; width: 360px; height: 260px; border-radius: 180px; background: #23452f; opacity: 0.18; }

        if root.sidebar-width > 0px: AppSidebar {
            today-value: root.sidebar-today-value;
            today-detail: root.sidebar-today-detail;
            x: root.shell-padding;
            y: root.shell-padding;
            width: root.sidebar-width;
            height: parent.height - 2 * root.shell-padding;
        }

        if !root.show-dashboard && !root.show-map && !root.show-break: ScrollView {
            x: root.content-x;
            y: root.shell-padding;
            width: root.main-width;
            height: parent.height - 2 * root.shell-padding;
            viewport-width: self.width;
            viewport-height: root.show-text-spike ? 1110px : 704px;
            vertical-scrollbar-policy: root.height < 760px ? always-on : as-needed;
            horizontal-scrollbar-policy: always-off;

            Rectangle {
                width: parent.viewport-width;
                height: root.show-text-spike ? 1110px : 704px;
                background: transparent;

                Text { x: 0px; y: 4px; text: root.show-text-spike ? "Text, IME, emoji, accessibility" : "Focus timer"; font-size: 30px; font-weight: 700; color: Theme.text-primary; }
                Text { x: 1px; y: 44px; width: parent.width - 2px; text: root.show-text-spike ? "Stage 9 inspection surface for production-quality text and input risks." : "Pick a rhythm, press start, and let the rest fade away."; font-size: Theme.text-md; color: Theme.text-secondary; }

                ViewSwitcher {
                    x: 0px;
                    y: 82px;
                    width: min(640px, parent.width);
                    height: 42px;
                    current: root.show-text-spike ? 1 : 0;
                    picked(view) => { root.show-text-spike = view == 1; root.show-dashboard = view == 2; root.show-map = view == 3; }
                }

                if !root.show-text-spike: DemoCard {
                    x: 0px;
                    y: 142px;
                    width: parent.width;
                    height: 562px;
                    title: "Start a focus block";
                    subtitle: "Keep the default view simple. Link course and reflection only when you need it.";
                    emphasized: true;

                    Rectangle { x: 0px; y: 74px; width: parent.width; height: 1px; background: Theme.border; }

                    HorizontalLayout {
                        x: Theme.spacing-md;
                        y: 94px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 64px;
                        spacing: 10px;

                        for entry in root.modes: TimerModeTile {
                            entry: entry;
                            selected(index) => {
                                root.select-mode(index);
                                start-button.focus();
                            }
                        }
                    }

                    Rectangle {
                        x: Theme.spacing-md;
                        y: 178px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 70px;
                        border-radius: Theme.radius-lg;
                        background: Theme.surface-inset;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text { x: 18px; y: 12px; text: root.context-title; font-size: Theme.text-md; font-weight: 800; color: Theme.text-primary; }
                        Text { x: 18px; y: 38px; width: parent.width - 36px; text: root.context-detail; font-size: Theme.text-sm; color: Theme.text-secondary; overflow: elide; }
                    }

                    Rectangle {
                        x: 0px;
                        y: 248px;
                        width: parent.width;
                        height: 300px;
                        background: transparent;

                        TimerDisplay {
                            x: (parent.width - root.timer-size) / 2;
                            y: 0px;
                            width: root.timer-size;
                            height: root.timer-size;
                            timer-text: root.timer-text;
                            status-label: root.status-label;
                            mode-label: root.mode-label;
                            context-title: root.completed ? "Session complete" : root.context-title;
                            progress: root.timer-progress;
                            accent: root.timer-accent;
                        }
                    }

                    HorizontalLayout {
                        x: Theme.spacing-md;
                        y: 500px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 52px;
                        spacing: 12px;
                        alignment: center;

                        start-button := DemoButton {
                            width: 190px;
                            height: 52px;
                            text: root.running ? "Pause" : root.completed ? "Start again" : root.status-label == "Paused" ? "Resume" : "Start";
                            helper-text: "Space shortcut";
                            clicked => { root.toggle-timer(); }
                        }
                        DemoButton {
                            width: 110px;
                            height: 52px;
                            text: "Reset";
                            helper-text: "R shortcut";
                            variant: ButtonVariant.secondary;
                            clicked => { root.reset-timer(); }
                        }
                    }
                }

                if root.show-text-spike: DemoCard {
                    x: 0px;
                    y: 142px;
                    width: parent.width;
                    height: 968px;
                    title: "Stage 9 text inspection";
                    subtitle: "Use Tab/Shift+Tab through fields. Space/R timer shortcuts are suppressed while text fields are focused.";
                    emphasized: true;

                    Rectangle { x: 0px; y: 76px; width: parent.width; height: 1px; background: Theme.border; }

                    Text { x: Theme.spacing-md; y: 96px; text: "Static text and fallback"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 128px; width: parent.width - 2 * Theme.spacing-md; text: "Study Tracker — Focus Session"; font-size: Theme.text-md; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 154px; width: parent.width - 2 * Theme.spacing-md; text: "Größe · Prüfung · Zürich · naïve · café"; font-size: Theme.text-md; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 180px; width: parent.width - 2 * Theme.spacing-md; text: "日本語の勉強を始めましょう"; font-size: Theme.text-md; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 206px; width: parent.width - 2 * Theme.spacing-md; text: "Quantum Mechanics — 第4章 — σ² = 2.35 × 10⁻⁴"; font-size: Theme.text-md; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 232px; width: parent.width - 2 * Theme.spacing-md; text: "Combining marks: café, ä, ñ; symbols: ≤ ≥ ∑ ∫ →"; font-size: Theme.text-md; color: Theme.text-primary; }

                    Text { x: Theme.spacing-md; y: 276px; text: "Emoji and color-font fallback"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 310px; width: parent.width - 2 * Theme.spacing-md; text: "📚 ✅ 🧪 🚀 ⏱️ ❤️ 👍 👨‍💻"; font-size: 32px; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 356px; width: parent.width - 2 * Theme.spacing-md; text: "Check stopwatch ⏱️, variation selectors, and joined developer emoji for tofu or monochrome fallback."; font-size: Theme.text-sm; color: Theme.text-secondary; }

                    Text { x: Theme.spacing-md; y: 406px; text: "Single-line editing"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 438px; text: "Course/session title"; font-size: Theme.text-sm; color: Theme.text-secondary; }
                    single-line-field := LineEdit {
                        x: Theme.spacing-md;
                        y: 462px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 40px;
                        text <=> root.single-line-sample;
                        placeholder-text: "Type Latin, Japanese IME text, accents, and emoji";
                        accessible-label: "Stage 9 single-line mixed text field";
                        changed has-focus => { root.text-input-focused = self.has-focus; }
                    }

                    Text { x: Theme.spacing-md; y: 526px; text: "Mixed-language line"; font-size: Theme.text-sm; color: Theme.text-secondary; }
                    mixed-line-field := LineEdit {
                        x: Theme.spacing-md;
                        y: 550px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 40px;
                        text <=> root.mixed-line-sample;
                        placeholder-text: "Quantum Mechanics — 第4章 — σ² = 2.35 × 10⁻⁴";
                        accessible-label: "Stage 9 mixed language line edit";
                        changed has-focus => { root.text-input-focused = self.has-focus; }
                    }

                    Text { x: Theme.spacing-md; y: 614px; text: "Multiline editing"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    multiline-field := TextEdit {
                        x: Theme.spacing-md;
                        y: 650px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 118px;
                        text <=> root.multiline-sample;
                        accessible-label: "Stage 9 multiline study notes field";
                        changed has-focus => { root.text-input-focused = self.has-focus; }
                    }

                    Text { x: Theme.spacing-md; y: 790px; text: "Keyboard and accessibility controls"; font-size: Theme.text-lg; font-weight: 800; color: Theme.text-primary; }
                    Text { x: Theme.spacing-md; y: 816px; width: parent.width - 2 * Theme.spacing-md; text: "Normal controls are enabled and activatable. The disabled example is intentionally skipped."; font-size: Theme.text-sm; color: Theme.text-secondary; }
                    Rectangle {
                        x: Theme.spacing-md;
                        y: 842px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 38px;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface-inset;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text { x: 14px; y: 9px; width: parent.width - 28px; text: root.accessibility-action-status; font-size: Theme.text-sm; color: Theme.accent; }
                    }
                    HorizontalLayout {
                        x: Theme.spacing-md;
                        y: 896px;
                        width: parent.width - 2 * Theme.spacing-md;
                        height: 42px;
                        spacing: 10px;

                        DemoButton {
                            width: 190px;
                            height: 42px;
                            text: "Test focus action";
                            helper-text: "Enter/Space";
                            clicked => { root.accessibility-action-status = "Last activated: Test focus action"; }
                        }
                        DemoButton {
                            width: 190px;
                            height: 42px;
                            text: "Test named action";
                            helper-text: "normal enabled";
                            variant: ButtonVariant.secondary;
                            clicked => { root.accessibility-action-status = "Last activated: Test named action"; }
                        }
                        DemoButton {
                            width: 230px;
                            height: 42px;
                            text: "Disabled example";
                            helper-text: "intentionally disabled";
                            enabled: false;
                            variant: ButtonVariant.secondary;
                            clicked => { root.accessibility-action-status = "Disabled example should not activate"; }
                        }
                    }
                }

            }
        }

        if root.show-map: Rectangle {
            x: root.content-x;
            y: root.shell-padding;
            width: root.width - root.content-x - root.shell-padding;
            height: parent.height - 2 * root.shell-padding;
            background: transparent;

            Text { x: 0px; y: 4px; text: "Map / rendering lab"; font-size: 30px; font-weight: 700; color: Theme.text-primary; }
            Text { x: 1px; y: 44px; width: parent.width - 2px; text: "Vector country geometry drawn natively: pan, zoom, hit-testing and stress data sets."; font-size: Theme.text-md; color: Theme.text-secondary; overflow: elide; }
            ViewSwitcher {
                x: 0px;
                y: 82px;
                width: min(640px, parent.width);
                height: 42px;
                current: 3;
                picked(view) => { root.show-text-spike = view == 1; root.show-dashboard = view == 2; root.show-map = view == 3; }
            }

            MapLabView {
                x: 0px;
                y: 142px;
                width: parent.width;
                height: parent.height - 142px;
                regions: root.map-regions;
                hover-commands: root.map-hover-commands;
                selected-commands: root.map-selected-commands;
                labels: root.map-labels;
                markers: root.map-markers;
                layer-x: root.map-layer-x;
                layer-y: root.map-layer-y;
                layer-scale: root.map-layer-scale;
                hover-text: root.map-hover-text;
                selected-text: root.map-selected-text;
                stats-text: root.map-stats-text;
                perf-text: root.map-perf-text;
                zoom-text: root.map-zoom-text;
                level-index: root.map-level-index;
                level-name: root.map-level-name;
                viewport-resized(w, h) => { root.map-viewport-resized(w, h); }
                press() => { root.map-press(); }
                drag(dx, dy) => { root.map-drag(dx, dy); }
                release(x, y) => { root.map-release(x, y); }
                hover(x, y) => { root.map-hover(x, y); }
                leave() => { root.map-leave(); }
                wheel(d, x, y) => { root.map-wheel(d, x, y); }
                zoom-step(d) => { root.map-zoom-step(d); }
                reset-view() => { root.map-reset-view(); }
                step-selection(d) => { root.map-step-selection(d); }
                focus-selected() => { root.map-focus-selected(); }
                pan-key(dx, dy) => { root.map-pan-key(dx, dy); }
                set-level(i) => { root.map-set-level(i); }
                cycle-level(d) => { root.map-cycle-level(d); }
            }
        }

        if root.rail-width > 0px && !root.show-text-spike && !root.show-dashboard && !root.show-map && !root.show-break: Rectangle {
            x: root.content-x + root.main-width + 22px;
            y: root.shell-padding;
            width: root.rail-width;
            height: parent.height - 2 * root.shell-padding;
            background: transparent;

            DemoCard {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 238px;
                title: "Session status";
                subtitle: root.status-text;

                VerticalLayout {
                    x: Theme.spacing-md;
                    y: 84px;
                    width: parent.width - 2 * Theme.spacing-md;
                    spacing: 10px;

                    MetricPill { label: "REMAINING"; value: root.remaining-label; }
                    MetricPill { label: "ELAPSED / TOTAL"; value: root.elapsed-label + " / " + root.total-label; }
                }
            }

            DemoCard {
                x: 0px;
                y: 260px;
                width: parent.width;
                height: parent.height - 260px;
                title: "Your focus log";
                subtitle: "Recent sessions shown as representative local data.";
                emphasized: true;

                VerticalLayout {
                    x: Theme.spacing-md;
                    y: 86px;
                    width: parent.width - 2 * Theme.spacing-md;
                    spacing: 10px;

                    for note in root.session-notes: SessionRow {
                        title: note.title;
                        detail: note.detail;
                        minutes: note.minutes;
                        confidence: note.confidence;
                    }
                }

                LinearProgress {
                    x: Theme.spacing-md;
                    y: parent.height - 42px;
                    width: parent.width - 2 * Theme.spacing-md;
                    progress: 0.68;
                }
                Text { x: Theme.spacing-md; y: parent.height - 24px; text: "Daily goal progress"; font-size: 11px; color: Theme.text-muted; }
            }
        }
        // Stage 17: the production Dashboard (Field Notebook style) covers the whole window. The
        // other surfaces below (Timer, Text spike, Map lab) are the not-yet-migrated Stage 4-14
        // screens and debug labs; the page's tab row switches between Dashboard and Timer.
        if root.show-dashboard && !root.wabi && !root.show-break: FnDashboardPage {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            d: root.fn-data;
            dark: root.fn-dark;
            select-entry(id) => { root.fn-select-entry(id); }
            toggle-entry(id) => { root.fn-toggle-entry(id); }
            focus-task(id) => { root.fn-focus-task(id); }
            set-full(f) => { root.fn-set-full(f); }
            set-range(i) => { root.fn-set-range(i); }
            toggle-theme => { root.appearance-toggle-dark(); }
            open-menu => { root.menu-open = !root.menu-open; }
            open-timer => { root.show-dashboard = false; root.show-text-spike = false; root.show-map = false; }
            open-break => { root.show-break = true; root.break-opened(); }
            start-focus => { root.show-dashboard = false; root.show-text-spike = false; root.show-map = false; root.fn-start-focus(); }
        }

        // Stage 20: the Field Notebook Break Room.
        if root.show-break && !root.wabi: FnBreakPage {
            width: parent.width;
            height: parent.height;
            d: root.fn-break;
            rock-bounce: root.rock-bounce;
            rock-celebrate: root.rock-celebrate;
            pill-tone: root.fn-data.pill-tone;
            pill-label: root.fn-data.pill-label;
            pill-score: root.fn-data.pill-score;
            toggle-theme => { root.appearance-toggle-dark(); }
            open-menu => { root.menu-open = !root.menu-open; }
            picked-tab(i) => {
                if i == 0 { root.show-break = false; root.show-dashboard = true; root.surface-changed(); }
                if i == 2 { root.show-break = false; root.show-dashboard = false; root.show-text-spike = false; root.show-map = false; root.surface-changed(); }
            }
            play(i) => { root.break-play(i); }
            unlock(i) => { root.break-unlock(i); }
            add-water => { root.break-water(); }
            next-stretch => { root.break-stretch(); }
            pat-rock => { root.break-pat(); }
        }

        // Stage 19: the Wabi-Sabi style replaces the whole production surface (sidebar shell).
        if root.wabi && root.production-surface: WabiPage {
            width: parent.width;
            height: parent.height;
            sidebar: root.wabi-sidebar;
            dash: root.wabi-dash;
            timer: root.wabi-timer;
            quiet-data: root.wabi-quiet-data;
            on-timer: !root.show-dashboard && !root.show-break;
            on-rest: root.show-break;
            rest-menu-open: root.rest-menu-open;
            rest: root.wabi-rest;
            rest-room: root.rest-room;
            breath-ring: root.breath-ring;
            album-cover-seq: root.album-cover-seq;
            album-leaf-seq: root.album-leaf-seq;
            album-slide-open: root.album-slide-open;
            album: root.album;
            rock-bounce: root.rock-bounce;
            // "Already on Rest: toggle the submenu. Coming from elsewhere: open it."
            open-rest => {
                if root.show-break { root.rest-menu-open = !root.rest-menu-open; }
                else { root.rest-menu-open = true; root.show-break = true; root.break-opened(); }
            }
            pick-room(i) => { root.rest-pick-room(i); }
            rest-toggle => { root.rest-toggle(); }
            rest-reset => { root.rest-reset(); }
            rest-edit(t) => { root.rest-edit(t); }
            rest-play(i) => { root.break-play(i); }
            rest-unlock(i) => { root.break-unlock(i); }
            next-tree => { root.rest-tree(); }
            pat-rock => { root.break-pat(); }
            breath-toggle => { root.rest-breath(); }
            album-open => { root.album-open(); }
            album-turn(d) => { root.album-turn(d); }
            album-close => { root.album-close(); }
            quiet: root.wabi-quiet;
            theme-locked: root.theme-locked;
            dark: root.appearance-dark;
            timer-menu-open: root.wabi-timer-menu-open;
            sakura: root.sakura;
            petals: root.petals;
            texture-frame: root.texture-frame;
            open-dashboard => { root.show-break = false; root.rest-menu-open = false; root.wabi-open-dashboard(); }
            open-timer => { root.show-break = false; root.rest-menu-open = false; root.wabi-open-timer(); }
            toggle-theme => { root.appearance-toggle-dark(); }
            open-menu => { root.menu-open = !root.menu-open; }
            toggle-quiet => { root.wabi-toggle-quiet(); }
            toggle-semester => { root.wabi-toggle-semester(); }
            toggle-course(i) => { root.wabi-toggle-course(i); }
            start-one => { root.wabi-start-one(); }
            mark-one => { root.wabi-mark-one(); }
            deadline-mark(i) => { root.wabi-deadline-mark(i); }
            deadline-focus(i) => { root.wabi-deadline-focus(i); }
            deadline-select(i) => { root.wabi-deadline-select(i); }
            planned-mark(i) => { root.wabi-planned-mark(i); }
            planned-select(i) => { root.wabi-planned-select(i); }
            timer-primary => { root.toggle-timer(); }
            timer-reset => { root.reset-timer(); }
            timer-log => { root.wabi-timer-log(); }
            timer-mode(m) => { if m >= 0 { root.select-mode(m); } }
            quiet-pick(i) => { root.wabi-quiet-pick(i); }
        }

        // Field Notebook + Sakura: the texture and the petals lie over every production surface
        // (`body::after` z 0 and `.sakura-scatter` z 40 above the page; no sidebar to hide them).
        if root.sakura && !root.wabi && root.production-surface: SakuraTexture {
            width: parent.width;
            height: parent.height;
            frame: root.texture-frame;
        }
        if root.sakura && !root.wabi && root.production-surface: SakuraPetals {
            width: parent.width;
            height: parent.height;
            petals: root.petals;
        }

        // Stage 20: the open game (production's portal, z-index 500, over every surface)
        if root.show-break && root.games.open >= 0: BreakGames {
            // Wabi-Sabi's `scrollbar-gutter: stable` keeps 10px at the right out of every fixed
            // overlay (production's modals centre in the narrower box; the gutter stays undimmed)
            x: 0px;
            width: parent.width - (root.wabi ? 10px : 0px);
            height: parent.height;
            d: root.games;
            close => { root.game-close(); }
            wordle-key(k) => { root.wordle-key(k); }
            wordle-hard => { root.wordle-hard(); }
            geodle-edited(t) => { root.geodle-edited(t); }
            geodle-toggle => { root.geodle-toggle(); }
            geodle-pick(n) => { root.geodle-pick(n); }
            geodle-submit => { root.geodle-submit(); }
            flaggle-edited(t) => { root.flaggle-edited(t); }
            flaggle-toggle => { root.flaggle-toggle(); }
            flaggle-pick(n) => { root.flaggle-pick(n); }
            flaggle-submit => { root.flaggle-submit(); }
            durak-card(i) => { root.durak-card(i); }
            durak-act(a) => { root.durak-act(a); }
            travle-edited(t) => { root.travle-edited(t); }
            travle-toggle => { root.travle-toggle(); }
            travle-pick(n) => { root.travle-pick(n); }
            travle-submit => { root.travle-submit(); }
            travle-clear => { root.travle-clear(); }
            travle-zoom(i) => { root.travle-zoom(i); }
        }

        // The menu (`.topbar-menu` / `.wabi-toolbar-menu`) and the Theme / Style panel.
        if root.menu-open: TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.menu-open = false; }
        }
        if root.menu-open: MenuDropdown {
            // Field Notebook: right-aligned under the hamburger (page shell min(1720, w - 32),
            // topbar padding 22); Wabi-Sabi: under the sidebar's menu button.
            x: root.wabi ? 102px : (parent.width + min(1720px, parent.width - 32px)) / 2 - 22px - self.width;
            y: root.wabi ? 157px : 60px;
            change-theme => { root.menu-open = false; root.panel-view = 0; }
            change-style => { root.menu-open = false; root.panel-view = 1; }
        }
        if root.panel-view >= 0: AppearancePanel {
            width: parent.width;
            height: parent.height;
            centre-width: parent.width - (root.wabi ? 10px : 0px);
            styles-view: root.panel-view == 1;
            cards: root.panel-view == 1 ? root.style-cards : root.palette-cards;
            light-active: !root.appearance-dark;
            dark-enabled: !root.theme-locked;
            pick(i) => { if root.panel-view == 1 { root.appearance-pick-style(i); } else { root.appearance-pick-palette(i); } }
            set-dark(d) => { root.appearance-set-dark(d); }
            close => { root.panel-view = -1; }
        }

        // Stage 18: updater notice (production's "New update available." notice). Only exists
        // while visible, so it costs nothing - no animation, no timer - otherwise.
        if root.update-notice-visible: Rectangle {
            x: parent.width - self.width - 20px;
            y: parent.height - self.height - 20px;
            width: min(380px, parent.width - 40px);
            height: 96px;
            border-radius: 10px;
            background: Theme.surface-inset;
            border-width: 1px;
            border-color: Theme.border;

            Text { x: 16px; y: 12px; width: parent.width - 60px; text: root.update-notice-title; font-size: 15px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
            Text { x: 16px; y: 36px; width: parent.width - 32px; height: 36px; text: root.update-notice-body; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; overflow: elide; }
            if root.update-notice-action-label != "": Rectangle {
                x: 16px;
                y: parent.height - 30px;
                width: 88px;
                height: 24px;
                border-radius: 6px;
                background: Theme.primary;
                Text { text: root.update-notice-action-label; font-size: 12px; font-weight: 700; color: Theme.text-primary; }
                TouchArea { clicked => { root.update-notice-action(); } }
            }
            Rectangle {
                x: parent.width - 34px;
                y: 6px;
                width: 28px;
                height: 28px;
                Text { text: "×"; font-size: 18px; color: Theme.text-secondary; }
                TouchArea { clicked => { root.update-notice-dismiss(); } }
            }
        }
    }
    }
}
