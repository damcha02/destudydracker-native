import { Theme } from "../theme.slint";

export component PresetCard inherits FocusScope {
    in property <string> label;
    in property <string> detail;
    in property <bool> selected: false;
    callback clicked;

    min-width: 96px;
    min-height: 64px;
    focus-on-click: true;
    focus-on-tab-navigation: root.enabled;
    accessible-role: button;
    accessible-label: root.label + " timer preset";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    key-pressed(event) => {
        if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
            root.clicked();
            accept
        } else { reject }
    }

    Rectangle {
        x: area.pressed && root.enabled ? 1px : 0px;
        y: area.pressed && root.enabled ? 2px : 0px;
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-md;
        background: !root.enabled ? #222b35 : root.selected ? #2f4059 : area.has-hover ? #293847 : Theme.surface-inset;
        border-width: root.has-focus && root.enabled ? 2px : 1px;
        border-color: !root.enabled ? #46515b : root.has-focus ? Theme.warning : root.selected ? Theme.primary : area.has-hover ? Theme.border-strong : Theme.border;
        opacity: root.enabled ? 1.0 : 0.62;

        animate x, y, background, border-color, opacity { duration: Theme.transition-fast; easing: ease-out; }
    }

    Text {
        x: 14px;
        y: 12px;
        text: root.label;
        font-size: Theme.text-sm;
        font-weight: 800;
        color: root.selected ? Theme.primary-hover : Theme.text-primary;
    }

    Text {
        x: 14px;
        y: 35px;
        text: root.detail;
        font-size: 11px;
        color: Theme.text-muted;
    }

    area := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
