import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SessionRowData } from "../dashboard-types.slint";

component SessionItem inherits Rectangle {
    in property <SessionRowData> entry;

    height: 54px;
    accessible-role: list-item;
    accessible-label: root.entry.course + ", " + root.entry.kind + ", " + root.entry.duration + ", " + root.entry.when;

    Rectangle { x: 0px; y: 10px; width: 4px; height: 34px; border-radius: 2px; background: Theme.tone(root.entry.tone); }
    Text { x: 16px; y: 8px; width: parent.width - 16px - 82px; text: root.entry.course; font-size: 13px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
    Text { x: 16px; y: 29px; width: parent.width - 16px - 82px; text: root.entry.kind + " · " + root.entry.when; font-size: 11px; color: Theme.text-secondary; overflow: elide; }
    Text { x: parent.width - 74px; y: 8px; width: 74px; text: root.entry.duration; horizontal-alignment: right; font-size: 13px; font-weight: 700; color: Theme.text-primary; }
    Rectangle { x: 16px; y: parent.height - 1px; width: parent.width - 16px; height: 1px; background: Theme.grid-line; opacity: 0.6; }
}

// Scrollable, virtualized list of recent sessions.
export component SessionList inherits Rectangle {
    in property <[SessionRowData]> sessions;
    in property <string> empty-text: "No sessions recorded yet";

    ListView {
        width: parent.width;
        height: parent.height;
        for session in root.sessions: SessionItem { entry: session; }
    }

    if root.sessions.length == 0: Text {
        y: 6px;
        width: parent.width;
        text: root.empty-text;
        font-size: Theme.text-sm;
        color: Theme.text-muted;
    }
}
