// Stage 22a: the Field Notebook Social page ("Study Circle"): production's `SocialScreen.tsx`
// under `:root[data-app-style="field-notebook"] .study-circle-root`, geometry from the production
// boxes measured at 1520x980. Friends, Leaderboard and Profile are complete; Feed and Squad are
// Stage 22b and say so plainly (no fake controls). Data from `src/app_social.rs`.
import { FN } from "../fn/palette.slint";
import { MonoText, SerifText, SansText, HLine, DotLine } from "../fn/parts.slint";
import { FnTopbar, FnTabRow } from "../fn/shell.slint";
import { Emoji } from "../break/types.slint";
import { SocialView, SAvatar, SFriendRow, SRequestRow, SBoardRow, SStat } from "types.slint";

export global SocialBlue {
    // production's `#8fb4ff` (request badges, the own leaderboard row, code-plate keys)
    out property <color> blue: #8fb4ff;
}

// `ArenaAvatar` in the Field Notebook style: a flat paper box with the hairline edge.
export component FnAvatar inherits Rectangle {
    in property <SAvatar> a;
    in property <length> size: 38px;
    in property <length> font: 13.44px;
    width: root.size;
    height: root.size;
    border-radius: 2px;
    border-width: 1px;
    border-color: FN.line;
    background: FN.surface-2;
    clip: true;
    if root.a.kind == 7 && root.a.has-photo: Image { width: parent.width; height: parent.height; source: root.a.photo; image-fit: cover; }
    if !(root.a.kind == 7 && root.a.has-photo): Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.a.text;
        color: FN.ink;
        font-size: root.a.kind == 6 ? root.font * 0.93 : root.a.kind == 2 ? root.font * 1.4 : root.font;
        font-weight: root.a.kind == 1 ? 800 : root.a.kind == 2 ? 700 : 900;
        font-italic: root.a.kind == 2 || root.a.kind == 3;
        font-family: root.a.kind == 6 ? Emoji.family : root.a.kind == 1 || root.a.kind == 2 ? FN.serif : root.a.kind == 4 || root.a.kind == 5 ? FN.mono : FN.sans;
        letter-spacing: root.a.kind == 0 || root.a.kind == 1 ? -0.04 * root.font : 0px;
    }
    accessible-role: image;
    accessible-label: "Avatar " + root.a.text;
}

component Kicker inherits MonoText {
    font-size: 10px;
    letter-spacing: 1.8px;
    color: FN.ink-4;
}

// `.arena-btn--send`: ink fill, paper text (Newsreader 13px)
component SendButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> h: 36px;
    callback clicked();
    width: t.preferred-width + 34px;
    height: root.h;
    border-width: 1px;
    border-color: FN.ink;
    background: FN.ink;
    opacity: root.enabled ? 1 : 0.5;
    t := SerifText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.text; font-size: 13px; font-weight: 500; color: FN.desk; }
    TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
}

// `.arena-btn--accept` / `--decline` / Refresh: small uppercase mono on paper
component PaperButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    width: t.preferred-width + 26px;
    height: 30px;
    border-width: 1px;
    border-color: FN.line;
    background: touch.has-hover && root.enabled ? FN.paper-2 : FN.surface-2;
    opacity: root.enabled ? 1 : 0.5;
    t := MonoText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.text; font-size: 11px; letter-spacing: 0.66px; color: FN.ink-3; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
}

// `.arena-input`
component FnField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> read-only;
    in property <bool> upper;
    in-out property <string> text;
    callback accepted();
    callback edited(string);
    height: 44px;
    border-width: 1px;
    border-color: input.has-focus ? FN.ink-3 : FN.line;
    border-radius: 2px;
    background: FN.surface;
    clip: true;
    input := TextInput {
        x: 15px;
        width: parent.width - 30px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        enabled: root.enabled;
        read-only: root.read-only;
        font-family: FN.sans;
        font-size: 16px;
        color: FN.ink;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
        accessible-role: text-input;
        accessible-label: root.placeholder;
    }
    if root.text == "": SansText {
        x: 15px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        font-size: 16px;
        color: FN.ink-4;
    }
    public function select-all-and-copy() {
        input.select-all();
        input.copy();
    }
}

// `.arena-social-section h4` with its blue count
component SectionTitle inherits Rectangle {
    in property <string> text;
    in property <int> count;
    height: 23px;
    t := SansText { x: 0px; y: 0px; text: root.text; font-size: 14.08px; font-weight: 700; letter-spacing: 1.408px; color: FN.ink; }
    Rectangle {
        x: t.preferred-width + 8px;
        y: 0px;
        width: n.preferred-width + 14px;
        height: 16px;
        border-radius: 8px;
        background: SocialBlue.blue;
        n := SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.count; font-size: 11.52px; font-weight: 700; color: #081018; }
    }
    HLine { y: parent.height - 1px; tone: FN.ink; }
}

// `.arena-empty`
component EmptyCard inherits Rectangle {
    in property <string> strong;
    in property <string> text;
    in property <bool> small;
    height: col.preferred-height + (root.small ? 24px : 36px);
    border-width: 1px;
    border-color: FN.line-soft;
    background: FN.surface-2;
    col := VerticalLayout {
        x: 14px;
        width: parent.width - 28px;
        alignment: center;
        spacing: 4px;
        if root.strong != "": SansText { horizontal-alignment: center; text: root.strong; font-size: 14px; font-weight: 700; color: FN.ink; wrap: word-wrap; }
        SansText { horizontal-alignment: center; text: root.text; font-size: root.small ? 12.8px : 14px; color: FN.ink-3; wrap: word-wrap; }
    }
}

component PersonRow inherits Rectangle {
    in property <SAvatar> avatar;
    in property <string> name;
    in property <string> detail;
    in property <length> right: 0px;
    callback activated();
    in property <bool> clickable;
    height: max(59px, 10px + n.preferred-height + 3px + d.preferred-height + 10px + 4px);
    FnAvatar { x: 10px; y: (parent.height - 1px - self.height) / 2; a: root.avatar; }
    n := SansText { x: 60px; y: (parent.height - 1px - self.preferred-height - 3px - d.preferred-height) / 2; width: parent.width - 70px - root.right; text: root.name; font-size: 16px; font-weight: 700; color: FN.ink; overflow: elide; }
    d := SansText { x: 60px; y: n.y + n.preferred-height + 3px; width: parent.width - 70px - root.right; text: root.detail; font-size: 12.48px; color: FN.ink-3; overflow: elide; }
    DotLine { y: parent.height - 1px; width: parent.width; }
    if root.clickable: TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
    @children
}

// ------------------------------------------------------------------------------------ panels

// `.arena-panel-head`: a 44px icon box, a kicker and an h3, ruled below
component PanelHead inherits Rectangle {
    in property <string> icon;
    in property <string> kicker;
    in property <string> title;
    height: 57px;
    Rectangle {
        x: 0px;
        y: 0px;
        width: 44px;
        height: 44px;
        border-width: 1px;
        border-color: FN.line;
        background: FN.surface-2;
        SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.icon; font-size: 16px; font-weight: 900; color: FN.ink-3; }
    }
    Kicker { x: 56px; y: 6px; text: root.kicker; }
    SerifText { x: 56px; y: 20px; text: root.title; font-size: 18.72px; font-weight: 500; letter-spacing: -0.1872px; color: FN.ink; }
    HLine { y: parent.height - 1px; tone: FN.ink; }
}

// `.social-single-panel` > `article.arena-panel`
component ArticlePanel inherits Rectangle {
    in property <length> content-h;
    height: root.content-h + 2 * 28px + 40px - 28px + 2px + 40px;
    background: FN.surface-2;
    Rectangle {
        x: 26px;
        y: 28px;
        width: parent.width - 52px;
        height: root.content-h + 42px;
        border-width: 1px;
        border-color: FN.line;
        background: FN.surface;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #0000002e;
        Rectangle { x: 21px; y: 21px; width: parent.width - 42px; height: root.content-h; @children }
    }
}

component FriendsPanel inherits Rectangle {
    in property <SocialView> v;
    in-out property <string> code-draft;
    callback send(string);
    callback copy-invite();
    callback respond(string, bool);
    callback open-friend(string);
    private property <length> w: root.width;
    height: col.preferred-height;
    col := VerticalLayout {
        spacing: 16px;
        PanelHead { icon: "+"; kicker: "PLAYER TAGS"; title: "Friends"; }
        // `.arena-invite-card`
        Rectangle {
            height: 91px;
            border-width: 1px;
            border-color: FN.line-soft;
            background: FN.surface-2;
            Kicker { x: 13px; y: 17px; text: "INVITE LINK"; }
            SansText { x: 13px; y: 33px; width: parent.width - 26px - 10px - 209.8px - 10px - copy.width; wrap: word-wrap; text: "Share this link in WhatsApp or anywhere else. It opens the download page with your player tag ready to copy."; font-size: 13.12px; color: FN.ink-3; }
            invite := FnField { x: parent.width - 13px - copy.width - 10px - self.width; y: 23.5px; width: 209.8px; text: root.v.invite-link; read-only: true; placeholder: "Invite link"; }
            copy := SendButton { x: parent.width - 13px - self.width; y: 27.5px; text: "Copy invite link"; clicked => { invite.select-all-and-copy(); root.copy-invite(); } }
        }
        // `.arena-add-friend`
        HorizontalLayout {
            height: 44px;
            spacing: 10px;
            field := FnField {
                placeholder: "Enter player tag, e.g. ABCD-1234";
                text <=> root.code-draft;
                enabled: root.v.state == 4;
                accepted => { root.send(self.text); }
                // the input upper-cases every keystroke (`event.target.value.toUpperCase()`)
                edited(t) => { if t != t.to-uppercase() { self.text = t.to-uppercase(); } }
            }
            SendButton { h: 44px; text: "Send"; enabled: !root.v.busy && root.v.state == 4; clicked => { root.send(field.text); } }
        }
        VerticalLayout {
            padding-top: 4px;
            spacing: 16px;
            SectionTitle { text: "INCOMING"; count: root.v.incoming.length; }
            if root.v.incoming.length == 0: EmptyCard { small: true; text: "No incoming requests."; }
            VerticalLayout {
                for r in root.v.incoming: PersonRow {
                    avatar: r.avatar;
                    name: r.name;
                    detail: r.code;
                    right: 172px;
                    HorizontalLayout {
                        x: parent.width - 10px - self.preferred-width;
                        y: (parent.height - 1px - 30px) / 2;
                        height: 30px;
                        spacing: 7px;
                        PaperButton { text: "ACCEPT"; enabled: !root.v.busy; clicked => { root.respond(r.id, true); } }
                        PaperButton { text: "DECLINE"; enabled: !root.v.busy; clicked => { root.respond(r.id, false); } }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 16px;
            SectionTitle { text: "PENDING"; count: root.v.outgoing.length; }
            if root.v.outgoing.length == 0: EmptyCard { small: true; text: "No pending sent requests."; }
            VerticalLayout {
                for r in root.v.outgoing: PersonRow {
                    avatar: r.avatar;
                    name: r.name;
                    detail: r.code;
                    right: 80px;
                    Rectangle {
                        x: parent.width - 10px - self.width;
                        y: (parent.height - 1px - self.height) / 2;
                        width: p.preferred-width + 14px;
                        height: 19px;
                        border-width: 1px;
                        border-color: FN.line;
                        p := MonoText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "PENDING"; font-size: 10px; letter-spacing: 0.8px; color: FN.ink-3; }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 16px;
            SectionTitle { text: "YOUR FRIENDS"; count: root.v.friends.length; }
            if root.v.friends.length == 0: EmptyCard { text: "Share your player tag to build your friends leaderboard."; }
            // `.arena-friend-grid`: two columns, 8px apart
            if root.v.friends.length > 0: Rectangle {
                private property <length> cw: (root.w - 8px) / 2;
                height: ceil(root.v.friends.length / 2) * 67px - 8px;
                for f[i] in root.v.friends: PersonRow {
                    x: mod(i, 2) * (parent.cw + 8px);
                    y: floor(i / 2) * 67px;
                    width: parent.cw;
                    height: 59px;
                    avatar: f.avatar;
                    name: f.name;
                    detail: f.detail;
                    clickable: true;
                    activated => { root.open-friend(f.id); }
                    accessible-role: button;
                    accessible-label: f.name;
                }
            }
        }
    }
}

// ------------------------------------------------------------------------------- leaderboard

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: t.preferred-width + 28px;
    height: 35px;
    border-width: 1px;
    border-color: root.active ? FN.ink : FN.line;
    background: root.active ? FN.surface : transparent;
    t := SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.text; font-size: 13.44px; font-weight: 900; color: root.active ? FN.ink : FN.ink-3; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.active;
}

component LeaderboardPanel inherits Rectangle {
    in property <SocialView> v;
    callback refresh();
    callback scope(int);
    callback period(int);
    callback open-row(string);
    private property <length> name-w: (root.width - 70px - 26px - 90px - 60px - 4 * 14px) / 2;
    height: 28px + col.preferred-height + 40px + 2px;
    background: FN.surface;
    border-width: 1px;
    border-color: FN.line-soft;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #0000002e;
    col := VerticalLayout {
        x: 35px;
        y: 29px;
        width: parent.width - 70px;
        spacing: 0px;
        // `.arena-leaderboard-head`
        Rectangle {
            height: 79px;
            Rectangle {
                x: 0px;
                y: 14.5px;
                width: 36px;
                height: 36px;
                border-width: 1px;
                border-color: FN.line;
                background: FN.surface-2;
                SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "⚔"; font-family: Emoji.symbol != "" ? Emoji.symbol : FN.sans; font-size: 18.88px; color: FN.ink-3; }
            }
            Kicker { x: 46px; y: 4px; text: "ARENA STANDINGS"; }
            SerifText { x: 46px; y: 20px; text: root.v.arena-title; font-size: 23.2px; font-weight: 500; letter-spacing: -0.232px; color: FN.ink; }
            SansText { x: 46px; y: 47px; text: root.v.arena-subtitle; font-size: 16px; color: FN.ink-3; }
            ls := SansText { x: parent.width - self.preferred-width; y: 7.5px; text: "Last synced: " + root.v.last-synced; font-size: 12.16px; font-weight: 800; color: FN.ink-3; }
            PaperButton { x: parent.width - self.width; y: 27.5px; text: root.v.busy ? "SYNCING..." : "REFRESH"; enabled: !root.v.busy && root.v.state == 4; clicked => { root.refresh(); } }
            Rectangle { y: parent.height - 2px; height: 2px; background: FN.ink; }
        }
        // scope and period chips (20px in, 12px apart)
        HorizontalLayout {
            padding-left: 20px;
            height: 35px;
            spacing: 8px;
            alignment: start;
            Chip { text: "Friends Arena"; active: root.v.scope == 0; clicked => { root.scope(0); } }
            Chip { text: "Squad Arena"; active: root.v.scope == 1; clicked => { root.scope(1); } }
            Chip { text: "World Arena"; active: root.v.scope == 2; clicked => { root.scope(2); } }
        }
        Rectangle { height: 12px; }
        HorizontalLayout {
            padding-left: 20px;
            height: 35px;
            spacing: 8px;
            alignment: start;
            if root.v.scope != 1: Chip { text: "Daily Sprint"; active: root.v.period == 0; clicked => { root.period(0); } }
            if root.v.scope != 1: Chip { text: "Weekly League"; active: root.v.period == 1; clicked => { root.period(1); } }
            if root.v.scope != 1: Chip { text: "Hall of Focus"; active: root.v.period == 2; clicked => { root.period(2); } }
            if root.v.scope == 1: Chip { text: "Daily"; active: true; }
        }
        Rectangle { height: 30px; }
        if root.v.private-notice: VerticalLayout {
            EmptyCard { small: true; strong: "Private profile enabled"; text: "You are hidden from the global leaderboard. Switch to Friends Arena to compare with friends."; }
            Rectangle { height: 14px; }
        }
        // the squad scoreboard is Stage 22b
        if root.v.scope == 1: EmptyCard { strong: "Squad standings are not available yet"; text: "The Squad Arena arrives with squads in a later update. Friends Arena and World Arena work now."; }
        // `.fn-lb-table`
        if root.v.scope != 1: VerticalLayout {
            Rectangle {
                height: 20px;
                MonoText { x: 40px; y: 0px; text: "NAME"; font-size: 9.5px; letter-spacing: 1.33px; color: FN.ink-4; }
                MonoText { x: 40px + root.name-w + 14px; y: 0px; text: "HOURS"; font-size: 9.5px; letter-spacing: 1.33px; color: FN.ink-4; }
                MonoText { x: 40px + root.name-w + 14px + 90px + 14px; y: 0px; text: root.v.col-label; font-size: 9.5px; letter-spacing: 1.33px; color: FN.ink-4; }
                MonoText { x: parent.width - self.preferred-width; y: 0px; text: "SESSIONS"; font-size: 9.5px; letter-spacing: 1.33px; color: FN.ink-4; }
                HLine { y: parent.height - 1px; tone: FN.ink; }
            }
            Rectangle { height: 18px; }
            for row in root.v.rows: Rectangle {
                height: max(45px, nm.preferred-height + 27px);
                background: row.is-self ? FN.ink.with-alpha(0.04) : transparent;
                MonoText { x: 0px; y: (parent.height - self.preferred-height) / 2; width: 26px; text: row.rank; font-size: 11px; color: row.is-self ? SocialBlue.blue : FN.ink-4; }
                nm := SerifText { x: 40px; y: (parent.height - self.preferred-height) / 2; text: row.name; font-size: 15.5px; font-weight: 500; color: FN.ink; overflow: elide; width: min(self.preferred-width, root.name-w - (row.is-self ? code.width + 6px : 0px)); }
                code := Rectangle {
                    visible: row.is-self;
                    x: nm.x + nm.width + 6px;
                    y: (parent.height - self.height) / 2;
                    width: ct.preferred-width + 12px;
                    height: 19px;
                    border-width: 1px;
                    border-color: FN.line-soft;
                    ct := MonoText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: row.code; font-size: 10px; font-weight: 500; color: FN.ink-4; }
                }
                MonoText { x: 40px + root.name-w + 14px; y: (parent.height - self.preferred-height) / 2; text: row.hours; font-size: 12.5px; color: FN.ink; }
                Rectangle {
                    x: 40px + root.name-w + 14px + 90px + 14px;
                    y: (parent.height - 7px) / 2;
                    width: root.name-w;
                    height: 7px;
                    background: FN.surface-2;
                    Rectangle { x: 0px; width: parent.width * row.bar; background: row.is-self ? SocialBlue.blue : FN.green; }
                }
                MonoText { x: parent.width - self.preferred-width; y: (parent.height - self.preferred-height) / 2; text: row.sessions; font-size: 11.5px; color: FN.ink-4; }
                DotLine { y: parent.height - 1px; width: parent.width; }
                TouchArea { mouse-cursor: pointer; clicked => { root.open-row(row.id); } }
                accessible-role: button;
                accessible-label: "Rank " + row.rank + ", " + row.name + ", " + row.hours + ", " + row.sessions + " sessions";
            }
            if root.v.rows.length == 0: EmptyCard { strong: "No contenders yet"; text: "Start studying and sync to claim your rank."; }
            if root.v.rows.length > 0: VerticalLayout {
                Rectangle { height: 18px; }
                MonoText { height: 17.6px; text: "Bars are relative to the top of the board."; font-size: 11px; color: FN.ink-4; }
            }
        }
    }
}

// --------------------------------------------------------------------------------- profile

component CodePlate inherits Rectangle {
    in property <string> key;
    in property <string> text;
    in property <string> chip;
    in property <bool> enabled: true;
    callback clicked();
    width: 7px + 16px + 6px + t.preferred-width + 6px + 19px + 9px + 2px;
    height: 28px;
    border-width: 1px;
    border-color: FN.line;
    opacity: root.enabled ? 1 : 0.55;
    Rectangle {
        x: 8px;
        y: 6px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: SocialBlue.blue.with-alpha(0.18);
        MonoText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.key; font-size: 11.2px; font-weight: 800; color: SocialBlue.blue; }
    }
    t := MonoText { x: 30px; height: parent.height; vertical-alignment: center; text: root.text; font-size: 10px; font-weight: 800; letter-spacing: 0.8px; color: FN.ink-3; }
    Rectangle {
        x: 30px + t.preferred-width + 6px;
        y: 5px;
        width: 19px;
        height: 18px;
        border-radius: 9px;
        background: FN.surface-2;
        MonoText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.chip; font-size: 10.88px; color: FN.ink-3; }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
}

component MiniStat inherits Rectangle {
    in property <SStat> s;
    height: 46px;
    border-width: 1px;
    border-color: FN.line-soft;
    background: FN.surface-2;
    Rectangle {
        x: 10px;
        y: 9px;
        width: 28px;
        height: 28px;
        border-radius: 9px;
        background: root.s.tone == 1 ? @linear-gradient(135deg, #ffd700 0%, #ffa000 100%) : root.s.tone == 2 ? @linear-gradient(135deg, #8fb4ff 0%, #bbd2ff 100%) : root.s.tone == 3 ? @linear-gradient(135deg, #73956a 0%, #acc1a7 100%) : transparent;
        Text { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.s.icon; font-family: root.s.tone == 0 ? Emoji.family : FN.sans; font-size: 16px; font-weight: 900; color: #081018; }
    }
    SansText { x: 46px; y: 9.3px; text: root.s.value; font-size: 14.4px; font-weight: 700; color: FN.ink; }
    SansText { x: 46px; y: 25.7px; text: root.s.label; font-size: 9.92px; font-weight: 800; color: FN.ink-3; }
    accessible-role: text;
    accessible-label: root.s.label + ": " + root.s.value;
}

component ProfileToggle inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 68px;
    border-width: 1px;
    border-color: FN.line-soft;
    background: FN.surface-2;
    SansText { x: 15px; y: 15px; width: parent.width - 30px; text: root.title; font-size: 16px; font-weight: 700; color: FN.ink; }
    SansText { x: 15px; y: 38px; width: parent.width - 30px; text: root.text; font-size: 12.8px; color: FN.ink-3; overflow: elide; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: switch;
    accessible-label: root.title;
    accessible-checked: root.on;
}

component ProfilePanel inherits Rectangle {
    in property <SocialView> v;
    in-out property <string> name-draft;
    callback edit-name();
    callback save-name(string);
    callback cancel-name();
    callback copy-code();
    callback copy-invite();
    callback sync();
    callback toggle-private();
    callback toggle-auto-post();
    callback toggle-hours();
    private property <length> stat-w: (root.width - 16px) / 3;
    private property <length> console-h: 66px + (root.v.sync-error != "" ? err.preferred-height + 4px : 0px);
    height: 89px + 100px + 20px + root.console-h + 20px + 150px;
    // avatar (the editor is Stage 22b: the "Edit" caption is kept, inert)
    FnAvatar { x: 0px; y: 0px; a: root.v.avatar; size: 56px; font: 18.56px; }
    SansText { x: 17.1px; y: 61px; text: "Edit"; font-size: 11.52px; font-weight: 800; color: FN.ink-4; }
    if !root.v.name-editing: Rectangle {
        x: 72px;
        y: 8.7px;
        height: 22px;
        width: parent.width - 72px;
        nm := SerifText { x: 0px; y: 0px; text: root.v.name; font-size: 17.92px; font-weight: 500; letter-spacing: -0.1792px; color: FN.ink; }
        Rectangle {
            x: nm.preferred-width + 8px;
            y: 0.3px;
            width: et.preferred-width + 20px;
            height: 20px;
            border-radius: 10px;
            border-width: 1px;
            border-color: FN.line;
            background: #ffffff0f;
            et := SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "Edit"; font-size: 11.52px; font-weight: 800; color: FN.ink-3; }
            TouchArea { mouse-cursor: pointer; clicked => { root.edit-name(); } }
            accessible-role: button;
            accessible-label: "Edit player name";
        }
    }
    if root.v.name-editing: HorizontalLayout {
        x: 72px;
        y: 0px;
        width: min(360px, parent.width - 72px);
        height: 32px;
        spacing: 6px;
        name-field := FnField { height: 32px; text <=> root.name-draft; placeholder: "Player name"; accepted => { root.save-name(self.text); } }
        PaperButton { text: "✓"; clicked => { root.save-name(name-field.text); } }
        PaperButton { text: "×"; clicked => { root.cancel-name(); } }
    }
    HorizontalLayout {
        x: 72px;
        y: 36.3px;
        height: 28px;
        spacing: 8px;
        alignment: start;
        CodePlate { key: "#"; text: root.v.code; chip: "⧉"; clicked => { root.copy-code(); } }
        CodePlate { key: "↗"; text: "INVITE LINK"; chip: "⧉"; clicked => { root.copy-invite(); } }
        // the badges collection is Stage 22b
        CodePlate { key: "★"; text: "BADGES"; chip: "↗"; enabled: false; }
        Rectangle {
            y: 4px;
            height: 20px;
            width: pill-t.preferred-width + 27px;
            border-radius: 10px;
            background: root.v.sync-pill == 1 ? #c47a4d24 : root.v.sync-pill == 2 ? FN.ink-3.with-alpha(0.14) : #73956a24;
            Rectangle { x: 7px; y: 6.5px; width: 7px; height: 7px; border-radius: 3.5px; background: root.v.sync-pill == 1 ? FN.critical : root.v.sync-pill == 2 ? FN.ink-3 : FN.green; }
            pill-t := SansText { x: 17px; height: parent.height; vertical-alignment: center; text: root.v.sync-pill == 1 ? "Sync Issue" : root.v.sync-pill == 2 ? "Local Only" : "Arena Synced"; font-size: 11.2px; font-weight: 800; color: root.v.sync-pill == 1 ? FN.critical : root.v.sync-pill == 2 ? FN.ink-3 : FN.green; }
        }
    }
    // mini stats: 3 x 2, 8px apart
    for s[i] in root.v.stats: MiniStat {
        x: mod(i, 3) * (root.stat-w + 8px);
        y: 89px + floor(i / 3) * 54px;
        width: root.stat-w;
        s: s;
    }
    // `.arena-sync-console`
    Rectangle {
        y: 89px + 100px + 20px;
        height: root.console-h;
        border-radius: 20px;
        border-width: 1px;
        border-color: FN.line;
        background: #ffffff09;
        Kicker { x: 15px; y: 19px; text: "CLOUD SYNC"; }
        SansText { x: 15px; y: 33px; text: "Last synced: " + root.v.last-synced; font-size: 16px; color: FN.ink-3; }
        err := SansText { visible: root.v.sync-error != ""; x: 15px; y: 55px; width: parent.width - 150px; wrap: word-wrap; text: root.v.sync-error; font-size: 13px; color: FN.critical; }
        SendButton { x: parent.width - 15px - self.width; y: 15px; text: root.v.busy ? "Syncing..." : "Sync Arena"; enabled: !root.v.busy && root.v.state == 4; clicked => { root.sync(); } }
    }
    // `.profile-options`
    Rectangle {
        y: 89px + 100px + 20px + root.console-h + 20px;
        height: 150px;
        border-width: 1px;
        border-color: FN.line;
        background: FN.surface;
        ProfileToggle { x: 1px; y: 1px; width: (parent.width - 2px - 12px) / 2; title: root.v.private ? "Private profile" : "Public profile"; text: root.v.private ? "Hidden from global feed and leaderboard." : "Shown on global feed and leaderboard."; on: !root.v.private; clicked => { root.toggle-private(); } }
        ProfileToggle { x: 1px + (parent.width - 2px - 12px) / 2 + 12px; y: 1px; width: (parent.width - 2px - 12px) / 2; title: root.v.auto-post ? "Auto-post on" : "Auto-post off"; text: root.v.auto-post ? "Completed sessions queue feed posts automatically." : "You choose which sessions to post."; on: root.v.auto-post; clicked => { root.toggle-auto-post(); } }
        ProfileToggle { x: 1px; y: 81px; width: (parent.width - 2px - 12px) / 2; title: "Show hours to friends"; text: "Your totals in the friends standings."; on: root.v.show-hours; clicked => { root.toggle-hours(); } }
    }
}

// ------------------------------------------------------------------------- deferred / none

component NoticePanel inherits Rectangle {
    in property <string> icon;
    in property <string> kicker;
    in property <string> title;
    in property <string> text;
    height: col.preferred-height;
    col := VerticalLayout {
        spacing: 16px;
        PanelHead { icon: root.icon; kicker: root.kicker; title: root.title; }
        SansText { text: root.text; font-size: 14px; color: FN.ink-3; wrap: word-wrap; }
        @children
    }
}

// ---------------------------------------------------------------------------------- page

export component FnSocialPage inherits Rectangle {
    in property <SocialView> v;
    in property <int> pill-tone;
    in property <string> pill-label;
    in property <string> pill-score;
    in property <bool> unread;
    in-out property <string> code-draft;
    in-out property <string> name-draft;
    callback toggle-theme();
    callback open-menu();
    callback picked-tab(int);
    callback subtab(int);
    callback send-request(string);
    callback respond(string, bool);
    callback open-person(string);
    callback copy-code();
    callback copy-invite();
    callback refresh();
    callback scope(int);
    callback period(int);
    callback edit-name();
    callback save-name(string);
    callback cancel-name();
    callback toggle-private();
    callback toggle-auto-post();
    callback toggle-hours();
    callback create-account();

    private property <length> shell-w: min(1720px, root.width - 32px);
    private property <length> shell-x: (root.width - root.shell-w) / 2;
    private property <length> desk-y: 82px + 37px + 12px;
    private property <length> inner-w: root.shell-w - 2px - 68px;
    private property <length> nav-w: min(920px, root.inner-w);
    private property <length> single-w: min(720px, root.inner-w);
    private property <length> body-h: body.preferred-height;
    private property <length> section-h: 1px + 26px + 56.6px + (root.v.state == 4 ? 37px : 0px) + 22px + root.body-h + 30px + 1px;

    background: FN.desk;
    clip: true;

    Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        viewport-height: root.desk-y + root.section-h + 40px;

        FnTopbar {
            x: root.shell-x;
            y: 0px;
            width: root.shell-w;
            pill-tone: root.pill-tone;
            pill-label: root.pill-label;
            pill-score: root.pill-score;
            toggle-theme => { root.toggle-theme(); }
            open-menu => { root.open-menu(); }
        }
        // `section.arena-root.study-circle-root`
        Rectangle {
            x: root.shell-x;
            y: root.desk-y;
            width: root.shell-w;
            height: root.section-h;
            border-width: 1px;
            border-color: FN.line;
            background: FN.surface;
            // `.arena-hero-header`, ruled below (2px ink)
            Rectangle {
                x: 35px;
                y: 27px;
                width: root.inner-w;
                height: 56.6px;
                SerifText { y: -4px; width: parent.width; height: self.preferred-height; horizontal-alignment: center; text: "Study Circle"; font-size: 27px; font-weight: 500; letter-spacing: -0.27px; color: FN.ink; }
                MonoText { y: 29.6px; width: parent.width; horizontal-alignment: center; text: "ATTENDANCE SHEET · FRIENDS · SQUADS · QUIET ACCOUNTABILITY"; font-size: 10px; letter-spacing: 1.8px; color: FN.ink-4; }
                Rectangle { y: parent.height - 2px; height: 2px; background: FN.ink; }
            }
            // `.social-nav`
            if root.v.state == 4: Rectangle {
                x: 35px + (root.inner-w - root.nav-w) / 2;
                y: 27px + 56.6px;
                width: root.nav-w;
                height: 37px;
                HLine { y: parent.height - 1px; tone: FN.ink; }
                HorizontalLayout {
                    spacing: 2px;
                    alignment: start;
                    for label[i] in ["Feed", "Leaderboard", "Friends", "Squad", "Profile"]: item := Rectangle {
                        private property <bool> active: root.v.subtab == i;
                        private property <bool> badge: i == 2 && root.v.incoming-count > 0;
                        width: t.preferred-width + 28px + (self.badge ? 22px : 0px);
                        t := SerifText { x: 14px; y: 10px; text: label; font-size: 13px; font-weight: 900; color: item.active || touch.has-hover ? FN.ink : FN.ink-4; }
                        if item.badge: Rectangle {
                            x: 14px + t.preferred-width + 6px;
                            y: 10px;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: SocialBlue.blue;
                            drop-shadow-blur: 0px;
                            Rectangle { x: -2px; y: -2px; width: 20px; height: 20px; border-radius: 10px; border-width: 2px; border-color: SocialBlue.blue.with-alpha(0.22); }
                            SerifText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.v.incoming-count > 9 ? "9+" : root.v.incoming-count; font-size: 10.24px; font-weight: 900; color: FN.surface; }
                        }
                        if item.active: Rectangle { y: parent.height - 2px; height: 2px; background: FN.ink; }
                        touch := TouchArea { mouse-cursor: pointer; clicked => { root.subtab(i); } }
                        accessible-role: tab;
                        accessible-label: label + (item.badge ? ", " + root.v.incoming-count + " incoming friend requests" : "");
                        accessible-checked: item.active;
                    }
                }
            }
            body := VerticalLayout {
                x: 35px;
                y: 27px + 56.6px + (root.v.state == 4 ? 37px : 0px) + 22px;
                width: root.inner-w;
                // no account / unavailable / creating
                if root.v.state != 4: HorizontalLayout {
                    alignment: center;
                    ArticlePanel {
                        width: root.single-w;
                        content-h: notice.preferred-height;
                        notice := NoticePanel {
                            icon: "+";
                            kicker: "SOCIAL ACCOUNT";
                            title: root.v.state == 0 ? "Social is unavailable" : root.v.state == 2 ? "Creating your account…" : root.v.state == 3 ? (root.v.restore-error != "" ? "Your profile could not be loaded" : "Loading your profile…") : "Not set up on this device";
                            text: root.v.state == 0
                                ? "This build is not configured for the Social service. Everything else in Study Tracker works as usual."
                                : root.v.state == 1
                                ? "Friends, leaderboards and Daily Skribbl need a Social account. Your study data stays on this device either way; nothing is shared until you set up an account."
                                : root.v.state == 3 && root.v.restore-error != ""
                                ? root.v.restore-error + " Everything else in Study Tracker works as usual."
                                : "One moment.";
                            if root.v.state == 3 && root.v.restore-error != "": HorizontalLayout {
                                alignment: start;
                                SendButton { text: "Try again"; clicked => { root.refresh(); } }
                            }
                            if root.v.state == 1: HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                SendButton { text: "Create a new Social account"; clicked => { root.create-account(); } }
                                PaperButton { y: 3px; text: "LINK AN EXISTING ACCOUNT"; enabled: false; }
                            }
                            if root.v.state == 1: SansText { text: "Linking the account from your previous Study Tracker install comes with the data migration."; font-size: 12.48px; color: FN.ink-4; wrap: word-wrap; }
                        }
                    }
                }
                if root.v.state == 4 && root.v.subtab == 2: HorizontalLayout {
                    alignment: center;
                    ArticlePanel {
                        width: root.single-w;
                        content-h: friends.height;
                        friends := FriendsPanel {
                            width: root.single-w - 52px - 42px;
                            v: root.v;
                            code-draft <=> root.code-draft;
                            send(c) => { root.send-request(c); }
                            respond(id, a) => { root.respond(id, a); }
                            open-friend(id) => { root.open-person(id); }
                            copy-invite => { root.copy-invite(); }
                        }
                    }
                }
                if root.v.state == 4 && root.v.subtab == 1: LeaderboardPanel {
                    v: root.v;
                    refresh => { root.refresh(); }
                    scope(i) => { root.scope(i); }
                    period(i) => { root.period(i); }
                    open-row(id) => { root.open-person(id); }
                }
                if root.v.state == 4 && root.v.subtab == 4: HorizontalLayout {
                    alignment: center;
                    ArticlePanel {
                        width: root.single-w;
                        content-h: profile.height;
                        profile := ProfilePanel {
                            width: root.single-w - 52px - 42px;
                            v: root.v;
                            name-draft <=> root.name-draft;
                            edit-name => { root.edit-name(); }
                            save-name(n) => { root.save-name(n); }
                            cancel-name => { root.cancel-name(); }
                            copy-code => { root.copy-code(); }
                            copy-invite => { root.copy-invite(); }
                            sync => { root.refresh(); }
                            toggle-private => { root.toggle-private(); }
                            toggle-auto-post => { root.toggle-auto-post(); }
                            toggle-hours => { root.toggle-hours(); }
                        }
                    }
                }
                if root.v.state == 4 && (root.v.subtab == 0 || root.v.subtab == 3): HorizontalLayout {
                    alignment: center;
                    ArticlePanel {
                        width: root.single-w;
                        content-h: later.preferred-height;
                        later := NoticePanel {
                            icon: root.v.subtab == 0 ? "✦" : "S";
                            kicker: root.v.subtab == 0 ? "CIRCLE LOG" : "SQUADS";
                            title: "Coming in a later update";
                            text: root.v.subtab == 0
                                ? "The circle log, posts, polls and comments arrive with the next Social update. Friends, Leaderboard and Profile work now."
                                : "Squads, squad chat and the Squad Arena arrive with the next Social update. Friends, Leaderboard and Profile work now.";
                        }
                    }
                }
            }
        }

        // the tab row stays on top while scrolling
        FnTabRow {
            x: 0px;
            y: 82px;
            width: root.width;
            content-x: max(28px, root.width / 2 - 860px);
            active-tab: 5;
            social-unread: root.unread;
            picked(i) => { root.picked-tab(i); }
        }
    }
}
