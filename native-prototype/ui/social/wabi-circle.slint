// Stage 22a: the Wabi-Sabi "Circle" (production's `SocialScreen.tsx` under
// `data-app-style="wabi-sabi"`): Feed (the attendance chips), Standings (competitive only),
// Friends, Squad and Profile, chosen from the sidebar's Circle submenu. Geometry from production
// DOM probes at 1520x980 (content x = 186 + 32, panels max 760 wide). The feed itself and squads
// arrive in Stage 22b (`wabi-feed.slint`, `wabi-squad.slint`). Rust (`src/app_social.rs`)
// prepares every value.
import { WS } from "../wabi/palette.slint";
import { WEyebrow } from "../wabi/parts.slint";
import { SAvatar, SFriendRow, SBoardRow, SStat, SocialView, SocialData } from "types.slint";
import { WAvatar } from "wabi-avatar.slint";
import { WabiFeedPanel } from "wabi-feed.slint";
import { WabiSquadPanel } from "wabi-squad.slint";
export { WAvatar } from "wabi-avatar.slint";

component WSans inherits Text {
    font-family: WS.sans;
    color: WS.ink;
}

component WSerif inherits Text {
    font-family: WS.serif;
    color: WS.ink;
}

// `.arena-btn` in Wabi: an upper-case text button (sage `--send`, faint `--decline`)
component WTextButton inherits Rectangle {
    in property <string> text;
    in property <bool> send: true;
    in property <bool> enabled: true;
    callback clicked();
    width: t.preferred-width;
    height: 18px;
    t := WSans {
        x: 0px;
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        font-size: 10.5px;
        letter-spacing: 1.365px;
        color: !root.enabled ? WS.faint : touch.has-hover ? WS.ink : root.send ? WS.sage : WS.faint;
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.text;
}

// `.arena-avatar` in Wabi: a hue gradient disc (or the photo)
// `.section-label` over a list: eyebrow, count on the right, a soft rule below
component WSection inherits Rectangle {
    in property <string> title;
    in property <int> count;
    height: 50px;
    WEyebrow { x: 0px; y: 30px; height: 12px; vertical-alignment: center; text: root.title; font-size: 11px; letter-spacing: 2.2px; }
    WSans { x: parent.width - 8px - self.preferred-width; y: 30px; height: 12px; vertical-alignment: center; text: root.count; font-size: 11px; color: WS.faint; }
    Rectangle { y: parent.height - 1px; height: 1px; background: WS.rule-soft; }
}

component WPersonRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <length> right: 0px;
    in property <length> min-h: 46px;
    callback activated();
    in property <bool> clickable;
    height: max(root.min-h, n.preferred-height + 24px);
    n := WSerif {
        x: 0px;
        y: (parent.height - 1px - self.preferred-height) / 2;
        width: min(self.preferred-width, parent.width - root.right - 140px);
        text: root.name;
        font-size: 19px;
        overflow: elide;
    }
    WSans {
        x: n.width + 10px;
        y: (parent.height - 1px - self.preferred-height) / 2 + 2px;
        width: parent.width - root.right - n.width - 10px;
        text: root.detail;
        font-size: 11px;
        letter-spacing: 1.1px;
        color: WS.faint;
        overflow: elide;
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: WS.rule-soft; }
    if root.clickable: TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
    @children
}

component WEmpty inherits Rectangle {
    in property <string> text;
    height: 46px;
    WSans { x: 0px; y: 0px; height: parent.height - 1px; vertical-alignment: center; text: root.text; font-size: 13px; color: WS.faint; }
    Rectangle { y: parent.height - 1px; height: 1px; background: WS.rule-soft; }
}

// ------------------------------------------------------------------------------------ friends

component WFriends inherits Rectangle {
    in property <SocialView> v;
    in-out property <string> code-draft;
    callback send(string);
    callback copy-invite();
    callback respond(string, bool);
    callback open-friend(string);
    height: col.preferred-height;
    col := VerticalLayout {
        WSection { title: "INCOMING"; count: root.v.incoming.length; }
        if root.v.incoming.length == 0: WEmpty { text: "No incoming requests."; }
        for r in root.v.incoming: WPersonRow {
            min-h: 51px;
            name: r.name;
            detail: r.code;
            right: 105px;
            HorizontalLayout {
                x: parent.width - 105px - self.preferred-width;
                y: (parent.height - 1px - 18px) / 2;
                height: 18px;
                spacing: 8px;
                WTextButton { text: "ACCEPT"; enabled: !root.v.busy; clicked => { root.respond(r.id, true); } }
                WTextButton { text: "DECLINE"; send: false; enabled: !root.v.busy; clicked => { root.respond(r.id, false); } }
            }
        }
        WSection { title: "PENDING"; count: root.v.outgoing.length; }
        if root.v.outgoing.length == 0: WEmpty { text: "No pending sent requests."; }
        for r in root.v.outgoing: WPersonRow {
            name: r.name;
            detail: r.code;
            right: 105px;
            Rectangle {
                x: parent.width - 105px - self.width;
                y: (parent.height - 1px - self.height) / 2;
                width: pt.preferred-width + 13px;
                height: 17px;
                border-radius: 8.5px;
                background: WS.paper;
                pt := WSans { x: 6.5px; height: parent.height; vertical-alignment: center; text: "Pending"; font-size: 11px; letter-spacing: 0.88px; color: WS.faint; }
            }
        }
        WSection { title: "YOUR FRIENDS"; count: root.v.friends.length; }
        if root.v.friends.length == 0: WEmpty { text: "No friends yet. Send your player tag to someone."; }
        for f in root.v.friends: WPersonRow {
            name: f.name;
            detail: f.detail;
            clickable: true;
            activated => { root.open-friend(f.id); }
        }
        // `.arena-panel-head` (ruled), then the add-friend form and the invite card
        Rectangle {
            height: 68px;
            WEyebrow { x: 0px; y: 4px; height: 12px; text: "ADD A FRIEND"; }
            WSerif { x: 0px; y: 24px; text: "Friends"; font-size: 27px; font-weight: 500; }
            Rectangle { y: parent.height - 1px; height: 1px; background: WS.rule-hard; }
        }
        Rectangle { height: 16px; }
        Rectangle {
            height: 35px;
            WEyebrow { x: 0px; y: 0px; height: parent.height - 1px; vertical-alignment: center; text: "TAG"; }
            field := TextInput {
                x: 37px;
                y: 0px;
                width: parent.width - 37px - 10px - send.width;
                height: parent.height - 1px;
                vertical-alignment: center;
                text <=> root.code-draft;
                enabled: root.v.state == 4;
                font-family: WS.sans;
                font-size: 15px;
                letter-spacing: 0.75px;
                color: WS.ink;
                single-line: true;
                accepted => { root.send(self.text); }
                // the input upper-cases every keystroke (`event.target.value.toUpperCase()`)
                edited => { if self.text != self.text.to-uppercase() { self.text = self.text.to-uppercase(); } }
                accessible-role: text-input;
                accessible-label: "Player tag";
            }
            if root.code-draft == "": WSans { x: 37px; y: 0px; height: parent.height - 1px; vertical-alignment: center; text: "Enter player tag, e.g. ABCD-1234"; font-size: 15px; letter-spacing: 0.75px; color: WS.muted; }
            send := WTextButton { x: parent.width - self.width; y: (parent.height - self.height) / 2; text: "SEND"; enabled: !root.v.busy && root.v.state == 4; clicked => { root.send(field.text); } }
            Rectangle { y: parent.height - 1px; height: 1px; background: WS.rule-hard; }
        }
        Rectangle { height: 16px; }
        Rectangle {
            height: 79px;
            border-width: 1px;
            border-color: WS.rule-soft;
            background: WS.paper-1;
            WEyebrow { x: 17px; y: 19px; height: 12px; text: "INVITE LINK"; letter-spacing: 2.1px; }
            WSans { x: 17px; y: 43px; width: parent.width - 34px - 10px - copy.width; height: 21px; vertical-alignment: center; text: root.v.invite-link; font-size: 15px; letter-spacing: 0.75px; overflow: elide; }
            copy := WTextButton { x: parent.width - 17px - self.width; y: 44.5px; text: "COPY INVITE LINK"; clicked => { root.copy-invite(); } }
        }
    }
}

// ------------------------------------------------------------------------------------ standings

component WTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: t.preferred-width;
    height: 19px;
    t := WSans { x: 0px; y: 0px; height: 16px; vertical-alignment: center; text: root.text; font-size: 11px; letter-spacing: 1.65px; color: root.active || touch.has-hover ? WS.ink : WS.faint; }
    if root.active: Rectangle { y: parent.height - 1px; height: 1px; background: WS.ink; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.active;
}

// One podium column. Production's grid aligns the names, times and avatars across the columns
// (name bottoms at 91px under the rule); the column's top and its rank badge step down by place.
component WPodiumCol inherits Rectangle {
    in property <SBoardRow> e;
    in property <int> place;
    callback activated();
    private property <length> top: root.place == 1 ? 1px : root.place == 2 ? 23px : 18px;
    private property <length> badge: root.place == 1 ? 54px : 32px;
    Rectangle {
        x: 20px;
        y: root.top + 12px;
        width: root.badge;
        height: root.badge;
        background: root.place == 1 ? WS.paper : WS.paper.with-alpha(0.6);
        // `.arena-rank-badge--1` keeps production's soft gold glow
        drop-shadow-blur: root.place == 1 ? 16px : 8px;
        drop-shadow-color: root.place == 1 ? #f2cf4a66 : #d8c9a033;
        WSerif { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.place; font-size: 26px; font-weight: 500; color: root.place == 1 ? WS.vermilion : WS.muted; }
    }
    WSerif { x: 20px; y: 91px - self.preferred-height; width: parent.width - 40px; text: root.e.name + (root.e.is-self ? " (You)" : ""); font-size: 18px; overflow: elide; }
    WSans { x: 20px; y: 94px; text: root.e.hours; font-size: 12px; color: WS.muted; }
    WAvatar { x: 20px; y: 111px; a: root.e.avatar; size: 30px; muted-glyph: !root.e.is-self; }
    Rectangle { x: parent.width - 1px; y: root.top; width: 1px; height: parent.height - root.top; background: WS.rule-soft; }
    TouchArea { y: root.top; height: parent.height - root.top; mouse-cursor: pointer; clicked => { root.activated(); } }
    accessible-role: button;
    accessible-label: "Rank " + root.place + ", " + root.e.name + ", " + root.e.hours;
}

component WStandings inherits Rectangle {
    in property <SocialView> v;
    callback scope(int);
    callback period(int);
    callback open-row(string);
    private property <length> col-w: root.width / 3;
    private property <length> podium-h: root.v.rows.length == 0 ? 0px : 155px;
    height: 59px + root.podium-h + 14px + max(0, root.v.rows.length - 3) * 67px + (root.v.rows.length == 0 || root.v.scope == 1 || root.v.private-notice ? 90px : 0px);
    HorizontalLayout {
        x: 0px;
        y: 22px;
        height: 19px;
        spacing: 18px;
        WTab { text: "FRIENDS ARENA"; active: root.v.scope == 0; clicked => { root.scope(0); } }
        WTab { text: "SQUAD ARENA"; active: root.v.scope == 1; clicked => { root.scope(1); } }
        WTab { text: "WORLD ARENA"; active: root.v.scope == 2; clicked => { root.scope(2); } }
    }
    if root.v.scope != 1: HorizontalLayout {
        x: parent.width - self.preferred-width;
        y: 22px;
        height: 19px;
        spacing: 18px;
        WTab { text: "DAILY SPRINT"; active: root.v.period == 0; clicked => { root.period(0); } }
        WTab { text: "WEEKLY LEAGUE"; active: root.v.period == 1; clicked => { root.period(1); } }
        WTab { text: "HALL OF FOCUS"; active: root.v.period == 2; clicked => { root.period(2); } }
    }
    Rectangle { y: 59px; height: 1px; background: WS.rule-hard; }
    if root.v.scope == 1 || root.v.private-notice || (root.v.rows.length == 0): Rectangle {
        y: 76px;
        height: 64px;
        border-width: 1px;
        border-color: WS.rule-soft;
        WSans {
            x: 18px;
            width: parent.width - 36px;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            text: root.v.scope == 1
                ? "Squad standings arrive with squads in a later update. Friends Arena and World Arena work now."
                : root.v.private-notice
                ? "Your profile is private, so you are hidden from the world standings."
                : "No one has a verified minute here yet. Start studying and sync to claim your place.";
            font-size: 14px;
            color: WS.ink-3;
        }
    }
    if root.v.scope != 1 && !root.v.private-notice: Rectangle {
        y: 59px + (root.v.private-notice ? 90px : 0px);
        height: root.podium-h;
        for e[i] in root.v.rows: WPodiumCol {
            visible: i < 3;
            x: min(i, 2) * root.col-w;
            y: 0px;
            width: root.col-w;
            height: parent.height;
            e: e;
            place: i + 1;
            activated => { root.open-row(e.id); }
        }
    }
    // the rest of the board, from #4 (51px rows, 16px apart)
    if root.v.scope != 1 && !root.v.private-notice: Rectangle {
        x: 14px;
        y: 59px + root.podium-h + 14px;
        width: parent.width - 28px;
        height: max(0, root.v.rows.length - 3) * 67px;
        for e[i] in root.v.rows: Rectangle {
            visible: i >= 3;
            y: max(0, i - 3) * 67px;
            height: 51px;
            WSerif { x: 4px; y: 9px; width: 32px; height: 32px; vertical-alignment: center; text: "#" + e.rank; font-size: 26px; font-weight: 500; color: WS.muted; }
            nm := WSerif { x: 56px; y: (parent.height - 1px - self.preferred-height) / 2; width: min(self.preferred-width, parent.width - 56px - 160px); text: e.name + (e.is-self ? " (You)" : ""); font-size: 16px; overflow: elide; }
            WAvatar { x: nm.x + nm.width + 12px; y: (parent.height - 1px - self.height) / 2; a: e.avatar; size: 26px; }
            WSerif { x: parent.width - 4px - self.preferred-width; y: 9.5px; text: e.hours; font-size: 15px; }
            WSans { x: parent.width - 4px - self.preferred-width; y: 28.5px; text: e.sessions + " sess."; font-size: 10.5px; letter-spacing: 0.84px; color: WS.faint; }
            Rectangle { y: parent.height - 1px; height: 1px; background: WS.rule-soft; }
            TouchArea { mouse-cursor: pointer; clicked => { root.open-row(e.id); } }
            accessible-role: button;
            accessible-label: "Rank " + e.rank + ", " + e.name + ", " + e.hours;
        }
    }
}

// ------------------------------------------------------------------------------------ profile

component WToggle inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 69px;
    WSerif { x: 0px; y: 14px; width: parent.width - 40px; text: root.title; font-size: 18px; overflow: elide; }
    WSans { x: 0px; y: 40px; width: parent.width - 40px; text: root.text; font-size: 12px; color: WS.muted; overflow: elide; }
    WSans { x: parent.width - self.preferred-width; y: 28px; text: root.on ? "ON" : "OFF"; font-size: 11px; letter-spacing: 1.65px; color: root.on ? WS.sage : WS.faint; }
    Rectangle { y: 0px; height: 1px; background: WS.rule-soft; }
    Rectangle { y: parent.height - 1px; height: 1px; background: WS.rule-soft; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: switch;
    accessible-label: root.title;
    accessible-checked: root.on;
}

component WProfile inherits Rectangle {
    in property <SocialView> v;
    in-out property <string> name-draft;
    callback edit-name();
    callback save-name(string);
    callback cancel-name();
    callback sync();
    callback toggle-private();
    callback toggle-auto-post();
    callback toggle-hours();
    private property <length> cw: root.width / 3;
    height: 603px - 22px;
    // `.arena-player-main`: YOU, the name with EDIT, the player tag; ruled below
    WEyebrow { x: 0px; y: 0px; height: 12px; text: "YOU"; }
    if !root.v.name-editing: Rectangle {
        x: 0px;
        y: 27px;
        height: 32px;
        nm := WSerif { x: 0px; y: 0px; text: root.v.name; font-size: 28px; font-weight: 500; }
        WTextButton { x: nm.preferred-width + 8px; y: 7px; text: "EDIT"; clicked => { root.edit-name(); } }
    }
    if root.v.name-editing: Rectangle {
        x: 0px;
        y: 27px;
        width: min(420px, parent.width);
        height: 32px;
        name-field := TextInput {
            x: 0px;
            width: parent.width - 120px;
            height: parent.height;
            vertical-alignment: center;
            text <=> root.name-draft;
            font-family: WS.serif;
            font-size: 22px;
            color: WS.ink;
            single-line: true;
            accepted => { root.save-name(self.text); }
            accessible-role: text-input;
            accessible-label: "Player name";
        }
        Rectangle { y: parent.height - 1px; width: parent.width - 120px; height: 1px; background: WS.ink; }
        WTextButton { x: parent.width - 110px; y: 7px; text: "SAVE"; clicked => { root.save-name(name-field.text); } }
        WTextButton { x: parent.width - 50px; y: 7px; text: "CANCEL"; send: false; clicked => { root.cancel-name(); } }
    }
    WSans { x: 0px; y: 74px; text: root.v.code; font-size: 11.5px; letter-spacing: 1.15px; color: WS.muted; }
    Rectangle { y: 98px; height: 1px; background: WS.rule-hard; }
    // the mini stats (production's order: today, week, month / all time, friends rank, global rank)
    for i in [0, 1, 3, 2, 5, 4]: Rectangle {
        private property <int> slot: i == 0 ? 0 : i == 1 ? 1 : i == 3 ? 2 : i == 2 ? 3 : i == 5 ? 4 : 5;
        x: mod(self.slot, 3) * root.cw;
        y: 99px + floor(self.slot / 3) * 126px;
        width: root.cw;
        height: 126px;
        if i < root.v.stats.length: WSerif { x: 26px; y: 18px; text: root.v.stats[i].value; font-size: 27px; font-weight: 500; letter-spacing: 0.08px; }
        if i < root.v.stats.length: WSans { x: 26px; y: 59px; text: root.v.stats[i].label; font-size: 10.5px; letter-spacing: 1.47px; color: WS.muted; }
        Rectangle { x: parent.width - 1px; width: 1px; background: WS.rule-soft; }
        Rectangle { y: parent.height - 1px; height: 1px; background: WS.rule-soft; }
    }
    // `.arena-sync-console`
    Rectangle {
        y: 373px;
        height: 31px;
        WSans { x: 0px; y: 2px; text: "Last synced: " + root.v.last-synced + (root.v.sync-error != "" ? " · " + root.v.sync-error : ""); font-size: 12px; color: root.v.sync-error != "" ? WS.vermilion : WS.muted; }
        WTextButton { x: parent.width - self.width; y: 0px; text: root.v.busy ? "SYNCING..." : "SYNC ARENA"; enabled: !root.v.busy; clicked => { root.sync(); } }
        Rectangle { y: parent.height - 1px; height: 1px; background: WS.rule-soft; }
    }
    // `.profile-options`
    WToggle { x: 20px; y: 430px; width: (parent.width - 40px - 12px) / 2; title: root.v.private ? "Private profile" : "Public profile"; text: root.v.private ? "Hidden from global feed and leaderboard." : "Shown on global feed and leaderboard."; on: !root.v.private; clicked => { root.toggle-private(); } }
    WToggle { x: 20px + (parent.width - 40px - 12px) / 2 + 12px; y: 430px; width: (parent.width - 40px - 12px) / 2; title: root.v.auto-post ? "Auto-post on" : "Auto-post off"; text: root.v.auto-post ? "Completed sessions queue feed posts automatically." : "You choose which sessions to post."; on: root.v.auto-post; clicked => { root.toggle-auto-post(); } }
    WToggle { x: 20px; y: 511px; width: (parent.width - 40px - 12px) / 2; title: "Show hours to friends"; text: "Your totals in the friends standings."; on: root.v.show-hours; clicked => { root.toggle-hours(); } }
}

// ------------------------------------------------------------------------------------ the page

export component WabiCircle inherits Rectangle {
    in property <SocialView> v;
    in-out property <string> code-draft;
    in-out property <string> name-draft;
    callback send-request(string);
    callback respond(string, bool);
    callback open-person(string);
    callback copy-invite();
    callback refresh();
    callback scope(int);
    callback period(int);
    callback edit-name();
    callback save-name(string);
    callback cancel-name();
    callback toggle-private();
    callback toggle-auto-post();
    callback toggle-hours();
    callback create-account();
    // the content column: 32px in, panels at most 760px (the feed spans the whole column)
    private property <length> panel-w: min(760px, root.width - 64px);
    // the Wabi feed's height (reported by the conditional panel)
    in-out property <length> feed-h: 100px;
    in-out property <length> squad-h: 400px;
    private property <length> content-h:
        root.v.state != 4 ? 300px
        : root.v.subtab == 0 ? 164px + root.feed-h
        : root.v.subtab == 1 ? 59px + 155px + 14px + max(0, root.v.rows.length - 3) * 67px + 90px
        : root.v.subtab == 2 ? 22px + 3 * 50px + max(1, root.v.incoming.length) * 51px + max(1, root.v.outgoing.length) * 46px + max(1, root.v.friends.length) * 50px + 68px + 16px + 35px + 16px + 79px
        : root.v.subtab == 4 ? 603px
        : 22px + root.squad-h;
    background: transparent;
    flick := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: self.width;
        viewport-height: max(self.height, root.content-h + 40px);
        // ---- no account / not configured / restoring
        if root.v.state != 4: Rectangle {
            x: 32px;
            y: 22px;
            width: root.panel-w;
            height: 260px;
            WEyebrow { x: 0px; y: 0px; height: 12px; text: "CIRCLE"; }
            WSerif { x: 0px; y: 20px; text: root.v.state == 0 ? "Social is not available" : root.v.state == 1 ? "Not set up on this device" : root.v.state == 2 ? "Creating your account" : root.v.restore-error != "" ? "Your profile could not be loaded" : "Restoring your profile"; font-size: 27px; font-weight: 500; }
            Rectangle { y: 66px; height: 1px; background: WS.rule-hard; }
            WSans {
                x: 0px;
                y: 84px;
                width: parent.width;
                wrap: word-wrap;
                text: root.v.state == 0
                    ? "This build is not configured for the Social service. Everything else in Study Tracker works as usual."
                    : root.v.state == 1
                    ? "Friends, standings and Daily Skribbl need a Social account. Your study data stays on this device either way; nothing is shared until you set up an account."
                    : root.v.state == 3 && root.v.restore-error != ""
                    ? root.v.restore-error + " Everything else in Study Tracker works as usual."
                    : "One moment.";
                font-size: 14px;
                color: WS.ink-3;
            }
            if root.v.state == 1: Rectangle {
                x: 0px;
                y: 140px;
                width: cb.preferred-width + 52px;
                height: 38px;
                background: ct.has-hover ? WS.sage : WS.ink;
                cb := WSans { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "CREATE A NEW SOCIAL ACCOUNT"; font-size: 12px; font-weight: 500; letter-spacing: 1.92px; color: WS.on-ink; }
                ct := TouchArea { mouse-cursor: pointer; clicked => { root.create-account(); } }
                accessible-role: button;
                accessible-label: "Create a new Social account";
            }
            if root.v.state == 3 && root.v.restore-error != "": Rectangle {
                x: 0px;
                y: 140px;
                width: rb.preferred-width + 52px;
                height: 38px;
                border-width: 1px;
                border-color: rt.has-hover ? WS.ink : WS.line;
                rb := WSans { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "TRY AGAIN"; font-size: 12px; letter-spacing: 1.92px; }
                rt := TouchArea { mouse-cursor: pointer; clicked => { root.refresh(); } }
                accessible-role: button;
                accessible-label: "Try again";
            }
            if root.v.state == 1: WSans { x: 0px; y: 196px; width: parent.width; wrap: word-wrap; text: "Linking the account from your previous Study Tracker install comes with the data migration."; font-size: 12px; color: WS.faint; }
        }
        // ---- Feed: the hero, the attendance chips, then the feed (Stage 22b)
        if root.v.state == 4 && root.v.subtab == 0: Rectangle {
            x: 32px;
            y: 0px;
            // WabiPage's content column: min(1386px, viewport - 298px)
            width: min(1386px, root.width - 102px);
            height: 164px + root.feed-h;
            WSerif { y: 22px; width: parent.width; height: 37px; horizontal-alignment: center; vertical-alignment: center; text: "Circle"; font-size: 32px; font-weight: 500; }
            WSans { y: 66px; width: parent.width; height: 16px; horizontal-alignment: center; vertical-alignment: center; text: "Who is sitting down today. Attendance, not a leaderboard."; font-size: 14px; color: WS.muted; }
            if root.v.attendance.length == 0: WSans { x: 0px; y: 120px; text: "No friends seen in the last 48 hours. Add friends from the Friends tab below."; font-size: 14px; color: WS.muted; }
            HorizontalLayout {
                x: 0px;
                y: 115px;
                height: 30px;
                spacing: 8px;
                alignment: start;
                for f in root.v.attendance: Rectangle {
                    width: n.preferred-width + 12px + 8px + 9px + 14px + 2px;
                    // production's `border: 1px solid var(--wabi-rule-soft, ...)` substitutes a whole
                    // shorthand (`1px solid #ddd8c8`) into the declaration, which makes it invalid:
                    // the chips have no border (hover included)
                    Rectangle {
                        x: 13px;
                        y: (parent.height - 8px) / 2;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        border-width: 1.5px;
                        border-color: f.live ? WS.sage : WS.faint;
                        background: f.live ? WS.sage : transparent;
                    }
                    n := WSerif { x: 30px; height: parent.height; vertical-alignment: center; text: f.name; font-size: 14px; letter-spacing: 0.08px; color: f.live ? WS.ink : WS.muted; }
                    at := TouchArea { mouse-cursor: pointer; clicked => { root.open-person(f.id); } }
                    accessible-role: button;
                    accessible-label: f.name + (f.live ? ", sitting" : ", resting");
                }
            }
            WabiFeedPanel {
                x: 36px;
                y: 164px;
                width: min(1150px, parent.width - 72px);
                f: SocialData.feed;
                open-person(id) => { root.open-person(id); }
                refresh => { root.refresh(); }
                init => { root.feed-h = self.height; }
                changed height => { root.feed-h = self.height; }
            }
        }
        if root.v.state == 4 && root.v.subtab == 1: WStandings {
            x: 32px;
            y: 0px;
            width: root.panel-w;
            v: root.v;
            scope(i) => { root.scope(i); }
            period(i) => { root.period(i); }
            open-row(id) => { root.open-person(id); }
        }
        if root.v.state == 4 && root.v.subtab == 2: WFriends {
            x: 32px;
            y: 22px;
            width: root.panel-w;
            v: root.v;
            code-draft <=> root.code-draft;
            send(c) => { root.send-request(c); }
            respond(id, a) => { root.respond(id, a); }
            open-friend(id) => { root.open-person(id); }
            copy-invite => { root.copy-invite(); }
        }
        // ---- Squad (Stage 22b)
        if root.v.state == 4 && root.v.subtab == 3: WabiSquadPanel {
            x: 32px;
            y: 22px;
            width: root.panel-w;
            s: SocialData.squad;
            open-person(id) => { root.open-person(id); }
            init => { root.squad-h = self.height; }
            changed height => { root.squad-h = self.height; }
        }
        if root.v.state == 4 && root.v.subtab == 4: WProfile {
            x: 32px;
            y: 22px;
            width: root.panel-w;
            v: root.v;
            name-draft <=> root.name-draft;
            edit-name => { root.edit-name(); }
            save-name(n) => { root.save-name(n); }
            cancel-name => { root.cancel-name(); }
            sync => { root.refresh(); }
            toggle-private => { root.toggle-private(); }
            toggle-auto-post => { root.toggle-auto-post(); }
            toggle-hours => { root.toggle-hours(); }
        }
    }
}
