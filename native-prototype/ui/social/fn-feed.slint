// Stage 22b: the Field Notebook Feed ("Circle log"): production's `SocialScreen.tsx` feed under
// `:root[data-app-style="field-notebook"] .study-circle-root`, geometry from the production boxes
// measured at 1520x980 against the local mock (scripts/visual-parity). Data: `SocialData.feed`
// (src/app_social_view.rs); actions: `SocialActions`.
import { FN } from "../fn/palette.slint";
import { MonoText, SerifText, SansText, HLine, DotLine } from "../fn/parts.slint";
import { Emoji, CssLine } from "../break/types.slint";
import { SAvatar, SFeedPost, SFeedView, SPollOption, SReaction, SComment, SWeekRow, SocialActions } from "types.slint";
import { FnAvatar, Kicker, SendButton, PaperButton, EmptyCard, WrapText } from "fn-parts.slint";

// `.arena-input` as the composer, the poll editor and the comment form draw it: paper surface,
// hairline edge, the notebook rule 27 px down.
export component FnTextField inherits Rectangle {
    in property <string> placeholder;
    in property <string> initial;
    // bump to make the field re-read `initial` (after Rust cleared or replaced the draft)
    in property <int> rev;
    in property <bool> enabled: true;
    in property <length> font: 16px;
    in property <bool> ruled: true;
    in property <int> max-units: 0;
    callback edited(string);
    callback accepted();
    out property <string> value: input.text;
    height: 54px;
    border-width: 1px;
    border-color: input.has-focus ? FN.ink-3 : FN.line;
    border-radius: 2px;
    background: FN.surface;
    opacity: root.enabled ? 1 : 0.6;
    clip: true;
    if root.ruled: Rectangle { y: 27px; height: 1px; background: FN.line.with-alpha(0.35); }
    input := TextInput {
        x: 15px;
        width: parent.width - 30px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        text: root.initial;
        enabled: root.enabled;
        font-family: FN.sans;
        font-size: root.font;
        color: FN.ink;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
        accessible-role: text-input;
        accessible-label: root.placeholder;
    }
    changed rev => { input.text = root.initial; }
    if input.text == "": SansText {
        x: 15px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        font-size: root.font;
        color: FN.ink-4;
    }
    public function focus-field() { input.focus(); }
}

// `.feed-action-icon` (▧ image, ◉ poll)
component ActionIcon inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    width: 42px;
    height: 42px;
    border-width: 1px;
    border-color: root.active ? FN.ink : FN.line;
    background: FN.surface-2;
    opacity: root.enabled ? 1 : 0.55;
    SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.glyph; font-family: Emoji.symbol != "" ? Emoji.symbol : FN.sans; font-size: 17.6px; font-weight: 900; color: root.active ? FN.ink : FN.ink-3; }
    TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
}

// `.ghost-button.small-button`: the Courier uppercase button, 40 px
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    width: t.preferred-width + 30px;
    height: 40px;
    border-width: 1px;
    border-color: FN.line;
    background: touch.has-hover && root.enabled ? FN.paper-2 : FN.surface-2;
    opacity: root.enabled ? 1 : 0.5;
    t := MonoText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.text; font-size: 11px; letter-spacing: 0.66px; color: FN.ink-3; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
}

// `.feed-image-picker` / `.feed-poll-add-option`: the soft pill button
component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> h: 42px;
    in property <length> font: 12.48px;
    callback clicked();
    width: t.preferred-width + 28px;
    height: root.h;
    border-radius: root.h / 2;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? FN.ink : FN.line.with-alpha(0.7);
    background: FN.surface-2.with-alpha(0.82);
    opacity: root.enabled ? 1 : 0.55;
    t := SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.text; font-size: root.font; font-weight: 900; color: touch.has-hover && root.enabled ? FN.ink : FN.ink-3; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
}

// `.ios-switch` (the poll's "Multiple answers")
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled();
    width: 46px;
    height: 26px;
    border-width: 1px;
    border-color: FN.ink;
    border-radius: 2px;
    background: root.on ? FN.ink : FN.surface-2;
    Rectangle {
        x: root.on ? parent.width - 22px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.on ? FN.surface : #ffffff;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
}

// ------------------------------------------------------------------------------- the card

// `.feed-poll-vote`
component PollVote inherits Rectangle {
    in property <SPollOption> o;
    in property <bool> multiple;
    callback vote();
    height: 42px;
    border-width: 1px;
    border-color: root.o.selected ? FN.ink : FN.line;
    background: FN.surface;
    Rectangle { x: 1px; y: 1px; width: (parent.width - 2px) * root.o.fill; height: parent.height - 2px; background: FN.green.with-alpha(0.18); }
    SansText { x: 12px; y: (parent.height - self.preferred-height) / 2; text: root.o.selected ? "✓" : root.multiple ? "□" : "○"; font-family: Emoji.symbol != "" ? Emoji.symbol : FN.sans; font-size: 16px; font-weight: 900; color: root.o.selected ? FN.ink : FN.ink-3; }
    cnt := SansText { x: parent.width - 12px - self.preferred-width; y: (parent.height - self.preferred-height) / 2; text: root.o.count; font-size: 12.16px; font-weight: 900; color: root.o.selected ? FN.ink : FN.ink-3; }
    SansText { x: 30.7px; y: (parent.height - self.preferred-height) / 2; width: cnt.x - 8px - self.x; text: root.o.text; font-size: 16px; font-weight: 800; color: root.o.selected ? FN.ink : FN.ink-3; overflow: elide; }
    TouchArea { mouse-cursor: pointer; clicked => { root.vote(); } }
    accessible-role: button;
    accessible-label: root.o.text + ", " + root.o.count;
    accessible-checked: root.o.selected;
}

// `.reaction-btn` with its hover tooltip (who reacted)
component ReactionButton inherits Rectangle {
    in property <SReaction> r;
    callback clicked();
    width: t.preferred-width + 26px;
    height: 30px;
    border-width: 1px;
    border-color: root.r.active || touch.has-hover ? FN.ink : FN.line;
    background: FN.surface;
    t := SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.r.label; font-size: 12.8px; font-weight: 800; color: root.r.active || touch.has-hover ? FN.ink : FN.ink-3; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if touch.has-hover && root.r.tooltip != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: -8px - self.height;
        width: tip.preferred-width + 22px;
        height: tip.preferred-height + 14px;
        border-radius: 8px;
        border-width: 1px;
        border-color: FN.line;
        background: FN.surface-2.mix(FN.surface, 0.5);
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #0000001f;
        tip := SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.r.tooltip; font-size: 11.2px; color: FN.ink; }
    }
    accessible-role: button;
    accessible-label: root.r.label + (root.r.tooltip != "" ? ", " + root.r.tooltip : "");
    accessible-checked: root.r.active;
}

// `.feed-comment`
component CommentRow inherits Rectangle {
    in property <SComment> c;
    callback open-person(string);
    height: max(48px, top.preferred-height + 3px + body.preferred-height) + 21px;
    FnAvatar { x: 10px; y: 10px; a: root.c.avatar; size: 48px; font: 16px; }
    top := Rectangle {
        x: 68px;
        y: 10px;
        width: parent.width - 78px;
        height: nm.preferred-height;
        nm := SansText { x: 0px; text: root.c.name; font-size: 16px; font-weight: 900; color: FN.link; TouchArea { mouse-cursor: pointer; clicked => { root.open-person(root.c.person); } } }
        SansText { x: nm.preferred-width + 8px; y: (nm.preferred-height - self.preferred-height) / 2 + 1px; text: root.c.time; font-size: 12px; color: FN.ink-3; }
    }
    body := SansText { x: 68px; y: 10px + top.height + 3px; width: parent.width - 78px; text: root.c.body; font-size: 16px; color: FN.ink-3; wrap: word-wrap; }
    DotLine { y: parent.height - 1px; width: parent.width; }
}

component FeedCard inherits Rectangle {
    in property <SFeedPost> p;
    in property <SFeedView> f;
    callback open-person(string);
    private property <length> inner-w: root.width - 36px;
    private property <length> image-side: root.inner-w / 2;
    height: col.preferred-height + 21px;
    background: FN.surface;
    col := VerticalLayout {
        x: 0px;
        y: 10px;
        width: parent.width;
        // the head (16 px down from the card's padding)
        Rectangle {
            height: 74px - 10px;
            FnAvatar { x: 18px; y: 16px; a: root.p.avatar; size: 48px; font: 12px; }
            nm := SansText { x: 78px; y: 23px; width: min(self.preferred-width, parent.width - 78px - 60px); text: root.p.name; font-size: 16px; font-weight: 900; color: FN.link; overflow: elide; TouchArea { mouse-cursor: pointer; clicked => { root.open-person(root.p.person); } } accessible-role: button; accessible-label: root.p.name; }
            SansText { x: 78px; y: 23px + nm.preferred-height + 2px; text: root.p.time; font-size: 12px; color: FN.ink-3; }
            if root.p.is-self: Rectangle {
                x: parent.width - 18px - 30px;
                y: 26px;
                width: 30px;
                height: 30px;
                border-radius: 15px;
                border-width: 1px;
                border-color: FN.line;
                background: #ffffff0f;
                SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "✎"; font-family: Emoji.symbol != "" ? Emoji.symbol : FN.sans; font-size: 11.52px; font-weight: 800; color: FN.ink-3; }
                TouchArea { mouse-cursor: pointer; clicked => { SocialActions.feed-edit(root.p.id); } }
                accessible-role: button;
                accessible-label: "Edit post";
            }
        }
        // the body
        VerticalLayout {
            padding-top: 10px;
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 14px;
            spacing: 10px;
            // `.feed-card__session`
            Rectangle {
                height: 62px;
                border-width: 1px;
                border-color: FN.line-soft;
                background: FN.surface-2;
                SansText { x: 13px; y: 13px; width: 36px; height: 36px; horizontal-alignment: center; vertical-alignment: center; text: root.p.icon; font-family: Emoji.symbol != "" ? Emoji.symbol : FN.sans; font-size: 16px; color: FN.ink; }
                SansText { x: 60px; y: 14px; width: parent.width - 72px; text: root.p.subject; font-size: 16px; font-weight: 700; color: FN.ink; overflow: elide; }
                SansText { x: 60px; y: 34px; width: parent.width - 72px; text: root.p.detail; font-size: 12px; color: FN.ink-3; overflow: elide; }
            }
            if !root.p.editing && root.p.note != "": WrapText { text: "\"" + root.p.note + "\""; font-size: 16px; ink: FN.ink-3; }
            // `.feed-edit-panel`
            if root.p.editing: Rectangle {
                height: ed.preferred-height + 2px;
                border-width: 1px;
                border-color: FN.line-soft;
                background: FN.surface-2;
                ed := VerticalLayout {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    spacing: 8px;
                    Rectangle {
                        height: 82px;
                        border-width: 1px;
                        border-color: note.has-focus ? FN.ink-3 : FN.line;
                        border-radius: 2px;
                        background: FN.surface;
                        note := TextInput {
                            x: 14px;
                            y: 12px;
                            width: parent.width - 28px;
                            height: parent.height - 24px;
                            text: root.f.edit-note;
                            wrap: word-wrap;
                            single-line: false;
                            font-family: FN.sans;
                            font-size: 16px;
                            color: FN.ink;
                            edited => { SocialActions.feed-edit-note(self.text); }
                            accessible-role: text-input;
                            accessible-label: "Post note";
                            init => { self.focus(); }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        PillButton { text: root.p.edit-image-label; enabled: !root.f.edit-saving && !root.f.uploads-paused && !root.p.pending; clicked => { SocialActions.feed-edit-pick-image(); } }
                        if root.p.edit-can-remove && !root.f.edit-remove-hint: GhostButton { y: 1px; text: "REMOVE IMAGE"; enabled: !root.f.edit-saving; clicked => { SocialActions.feed-edit-remove-image(); } }
                    }
                    if root.p.pending: SansText { text: "Sync this post before adding an image."; font-size: 12.48px; font-italic: true; color: FN.ink-3; }
                    if root.f.edit-has-preview: Rectangle {
                        height: 138px;
                        border-width: 1px;
                        border-color: FN.line;
                        background: FN.surface-2.with-alpha(0.7);
                        Image { x: 9px; y: 9px; width: 120px; height: 120px; source: root.f.edit-preview; image-fit: cover; accessible-role: image; accessible-label: "Replacement feed post preview"; }
                        GhostButton { x: 139px; y: (parent.height - self.height) / 2; text: "CLEAR REPLACEMENT"; clicked => { SocialActions.feed-edit-clear-image(); } }
                    }
                    if root.f.edit-remove-hint && !root.f.edit-has-preview: SansText { text: "Image will be removed when you save."; font-size: 12.48px; font-italic: true; color: FN.ink-3; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        height: 40px;
                        SendButton { y: 2px; text: "Save"; enabled: !root.f.edit-saving; clicked => { SocialActions.feed-edit-save(); } }
                        GhostButton { text: "CANCEL"; enabled: !root.f.edit-saving; clicked => { SocialActions.feed-edit-cancel(); } }
                        PaperButton { y: 5px; text: "DELETE"; enabled: !root.f.edit-saving; clicked => { SocialActions.feed-delete(root.p.id); } }
                    }
                }
            }
            // `.feed-poll-card`
            if root.p.has-poll: Rectangle {
                height: poll.preferred-height + 26px;
                border-width: 1px;
                border-color: FN.line-soft;
                background: FN.surface-2;
                poll := VerticalLayout {
                    x: 13px;
                    y: 13px;
                    width: parent.width - 26px;
                    spacing: 10px;
                    Rectangle {
                        height: 41px;
                        SansText { x: 0px; y: 0px; width: parent.width; text: root.p.poll-question; font-size: 16px; font-weight: 700; color: FN.ink; overflow: elide; }
                        SansText { x: 0px; y: 20px; text: root.p.poll-multiple ? "Multiple answers" : "One answer"; font-size: 12px; font-weight: 800; color: FN.ink-3; }
                        Rectangle { y: parent.height - 1px; height: 1px; background: FN.ink; }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        for o in root.p.poll-options: PollVote { o: o; multiple: root.p.poll-multiple; vote => { SocialActions.feed-vote(root.p.id, o.id); } }
                    }
                    SansText { text: root.p.poll-total; font-size: 12px; font-weight: 800; color: FN.ink-3; }
                }
            }
            // `.feed-card__image` (contain inside a square half the body wide)
            if root.p.image-state == 1 || root.p.image-state == 2: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.image-side;
                    height: root.image-side;
                    border-width: 1px;
                    border-color: img-touch.has-hover ? FN.ink : FN.line;
                    background: FN.surface-2.with-alpha(0.8);
                    clip: true;
                    if root.p.image-state == 2: Image {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        source: root.p.image;
                        image-fit: contain;
                        accessible-role: image;
                        accessible-label: root.p.name + "'s feed post image";
                    }
                    img-touch := TouchArea { mouse-cursor: pointer; clicked => { SocialActions.feed-open-image(root.p.id); } }
                    accessible-role: button;
                    accessible-label: "Open feed image fullscreen";
                }
            }
            if root.p.image-state == 3 || root.p.image-state == 4: SansText { text: root.p.image-state == 3 ? "Image could not load" : "Image expired"; font-size: 12.48px; font-italic: true; color: FN.ink-3; }
        }
        // `.feed-card__reactions`
        reactions := Rectangle {
            height: 1px + 10px + rx.preferred-height + 14px;
            DotLine { y: 0px; width: parent.width; }
            rx := HorizontalLayout {
                x: 18px;
                y: 11px;
                spacing: 6px;
                alignment: start;
                for r in root.p.reactions: ReactionButton { r: r; clicked => { SocialActions.feed-react(root.p.id, r.key); } }
                plus := Rectangle {
                    width: 31.3px;
                    height: 30px;
                    border-width: 1px;
                    border-color: plus-touch.has-hover || root.p.picker ? FN.ink : FN.line;
                    background: FN.surface;
                    SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "+"; font-size: 16px; color: FN.ink-3; }
                    plus-touch := TouchArea { mouse-cursor: pointer; clicked => { SocialActions.feed-toggle-picker(root.p.id); } }
                    accessible-role: button;
                    accessible-label: "Add reaction";
                }
            }
        }
        // `.feed-card__comments-shell`
        Rectangle {
            height: 1px + 10px + cm.preferred-height + 16px;
            DotLine { y: 0px; width: parent.width; }
            cm := VerticalLayout {
                x: 18px;
                y: 11px;
                width: parent.width - 36px;
                spacing: 12px;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: tg.preferred-width + 26px;
                        height: 30px;
                        border-width: 1px;
                        border-color: root.p.comments-open || tg-touch.has-hover ? FN.ink : FN.line;
                        background: FN.surface;
                        tg := SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "Comments (" + root.p.comment-count + ") " + (root.p.comments-open ? "↑" : "↓"); font-size: 12.48px; font-weight: 900; color: FN.link; }
                        tg-touch := TouchArea { mouse-cursor: pointer; clicked => { SocialActions.feed-toggle-comments(root.p.id); } }
                        accessible-role: button;
                        accessible-label: "Comments (" + root.p.comment-count + ")";
                        accessible-expanded: root.p.comments-open;
                    }
                }
                if root.p.comments-open: VerticalLayout {
                    spacing: 10px;
                    if root.p.comment-count == 0: SansText { text: "No comments yet. Start the reply chain."; font-size: 12.8px; font-italic: true; color: FN.ink-3; }
                    if root.p.comment-count > 0: VerticalLayout {
                        for c in root.p.comments: CommentRow { c: c; open-person(id) => { root.open-person(id); } }
                    }
                    HorizontalLayout {
                        height: 44px;
                        spacing: 8px;
                        reply := FnTextField {
                            height: 44px;
                            ruled: false;
                            placeholder: "Reply or comment under this post...";
                            initial: root.p.draft;
                            rev: root.p.draft-rev;
                            enabled: !root.p.saving-comment;
                            edited(t) => { SocialActions.feed-comment-edited(root.p.id, t); }
                            accepted => { SocialActions.feed-comment-submit(root.p.id); }
                        }
                        SendButton {
                            y: 4px;
                            text: root.p.saving-comment ? "Posting" : "Reply";
                            enabled: !root.p.saving-comment && reply.value != "";
                            clicked => { SocialActions.feed-comment-submit(root.p.id); }
                        }
                    }
                }
            }
        }
    }
    DotLine { y: parent.height - 1px; width: parent.width; }
    // the "+" emoji picker: above the reactions row, from the card's left edge
    if root.p.picker: Rectangle {
        x: 0px;
        y: reactions.y + col.y - 6px - self.height;
        width: 210px;
        height: grid.preferred-height + 18px;
        border-width: 1px;
        border-color: FN.line;
        background: FN.surface;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        grid := Rectangle {
            x: 9px;
            y: 9px;
            width: parent.width - 18px;
            private property <length> cell-w: (self.width - 5 * 3px) / 6;
            height: 6 * 32.1px + 5 * 3px;
            for e[i] in ["🔥", "🧠", "👏", "⭐", "🎯", "💪", "📚", "⚡", "🎉", "🏆", "✨", "💡", "🎓", "🚀", "💎", "🌟", "📖", "🕐", "💯", "🙌", "🤯", "😤", "👑", "🌊", "😂", "🤣", "😭", "🥲", "😅", "🥹", "❤️", "🙏", "👍", "👎", "😍", "😎"]: Rectangle {
                x: mod(i, 6) * (parent.cell-w + 3px);
                y: floor(i / 6) * (32.1px + 3px);
                width: parent.cell-w;
                height: 32.1px;
                border-width: 1px;
                border-color: FN.line;
                background: e-touch.has-hover ? FN.paper-2 : FN.surface;
                Text { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: e; font-family: Emoji.family; font-size: 18.4px; }
                e-touch := TouchArea { mouse-cursor: pointer; clicked => { SocialActions.feed-react(root.p.id, e); SocialActions.feed-toggle-picker(root.p.id); } }
                accessible-role: button;
                accessible-label: "React " + e;
            }
        }
    }
    accessible-role: groupbox;
    accessible-label: root.p.name + ", " + root.p.subject;
}

// `article.milestone`
component MilestoneCard inherits Rectangle {
    in property <SFeedPost> p;
    callback open-person(string);
    height: 75px;
    background: FN.surface;
    Rectangle {
        x: 0px;
        y: 10px;
        width: 54px;
        height: 54px;
        border-width: 1px;
        border-color: FN.line;
        background: FN.surface-2;
        Text { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.p.icon; font-family: Emoji.family; font-size: 23.2px; color: FN.ink-3; }
    }
    nm := SansText { x: 70px; y: 17px; text: root.p.name; font-size: 18.72px; font-weight: 700; color: FN.link; TouchArea { mouse-cursor: pointer; clicked => { root.open-person(root.p.person); } } }
    SansText { x: 70px + nm.preferred-width + 5px; y: 17px; text: "hit a milestone"; font-size: 18.72px; font-weight: 700; color: FN.ink; }
    SansText { x: 70px; y: 39px; width: parent.width - 70px; text: root.p.note; font-size: 16px; color: FN.ink-3; overflow: elide; }
    DotLine { y: parent.height - 1px; width: parent.width; }
    accessible-role: groupbox;
    accessible-label: root.p.name + " hit a milestone";
}

// `.section-label`
component SectionLabel inherits Rectangle {
    in property <string> text;
    height: 20px;
    MonoText { x: 4px; y: 0px; text: root.text; font-size: 10px; letter-spacing: 1.8px; color: FN.ink-4; }
    Rectangle { x: 4px; y: parent.height - 1px; width: parent.width - 4px; height: 1px; background: FN.ink; }
}

// ------------------------------------------------------------------------------- composer

component Composer inherits Rectangle {
    in property <SFeedView> f;
    private property <bool> can-post: root.f.has-session && !root.f.posted;
    height: col.preferred-height + 23px;
    col := VerticalLayout {
        spacing: 12px;
        Rectangle {
            height: 65.3px;
            Kicker { x: 0px; y: 4px; width: self.preferred-width; text: "POST YOUR LAST BLOCK"; }
            SerifText { y: 22px; width: parent.width; text: root.f.has-session ? root.f.session-title : "No session ready"; font-size: 22px; font-weight: 600; color: FN.ink; overflow: elide; }
            SansText { y: 47.8px; width: parent.width; text: root.f.has-session ? "One line for the circle, or leave it blank." : "Finish a study or exam block, then publish it here."; font-size: 13px; color: FN.ink-4; }
        }
        note := FnTextField {
            placeholder: "one line, or leave it blank...";
            enabled: root.can-post;
            initial: "";
            rev: root.f.poll-rev;
            edited(t) => { SocialActions.feed-note-edited(t); }
            accepted => { SocialActions.feed-post(); }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            height: 42px;
            ActionIcon { glyph: "▧"; label: root.f.image-draft ? "Change image" : "Add image"; enabled: root.can-post && !root.f.uploads-paused && !root.f.preparing-image; clicked => { SocialActions.feed-pick-image(); } }
            ActionIcon { glyph: "◉"; label: "Create poll"; active: root.f.poll-has-draft; enabled: root.can-post; clicked => { SocialActions.feed-toggle-poll(); } }
        }
        HorizontalLayout {
            alignment: start;
            SendButton { text: root.f.posted ? "Posted" : "Post"; enabled: root.can-post; clicked => { SocialActions.feed-post(); } }
        }
        // `.feed-poll-popover`
        if root.f.poll-open: Rectangle {
            height: pp.preferred-height + 28px;
            border-radius: 20px;
            background: FN.surface.mix(#000000, 0.94);
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000047;
            pp := VerticalLayout {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                spacing: 10px;
                Rectangle {
                    height: 26px;
                    SansText { x: 0px; y: (parent.height - self.preferred-height) / 2; text: "Create poll"; font-size: 16px; font-weight: 700; color: FN.ink; }
                    sw := Switch { x: parent.width - self.width; label: "Multiple answers"; on: root.f.poll-multiple; toggled => { SocialActions.feed-poll-multiple(!root.f.poll-multiple); } }
                    SansText { x: sw.x - 8px - self.preferred-width; y: (parent.height - self.preferred-height) / 2; text: "Multiple answers"; font-size: 12.48px; font-weight: 900; color: FN.ink-3; }
                }
                FnTextField { placeholder: "Question"; initial: root.f.poll-question; rev: root.f.poll-rev; edited(t) => { SocialActions.feed-poll-question(t); } }
                VerticalLayout {
                    spacing: 8px;
                    for o[i] in root.f.poll-options: HorizontalLayout {
                        spacing: 8px;
                        FnTextField { placeholder: "Option " + (i + 1); initial: o; rev: root.f.poll-rev; edited(t) => { SocialActions.feed-poll-option(i, t); } }
                        if root.f.poll-options.length > 2: PillButton { y: 10px; h: 34px; width: 34px; font: 16px; text: "×"; clicked => { SocialActions.feed-poll-remove(i); } accessible-label: "Remove option " + (i + 1); }
                        if root.f.poll-options.length <= 2: Rectangle { width: 0px; }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    PillButton { h: 36px; font: 16px; text: "+ Add option"; enabled: root.f.poll-options.length < 12; clicked => { SocialActions.feed-poll-add(); } }
                }
                Rectangle {
                    height: 40px;
                    SendButton { x: 0px; y: 2px; text: "Done"; clicked => { SocialActions.feed-toggle-poll(); } }
                    GhostButton { x: parent.width - self.width; text: "CLEAR"; clicked => { SocialActions.feed-poll-clear(); } }
                }
            }
        }
        // `.feed-image-draft`
        if root.f.image-draft: Rectangle {
            height: 114px;
            border-width: 1px;
            border-color: FN.line;
            background: FN.surface-2.with-alpha(0.7);
            Image { x: 9px; y: 9px; width: 96px; height: 96px; source: root.f.image-preview; image-fit: cover; accessible-role: image; accessible-label: "Selected feed post preview"; }
            GhostButton { x: 115px; y: (parent.height - self.height) / 2; text: "REMOVE IMAGE"; clicked => { SocialActions.feed-clear-image(); } }
        }
        if root.f.preparing-image: SansText { text: "Preparing image..."; font-size: 12.48px; font-italic: true; color: FN.ink-3; }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: FN.rule-hard; }
    accessible-role: groupbox;
    accessible-label: "Post your last block";
}

global SocialBlueish {
    out property <color> c: #8fb4ff;
}

// `.arena-scope-btn`
component ScopeChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: t.preferred-width + 28px;
    height: 35px;
    border-width: 1px;
    border-color: root.active ? FN.ink : FN.line;
    background: root.active ? FN.surface : transparent;
    t := SansText { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.text; font-size: 13.44px; font-weight: 900; color: root.active ? FN.ink : FN.ink-3; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.active;
}

// ------------------------------------------------------------------------------- the panel

export component FnFeedPanel inherits Rectangle {
    in property <SFeedView> f;
    // 1180 px and wider: two columns; narrower: the sidebar under the log (production's media rule)
    in property <bool> stacked;
    callback open-person(string);
    callback refresh();
    private property <length> side-w: root.stacked ? root.width : clamp(400px, 360px, 440px);
    private property <length> main-w: root.stacked ? root.width : root.width - 30px - root.side-w;
    height: root.stacked ? side.preferred-height + 30px + main.preferred-height + 22px : max(side.preferred-height, main.preferred-height + 22px);

    main := VerticalLayout {
        x: 0px;
        y: root.stacked ? side.preferred-height + 30px + 22px : 22px;
        width: root.main-w;
        spacing: 0px;
        SectionLabel { text: "CIRCLE LOG" + (root.f.loading ? " · REFRESHING" : ""); }
        Rectangle { height: 10px; }
        if root.f.posts.length == 0: EmptyCard { strong: "No feed posts yet"; text: "Post a session or sync to pull the latest arena activity."; }
        VerticalLayout {
            spacing: 14px;
            for p in root.f.posts: VerticalLayout {
                if p.kind == 1: MilestoneCard { p: p; open-person(id) => { root.open-person(id); } }
                if p.kind == 0: FeedCard { p: p; f: root.f; open-person(id) => { root.open-person(id); } }
            }
        }
        Rectangle { height: 22px; }
        SectionLabel { text: "THIS WEEK"; }
        Rectangle { height: 10px; }
        // `article.week-compare`
        Rectangle {
            height: wk.preferred-height + 34px;
            border-width: 1px;
            border-color: FN.line;
            background: FN.surface;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: #0000002e;
            wk := VerticalLayout {
                x: 17px;
                y: 17px;
                width: parent.width - 34px;
                spacing: 0px;
                if root.f.week.length == 0: Rectangle {
                    height: 52px;
                    border-width: 1px;
                    border-color: FN.line-soft;
                    background: #ffffff09;
                    MonoText { x: 12px; width: parent.width - 24px; height: parent.height; vertical-alignment: center; wrap: word-wrap; text: "WEEKLY COMPARISON APPEARS AFTER YOU SYNC WITH FRIENDS."; font-size: 11px; letter-spacing: 1.98px; color: FN.ink-4; }
                }
                for w in root.f.week: Rectangle {
                    height: 50px;
                    FnAvatar { x: 0px; y: 9px; a: w.avatar; size: 32px; font: 11px; }
                    SansText { x: 44px; y: (parent.height - self.preferred-height) / 2; width: 150px; text: w.name; font-size: 14px; font-weight: 700; color: FN.ink; overflow: elide; }
                    Rectangle {
                        x: 204px;
                        y: (parent.height - 7px) / 2;
                        width: parent.width - 204px - 80px;
                        height: 7px;
                        background: FN.surface-2;
                        Rectangle { x: 0px; width: parent.width * w.bar; background: w.is-self ? SocialBlueish.c : FN.green; }
                    }
                    MonoText { x: parent.width - self.preferred-width; y: (parent.height - self.preferred-height) / 2; text: w.minutes; font-size: 12px; color: FN.ink-3; }
                    DotLine { y: parent.height - 1px; width: parent.width; }
                }
            }
        }
    }

    side := VerticalLayout {
        x: root.stacked ? 0px : root.main-w + 30px;
        y: 0px;
        width: root.side-w;
        spacing: 0px;
        // `.social-feed-scope`
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            height: 35px;
            ScopeChip { text: "Friends log"; active: root.f.scope == 0; clicked => { SocialActions.feed-scope(0); } }
            ScopeChip { text: "Global log"; active: root.f.scope == 1; clicked => { SocialActions.feed-scope(1); } }
            PaperButton { y: 0px; height: 35px; text: root.f.syncing ? "SYNCING..." : "REFRESH"; enabled: !root.f.syncing; clicked => { root.refresh(); } }
        }
        Rectangle { height: 22px; }
        // `.live-bar`
        Rectangle {
            height: 68.8px;
            border-width: 1px;
            border-color: FN.line;
            background: FN.surface-2;
            Rectangle { x: 17px; y: 18.4px; width: 8px; height: 8px; background: FN.green; }
            lc := SerifText { x: 37px; y: 14px; text: root.f.live-count > 0 ? root.f.live-count + " friends" : "No friends"; font-size: 16px; font-weight: 700; color: FN.green; }
            SerifText { x: 109px; y: 14.4px; text: "recently active"; font-size: 14px; color: FN.ink; }
            MonoText { x: 109px; y: 40.8px; width: parent.width - 109px - 17px; text: root.f.live-names != "" ? root.f.live-names : "Sync to update live status"; font-size: 11px; color: FN.ink-4; overflow: elide; }
        }
        // the owner's R2 safety banner
        if root.f.r2-banner: VerticalLayout {
            padding-top: 10px;
            Rectangle {
                height: r2.preferred-height + 24px;
                border-width: 1px;
                border-color: root.f.r2-paused ? FN.critical : FN.line;
                background: FN.surface-2;
                r2 := VerticalLayout {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    spacing: 4px;
                    SansText { text: root.f.r2-paused ? "Image uploads paused" : "Image usage close to safety limit"; font-size: 14px; font-weight: 900; color: FN.ink; }
                    WrapText { text: root.f.r2-text; font-size: 12.48px; ink: FN.ink-3; }
                    WrapText { text: "These strict app limits are far below Cloudflare R2's free tier to avoid overage risk."; font-size: 11.52px; ink: FN.ink-4; }
                }
            }
        }
        Rectangle { height: 10px; }
        Composer { f: root.f; }
    }
}

