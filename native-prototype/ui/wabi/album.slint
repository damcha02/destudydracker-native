// The achievements album (`InkGallery` variant "book", Stage 20): a cloth-bound album closed on a
// lamplit desk beside an ink dish and a brush; click (or Enter/Space) opens it, the outer edges /
// arrow keys turn pages, turning past either end or Escape closes it.
//
// * Geometry: production's `computeBookGeometry(w, h)` evaluated here on the scene size, so the
//   book, dish and brush sit where production puts them at any window size.
// * Static decor (desk, dish, brush, cover cloth with its binding, closed-book edges, boards, page
//   paper) are images derived from production's own CSS by scripts/stage20-album-assets.mjs;
//   everything that carries content (the title slip, dates, art, names, page numbers, the page
//   stack, shadows) is drawn here.
// * Motion: production turns the cover and each leaf through a half circle about the spine in 3D
//   (780 ms open/close, 520 ms per page, cubic-bezier(.36,.02,.24,1)) with the two faces cross-
//   fading at the edge-on midpoint, while the book slides from centred-closed to open. Native
//   plays the same hinge rotation as its orthographic projection (a cos(angle) horizontal scale
//   about the spine, faces swapped at the midpoint) and the same slide; only the perspective
//   foreshortening is missing. Each motion is a bounded Slint animation: nothing renders between
//   turns.
import { WS } from "palette.slint";

export struct AlbumRow {
    day: string,
    art: image,
    jp: string,
    en: string,
    how: string,
}

export struct AlbumPageData {
    present: bool,
    rows: [AlbumRow],
    number: string,
    left: bool,
    empty: bool,
}

export struct AlbumData {
    dark: bool,
    // static layout of the spread (production's showLeft / showRight / showClosed / showCover)
    open: bool,
    show-left: bool,
    show-right: bool,
    show-closed: bool,
    show-cover: bool,
    // the book slid open (true) or centred closed (false); animated
    slide-open: bool,
    // 0 none, 1 open, 2 close, 3 next, 4 prev
    anim: int,
    // bumped once per cover / leaf animation; the visible phase is the animated value's fraction
    cover-seq: int,
    leaf-seq: int,
    left-page: AlbumPageData,
    right-page: AlbumPageData,
    leaf-front: AlbumPageData,
    leaf-back: AlbumPageData,
    first-page: AlbumPageData,
    // page-stack layers peeking out under each page (`pageStackShadow`)
    left-layers: int,
    right-layers: int,
    at-first: bool,
    at-last: bool,
}

// One album page's content over its paper, in the page's own em (`fontSize = PH / 19`).
component PageView inherits Rectangle {
    in property <AlbumPageData> page;
    in property <bool> dark;
    in property <length> em;
    clip: true;
    if root.page.present: Image {
        width: parent.width;
        height: parent.height;
        image-fit: fill;
        source: root.page.left
            ? (root.dark ? @image-url("../../assets/break/album/dark/page-left.jpg") : @image-url("../../assets/break/album/light/page-left.jpg"))
            : (root.dark ? @image-url("../../assets/break/album/dark/page-right.jpg") : @image-url("../../assets/break/album/light/page-right.jpg"));
    }
    if root.page.present && root.page.empty: VerticalLayout {
        x: 1.6 * root.em;
        width: parent.width - 3.2 * root.em;
        height: parent.height - 2.6 * root.em;
        alignment: center;
        spacing: 0.5 * root.em;
        Text { horizontal-alignment: center; text: "The album is empty."; font-family: WS.serif; font-size: root.em; font-weight: 500; color: #2b261e; }
        Text { horizontal-alignment: center; wrap: word-wrap; text: "Achievements are mounted here as you earn them."; font-family: WS.sans; font-size: 0.72 * root.em; color: #5a5041; }
    }
    if root.page.present && !root.page.empty: Rectangle {
        // `.wabi-album-rows`: three equal rows, gap 0.4em
        x: 1.4 * root.em;
        y: 1.15 * root.em;
        width: parent.width - 2.8 * root.em;
        height: parent.height - 1.15 * root.em - 2.05 * root.em;
        private property <length> row-h: (self.height - 0.8 * root.em) / 3;
        for row[i] in root.page.rows: Rectangle {
            y: i * (parent.row-h + 0.4 * root.em);
            height: parent.row-h;
            clip: true;
            private property <length> day-h: row.day != "" ? 0.56 * root.em * 1.15 + 0.28 * root.em : 0px;
            if row.day != "": Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                overflow: elide;
                text: row.day;
                font-family: WS.sans;
                font-size: 0.56 * root.em;
                font-weight: 500;
                letter-spacing: 0.14 * 0.56 * root.em;
                color: #6e6352;
            }
            // the mounted picture with its four photo corners
            Rectangle {
                x: 0px;
                y: parent.day-h;
                width: 2.9 * root.em;
                height: 2.9 * root.em;
                background: #5f462312;
                drop-shadow-offset-y: 0.06 * root.em;
                drop-shadow-blur: 0.12 * root.em;
                drop-shadow-color: #3c280f2e;
                Image {
                    x: 0.28 * root.em;
                    y: 0.28 * root.em;
                    width: parent.width - 0.56 * root.em;
                    height: parent.height - 0.56 * root.em;
                    image-fit: contain;
                    source: row.art;
                }
                for c in [{ x: -0.14, y: -0.14, p: "M 0 0 L 1 0 L 0 1 Z" }, { x: 2.24, y: -0.14, p: "M 0 0 L 1 0 L 1 1 Z" },
                          { x: -0.14, y: 2.24, p: "M 0 0 L 1 1 L 0 1 Z" }, { x: 2.24, y: 2.24, p: "M 1 0 L 1 1 L 0 1 Z" }]: Path {
                    x: c.x * root.em;
                    y: c.y * root.em;
                    width: 0.8 * root.em;
                    height: 0.8 * root.em;
                    viewbox-width: 1;
                    viewbox-height: 1;
                    commands: c.p;
                    fill: #3a332a;
                }
            }
            // names (Japanese, then the small italic English gloss on its baseline) and the how
            copy := Rectangle {
                x: 2.9 * root.em + 0.85 * root.em;
                y: parent.day-h + 0.05 * root.em;
                width: parent.width - self.x;
                height: parent.height - self.y;
                private property <length> name-h: 1.14 * (row.jp != "" ? 1.02 : 0.92) * root.em;
                if row.jp != "": jp := Text {
                    x: 0px;
                    y: 0px;
                    text: row.jp;
                    font-family: WS.serif;
                    font-size: 1.02 * root.em;
                    font-weight: 600;
                    letter-spacing: 0.04 * 1.02 * root.em;
                    color: #2b261e;
                }
                Text {
                    x: row.jp != "" ? jp-width.preferred-width + 0.45 * root.em : 0px;
                    y: row.jp != "" ? (1.02 - 0.72) * root.em * 0.8 : 0px;
                    text: row.en;
                    font-family: WS.serif;
                    font-size: row.jp != "" ? 0.72 * root.em : 0.92 * root.em;
                    font-weight: row.jp != "" ? 500 : 600;
                    font-italic: row.jp != "";
                    letter-spacing: row.jp != "" ? 0px : 0.02 * 0.92 * root.em;
                    color: row.jp != "" ? #5a5041 : #2b261e;
                }
                jp-width := Text { visible: false; text: row.jp; font-family: WS.serif; font-size: 1.02 * root.em; font-weight: 600; letter-spacing: 0.04 * 1.02 * root.em; }
                Text {
                    x: 0px;
                    y: copy.name-h + 0.14 * root.em;
                    width: parent.width;
                    height: min(parent.height - self.y, 3 * 1.35 * 0.6 * root.em);
                    wrap: word-wrap;
                    overflow: elide;
                    text: row.how;
                    font-family: WS.sans;
                    font-size: 0.6 * root.em;
                    color: #5a5041;
                }
            }
        }
    }
    if root.page.present: Text {
        x: 0px;
        y: parent.height - 1.05 * root.em - 0.64 * root.em;
        width: parent.width;
        horizontal-alignment: center;
        text: root.page.number;
        font-family: WS.serif;
        font-size: 0.64 * root.em;
        color: #6e6352;
    }
}

// `pageStackShadow`: up to six hard-edged paper slivers peeking out under a page, then a soft one.
component PageStack inherits Rectangle {
    in property <int> layers;
    in property <int> dir;
    in property <length> em;
    in property <length> max-offset;
    in property <bool> dark;
    private property <length> k: root.em / 10;
    private property <color> edge: root.dark ? #d2c6aa : #e9dfc7;
    private property <color> edge-deep: root.dark ? #b9ab8b : #d6c9aa;
    Rectangle {
        x: clamp(root.dir * (root.layers + 1) * 0.7 * root.k, -root.max-offset, root.max-offset);
        y: clamp((root.layers + 1.5) * 0.8 * root.k, -root.max-offset, root.max-offset);
        width: parent.width;
        height: parent.height;
        background: #23140559;
        drop-shadow-blur: 1.5 * root.k;
        drop-shadow-color: #23140559;
    }
    for j in root.layers: Rectangle {
        // drawn deepest first so the nearest sliver ends on top
        private property <int> i: root.layers - j;
        x: clamp(root.dir * self.i * 0.7 * root.k, -root.max-offset, root.max-offset);
        y: clamp(self.i * 0.8 * root.k, -root.max-offset, root.max-offset);
        width: parent.width;
        height: parent.height;
        background: mod(self.i, 2) == 1 ? root.edge-deep : root.edge;
    }
}

// The cover's front: the captured cloth/binding plus the title slip drawn natively.
component CoverFront inherits Rectangle {
    in property <bool> dark;
    in property <length> em;
    in property <length> bw;
    in property <length> bh;
    border-radius: 2px;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        image-fit: fill;
        source: root.dark ? @image-url("../../assets/break/album/dark/cover.jpg") : @image-url("../../assets/break/album/light/cover.jpg");
    }
    // `.wabi-book-slip`
    Rectangle {
        x: root.bw * 0.2;
        y: root.bh * 0.08;
        width: root.bw * 0.15;
        height: root.bh * 0.42;
        background: root.dark ? #d8cdb3 : #eee5cf;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000059;
        Rectangle { border-width: 1px; border-color: #503a1c40; }
        Rectangle {
            x: 0.22 * root.em;
            y: 0.22 * root.em;
            width: parent.width - 0.44 * root.em;
            height: parent.height - 0.44 * root.em;
            border-width: 1px;
            border-color: #503a1c59;
        }
        // `writing-mode: vertical-rl`: one glyph per line, 0.25em apart
        VerticalLayout {
            y: 0.7 * root.em;
            alignment: start;
            spacing: 0.25 * 1.15 * root.em;
            for g in ["記", "念", "帖"]: Text {
                // `font: 500 1.15em/1`: one em per line
                height: 1.15 * root.em;
                vertical-alignment: center;
                horizontal-alignment: center;
                text: g;
                font-family: WS.serif;
                font-size: 1.15 * root.em;
                font-weight: 500;
                color: #2b261e;
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 0.55 * root.em - self.height;
            // 1.05em of its own 0.66em font
            width: 1.05 * 0.66 * root.em;
            height: self.width;
            border-radius: 1px;
            background: @radial-gradient(circle, #c06a58 0%, #a8412c 40%);
            opacity: 0.9;
            Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: "記";
                font-family: WS.serif;
                font-size: 0.66 * root.em;
                font-weight: 600;
                color: #f1e3cf;
            }
        }
    }
}

export component WabiAlbum inherits Rectangle {
    in property <AlbumData> d;
    // the animated motion inputs, as their own properties: `d` can be replaced while a motion
    // plays (any push), and a binding on it would restart the motion each time
    in property <int> cover-seq;
    in property <int> leaf-seq;
    in property <bool> slide-open;
    callback open();
    callback turn(int);
    callback close();

    // ---- production's computeBookGeometry(w, h) on the scene's client box
    private property <length> w: root.width - 2px;
    private property <length> h: root.height - 2px;
    private property <length> pad-x: max(14px, root.w * 0.05);
    private property <length> pad-y: max(12px, root.h * 0.08);
    private property <float> ratio: 0.78;
    private property <length> cup-d: min(root.h * 0.3, root.w * 0.15);
    private property <length> avail-w: root.w - (root.cup-d + root.pad-x * 0.7);
    private property <length> bh: max(110px, min(root.h - 2 * root.pad-y, (root.avail-w - 2 * root.pad-x) / (2 * root.ratio)));
    private property <length> bw: root.bh * root.ratio;
    private property <length> stage-left: root.pad-x + max(0px, (root.avail-w - 2 * root.pad-x - 2 * root.bw) / 2);
    private property <length> stage-top: (root.h - root.bh) / 2 - root.bh * root.ratio * 0.023;
    private property <length> pot-x: root.w - root.pad-x * 0.7 - root.cup-d / 2;
    private property <length> pot-y: root.pad-y + root.cup-d * 0.55;
    private property <length> pen-w: max(7px, root.cup-d * 0.11);
    private property <length> pen-top: root.pot-y + root.cup-d * 0.62;
    private property <length> pen-h: root.h - root.pad-y * 0.7 - root.pen-top;
    private property <length> margin: root.bw * 0.04;
    private property <length> pw: root.bw - 2 * root.margin;
    private property <length> ph: root.bh - 2 * root.margin;
    private property <length> em: root.ph / 19;
    private property <length> e: root.bw * 0.065;
    private property <length> bevel: root.bw * 0.016;
    private property <length> closed-x: -(root.bw + root.e + root.bevel) / 2;
    private property <length> zone-w: max(18px, root.bw * 0.13);
    // the captured decor's reference sizes (scene 1220 x 926), see capture-report.json
    private property <float> s-book: root.bw / 436.14px;
    private property <float> s-cup: root.cup-d / 183px;

    // ---- animation phases: each bump of a *-seq animates the phase by one; the fraction is the
    // current position within that motion (1 = finished, so a static scene sits at 1).
    private property <float> cover-phase: root.cover-seq;
    animate cover-phase { duration: 780ms; easing: cubic-bezier(0.36, 0.02, 0.24, 1); }
    private property <float> leaf-phase: root.leaf-seq;
    animate leaf-phase { duration: 520ms; easing: cubic-bezier(0.36, 0.02, 0.24, 1); }
    private property <float> cover-t: clamp(root.cover-phase - (root.cover-seq - 1), 0, 1);
    private property <float> leaf-t: clamp(root.leaf-phase - (root.leaf-seq - 1), 0, 1);
    // the cover's swing: 0 = shut over the right board, 1 = laid open over the left board
    private property <float> swing: root.d.anim == 1 ? root.cover-t : root.d.anim == 2 ? 1 - root.cover-t : (root.d.open ? 1 : 0);

    border-width: 1px;
    border-color: WS.rule-soft;
    clip: true;
    forward-focus: keys;
    // production listens for the arrow keys window-wide; here the album takes focus when shown
    init => { keys.focus(); }

    Image {
        width: parent.width;
        height: parent.height;
        image-fit: fill;
        source: WS.t.dark ? @image-url("../../assets/break/album/dark/desk.jpg") : @image-url("../../assets/break/album/light/desk.jpg");
    }
    // ink dish and brush (captured with 10 px of room for their drop shadows)
    Image {
        x: 1px + root.pot-x - root.cup-d / 2 - 10px * root.s-cup;
        y: 1px + root.pot-y - root.cup-d / 2 - 10px * root.s-cup;
        width: 203px * root.s-cup;
        height: 203px * root.s-cup;
        source: WS.t.dark ? @image-url("../../assets/break/album/dark/cup.png") : @image-url("../../assets/break/album/light/cup.png");
    }
    Image {
        x: 1px + root.pot-x - root.pen-w / 2 - 10px * root.pen-w / 20.13px;
        y: 1px + root.pen-top - 10px * root.pen-h / 585.94px;
        width: root.pen-w * (40.13 / 20.13);
        height: root.pen-h * (605.94 / 585.94);
        image-fit: fill;
        source: WS.t.dark ? @image-url("../../assets/break/album/dark/pen.png") : @image-url("../../assets/break/album/light/pen.png");
    }

    stage := Rectangle {
        x: 1px + root.stage-left;
        y: 1px + root.stage-top;
        width: 2 * root.bw;
        height: root.bh;
        transform-rotation: -0.8deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };

        slide := Rectangle {
            // Always reads both motion phases (the condition is always true). Slint animates a
            // property only from a value it has already evaluated; without this read a phase that
            // only the turning branch uses would jump straight to its end.
            opacity: root.cover-phase > -1 && root.leaf-phase > -1 ? 1 : 0;
            y: 0px;
            x: root.slide-open ? 0px : root.closed-x;
            animate x { duration: 780ms; easing: cubic-bezier(0.5, 0, 0.25, 1); }
            width: parent.width;
            height: parent.height;

            // ground shadows (closed / open), cross-faded
            Rectangle {
                x: root.bw + root.e * 0.5;
                y: root.e * 0.6;
                width: root.bw + root.bevel;
                height: root.bh;
                border-radius: 3px;
                background: #190c0259;
                drop-shadow-offset-y: root.bh * 0.03;
                drop-shadow-blur: root.bh * 0.09;
                drop-shadow-color: #140a0080;
                opacity: root.slide-open ? 0 : 1;
                animate opacity { duration: 900ms; easing: ease; }
            }
            Rectangle {
                x: -2px;
                y: 1px;
                width: 2 * root.bw + 4px;
                height: root.bh;
                border-radius: 3px;
                background: #190c0259;
                drop-shadow-offset-y: root.bh * 0.03;
                drop-shadow-blur: root.bh * 0.09;
                drop-shadow-color: #140a0080;
                opacity: root.slide-open ? 1 : 0;
                animate opacity { duration: 900ms; easing: ease; }
            }

            if root.d.show-left: Rectangle {
                x: 0px;
                y: 0px;
                width: root.bw;
                height: root.bh;
                Image { width: parent.width; height: parent.height; image-fit: fill; source: WS.t.dark ? @image-url("../../assets/break/album/dark/board-left.jpg") : @image-url("../../assets/break/album/light/board-left.jpg"); }
                PageStack {
                    x: root.margin;
                    y: root.margin;
                    width: root.pw;
                    height: root.ph;
                    layers: root.d.left-layers;
                    dir: -1;
                    em: root.em;
                    max-offset: root.margin - 1px;
                    dark: WS.t.dark;
                }
                PageView { x: root.margin; y: root.margin; width: root.pw; height: root.ph; page: root.d.left-page; dark: WS.t.dark; em: root.em; }
            }
            if root.d.show-right: Rectangle {
                x: root.bw;
                y: 0px;
                width: root.bw;
                height: root.bh;
                Image { width: parent.width; height: parent.height; image-fit: fill; source: WS.t.dark ? @image-url("../../assets/break/album/dark/board-right.jpg") : @image-url("../../assets/break/album/light/board-right.jpg"); }
                PageStack {
                    x: root.margin;
                    y: root.margin;
                    width: root.pw;
                    height: root.ph;
                    layers: root.d.right-layers;
                    dir: 1;
                    em: root.em;
                    max-offset: root.margin - 1px;
                    dark: WS.t.dark;
                }
                PageView { x: root.margin; y: root.margin; width: root.pw; height: root.ph; page: root.d.right-page; dark: WS.t.dark; em: root.em; }
            }
            // the closed book's edges (fade out early in an opening, back in late in a closing)
            if root.d.show-closed: Image {
                x: root.bw - 10px * root.s-book;
                y: -10px * root.s-book;
                width: (472.47px + 20px) * root.s-book;
                height: (595.48px + 20px) * root.s-book;
                image-fit: fill;
                source: WS.t.dark ? @image-url("../../assets/break/album/dark/edge.png") : @image-url("../../assets/break/album/light/edge.png");
                opacity: root.d.anim == 1 ? clamp(1 - root.cover-t / 0.3, 0, 1) : root.d.anim == 2 ? clamp((root.cover-t - 0.72) / 0.28, 0, 1) : 1;
            }

            // the turning leaf: front face shrinks to the spine, the back face grows out the
            // other side (orthographic projection of the half turn)
            if root.d.anim == 3 || root.d.anim == 4: Rectangle {
                private property <bool> next: root.d.anim == 3;
                private property <float> c: cos(root.leaf-t * 180deg);
                // first half: the front face on its own side; second half: the back face opposite
                if root.leaf-t < 0.5: Rectangle {
                    x: parent.next ? root.bw : 0px;
                    width: root.bw;
                    height: root.bh;
                    transform-origin: { x: parent.next ? 0px : root.bw, y: root.bh / 2 };
                    transform-scale-x: max(0.0001, parent.c);
                    PageView { x: root.margin; y: root.margin; width: root.pw; height: root.ph; page: root.d.leaf-front; dark: WS.t.dark; em: root.em; drop-shadow-blur: 1.1 * root.em; drop-shadow-color: #28190842; }
                }
                if root.leaf-t >= 0.5: Rectangle {
                    x: parent.next ? 0px : root.bw;
                    width: root.bw;
                    height: root.bh;
                    transform-origin: { x: parent.next ? root.bw : 0px, y: root.bh / 2 };
                    transform-scale-x: max(0.0001, -parent.c);
                    PageView { x: root.margin; y: root.margin; width: root.pw; height: root.ph; page: root.d.leaf-back; dark: WS.t.dark; em: root.em; drop-shadow-blur: 1.1 * root.em; drop-shadow-color: #28190842; }
                }
            }

            // the cover, hinged at the spine
            if root.d.show-cover && root.swing < 0.5: CoverFront {
                x: root.bw;
                width: root.bw;
                height: root.bh;
                dark: WS.t.dark;
                em: root.em;
                bw: root.bw;
                bh: root.bh;
                transform-origin: { x: 0px, y: root.bh / 2 };
                transform-scale-x: max(0.0001, cos(root.swing * 180deg));
                TouchArea {
                    enabled: !root.d.open && root.d.anim == 0;
                    mouse-cursor: self.enabled ? pointer : default;
                    clicked => { root.open(); }
                }
                accessible-role: button;
                accessible-label: "Open the album";
                accessible-action-default => { root.open(); }
            }
            if root.d.show-cover && root.swing >= 0.5: Rectangle {
                // the cover's inside (`.wabi-book-cover-back`): plain cloth with the first page on it
                x: 0px;
                width: root.bw;
                height: root.bh;
                border-radius: 5px;
                background: WS.t.dark ? #2c374b : #38455d;
                border-width: 1px;
                border-color: #00000040;
                transform-origin: { x: root.bw, y: root.bh / 2 };
                transform-scale-x: max(0.0001, -cos(root.swing * 180deg));
                PageView { x: root.margin; y: root.margin; width: root.pw; height: root.ph; page: root.d.first-page; dark: WS.t.dark; em: root.em; }
            }

            // clicking anywhere on the closed book opens it
            if !root.d.open && root.d.anim == 0: TouchArea {
                x: root.bw;
                width: root.bw + root.e + root.bevel;
                height: root.bh + root.e + root.bevel;
                mouse-cursor: pointer;
                clicked => { root.open(); }
            }
            // the page-turn zones down the spread's outer edges
            if root.d.open: TouchArea {
                // explicit: an element with a width but no x is centred in its parent (the spine)
                x: 0px;
                width: root.zone-w;
                height: root.bh;
                enabled: root.d.anim == 0;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => { root.turn(-1); }
                Rectangle { visible: parent.has-hover && parent.enabled; background: @linear-gradient(90deg, #28190a1a 0%, transparent 100%); }
                accessible-role: button;
                accessible-label: root.d.at-first ? "Close the album" : "Previous pages";
                accessible-action-default => { root.turn(-1); }
            }
            if root.d.open: TouchArea {
                x: parent.width - root.zone-w;
                width: root.zone-w;
                height: root.bh;
                enabled: root.d.anim == 0;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => { root.turn(1); }
                Rectangle { visible: parent.has-hover && parent.enabled; background: @linear-gradient(270deg, #28190a1a 0%, transparent 100%); }
                accessible-role: button;
                accessible-label: root.d.at-last ? "Close the album" : "Next pages";
                accessible-action-default => { root.turn(1); }
            }
        }
    }

    // keyboard: Enter/Space opens, Escape closes, arrows turn (production binds the arrows
    // window-wide; here they work whenever the Rest room has focus)
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") && !root.d.open { root.open(); return accept; }
            if event.text == Key.Escape { root.close(); return accept; }
            if event.text == Key.RightArrow { root.turn(1); return accept; }
            if event.text == Key.LeftArrow && root.d.open { root.turn(-1); return accept; }
            reject
        }
    }
    accessible-role: groupbox;
    accessible-label: "Achievement album";
}
