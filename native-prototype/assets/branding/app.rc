// Windows resource script (Stage 13 production shell). Embeds the application icon and a
// version-info block into the executable so File Explorer, the taskbar-icon fallback, and
// Properties dialogs show real Study Tracker identity instead of a generic Rust binary icon.
//
// icon.ico / icon.png are byte-identical copies of desktop/src-tauri/icons/{icon.ico,icon.png}
// (production's own published branding; provenance and hashes recorded in
// docs/stage13-production-shell.md). Not modified. desktop/ is not referenced by the build.
IDI_APP_ICON ICON "icon.ico"

// Resource ID 1 (not the symbolic VS_VERSION_INFO macro, which needs <winver.h> and isn't worth
// the include just for a name): Win32's GetFileVersionInfo looks up RT_VERSION resource ID 1
// specifically, so the numeric ID here is load-bearing, not stylistic.
1 VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "damcha"
            VALUE "FileDescription", "Study Tracker \x2014 native preview shell (not the production app)"
            VALUE "ProductName", "Study Tracker Native Preview"
            VALUE "ProductVersion", "0.1.0"
            VALUE "OriginalFilename", "study-tracker-native-prototype.exe"
            VALUE "InternalName", "study-tracker-native-prototype"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
